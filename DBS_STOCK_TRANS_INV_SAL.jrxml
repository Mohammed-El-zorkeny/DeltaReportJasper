<?xml version="1.0" encoding="UTF-8"?>
<!-- Created with Jaspersoft Studio version 6.20.0.final using JasperReports Library version 6.20.0-2bc7ab61c56f459e8176eb05c7705e145cd400ad  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DBS_STOCK_TRANS_INV_SAL" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="539fdbef-7607-4e4f-bb51-a9be3ab4fb46">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ERP_STOCK"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="269"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="731"/>
	<style name="Col  Header" mode="Opaque" forecolor="#030303" backcolor="#DB9593"/>
	<style name="Text" mode="Transparent" forecolor="#E60F0B"/>
	<style name="Col  Header Value" mode="Transparent" forecolor="#030303" backcolor="#D4D0CF"/>
	<parameter name="P_LANG" class="java.lang.String"/>
	<parameter name="P_USERNAME" class="java.lang.String"/>
	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_ID" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
    ID,
    COMP_ID,
    BRANCH_ID,
    AUTO_NUMBER AS TRANS_NUMBER,
    DBS_STOCK_STORE_ID_FROM AS ID_FROM_STORE,
    DBS_STOCK_STORE_DTL_ID_FROM AS ID_SUB_FROM_STORE,
    DBS_STOCK_STORE_ID_TO AS ID_TO_STORE,
    DBS_STOCK_STORE_DTL_ID_TO AS ID_SUB_TO_STORE,
    DBS_STOCK_STORE_LANG_NAME(DBS_STOCK_STORE_ID_FROM, $P{P_LANG}) AS FROM_STORE,
    DBS_STOCK_STORE_DTL_LANG_NAME(DBS_STOCK_STORE_DTL_ID_FROM, $P{P_LANG}) AS FROM_SUB_STORE,
    DBS_STOCK_STORE_LANG_NAME(DBS_STOCK_STORE_ID_TO, $P{P_LANG}) AS TO_STORE,
    DBS_STOCK_STORE_DTL_LANG_NAME(DBS_STOCK_STORE_DTL_ID_TO, $P{P_LANG}) AS TO_SUB_STORE,
    TRANS_TYPE,
    TO_CHAR(TRANS_DATE, 'YYYY-MM-DD') AS TRANS_DATE,
    DEPENDENT_ON_ID AS DEPENDENT_ID,
    DEPENDENT_ON_TYPE AS DEPENDENT_TYPE,
    STATUS,
    
    -- الحالة بدون أقواس
    CASE
        WHEN STATUS = 1 AND $P{P_LANG} = 'ar' 
        THEN 'اعتماد مبدئي'
        
        WHEN STATUS = 1 AND $P{P_LANG} = 'en' 
        THEN 'Preliminary Approval'
        
        WHEN STATUS = 2 AND $P{P_LANG} = 'ar' 
        THEN 'اعتماد نهائي'
        
        WHEN STATUS = 2 AND $P{P_LANG} = 'en' 
        THEN 'Final Approval'
        
        ELSE 
            CASE 
                WHEN $P{P_LANG} = 'ar' THEN 'غير محدد'
                ELSE 'Unknown'
            END
    END AS STATUS_DISPLAY,
    
    -- نوع الحركة مع رقم الفاتورة الفعلي
    CASE
        WHEN DEPENDENT_ON_ID IS NOT NULL AND DEPENDENT_ON_TYPE = 'INV_PUR' AND $P{P_LANG} = 'ar' 
        THEN 'فاتورة شراء رقم ' || DBS_STOCK_TRANS_GET_INVOICE_NUMBER(DEPENDENT_ON_ID, DEPENDENT_ON_TYPE)
        
        WHEN DEPENDENT_ON_ID IS NOT NULL AND DEPENDENT_ON_TYPE = 'INV_PUR' AND $P{P_LANG} = 'en' 
        THEN 'Purchase Invoice No: ' || DBS_STOCK_TRANS_GET_INVOICE_NUMBER(DEPENDENT_ON_ID, DEPENDENT_ON_TYPE)
        
        WHEN DEPENDENT_ON_ID IS NOT NULL AND DEPENDENT_ON_TYPE = 'INV_SAL' AND $P{P_LANG} = 'ar' 
        THEN 'فاتورة بيع رقم ' || DBS_STOCK_TRANS_GET_INVOICE_NUMBER(DEPENDENT_ON_ID, DEPENDENT_ON_TYPE)
        
        WHEN DEPENDENT_ON_ID IS NOT NULL AND DEPENDENT_ON_TYPE = 'INV_SAL' AND $P{P_LANG} = 'en' 
        THEN 'Sales Invoice No: ' || DBS_STOCK_TRANS_GET_INVOICE_NUMBER(DEPENDENT_ON_ID, DEPENDENT_ON_TYPE)
        
        WHEN DEPENDENT_ON_ID IS NOT NULL AND DEPENDENT_ON_TYPE = 'INV_SAL_RET' AND $P{P_LANG} = 'ar' 
        THEN 'فاتورة مرتجع بيع رقم ' || DBS_STOCK_TRANS_GET_INVOICE_NUMBER(DEPENDENT_ON_ID, DEPENDENT_ON_TYPE)
        
        WHEN DEPENDENT_ON_ID IS NOT NULL AND DEPENDENT_ON_TYPE = 'INV_SAL_RET' AND $P{P_LANG} = 'en' 
        THEN 'Sales Return Invoice No: ' || DBS_STOCK_TRANS_GET_INVOICE_NUMBER(DEPENDENT_ON_ID, DEPENDENT_ON_TYPE)
        
        WHEN DEPENDENT_ON_ID IS NOT NULL AND DEPENDENT_ON_TYPE = 'INV_PUR_RET' AND $P{P_LANG} = 'ar' 
        THEN 'فاتورة مرتجع شراء رقم ' || DBS_STOCK_TRANS_GET_INVOICE_NUMBER(DEPENDENT_ON_ID, DEPENDENT_ON_TYPE)
        
        WHEN DEPENDENT_ON_ID IS NOT NULL AND DEPENDENT_ON_TYPE = 'INV_PUR_RET' AND $P{P_LANG} = 'en' 
        THEN 'Purchase Return Invoice No: ' || DBS_STOCK_TRANS_GET_INVOICE_NUMBER(DEPENDENT_ON_ID, DEPENDENT_ON_TYPE)
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 1 AND $P{P_LANG} = 'ar' 
        THEN 'إذن اضافه'
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 1 AND $P{P_LANG} = 'en' 
        THEN 'Add Permission'
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 2 AND $P{P_LANG} = 'ar' 
        THEN 'إذن صرف فاتورة عميل'
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 2 AND $P{P_LANG} = 'en' 
        THEN 'Issue for Customer Invoice'
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 3 AND $P{P_LANG} = 'ar' 
        THEN 'وارد محول'
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 3 AND $P{P_LANG} = 'en' 
        THEN 'Incoming Transfer'
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 4 AND $P{P_LANG} = 'ar' 
        THEN 'منصرف محول'
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 4 AND $P{P_LANG} = 'en' 
        THEN 'Outgoing Transfer'
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 5 AND $P{P_LANG} = 'ar' 
        THEN 'إذن إضافه تسوية'
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 5 AND $P{P_LANG} = 'en' 
        THEN 'Adjustment Add'
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 6 AND $P{P_LANG} = 'ar' 
        THEN 'إذن صرف تسوية'
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 6 AND $P{P_LANG} = 'en' 
        THEN 'Adjustment Issue'
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 7 AND $P{P_LANG} = 'ar' 
        THEN 'مرتجع عميل'
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 7 AND $P{P_LANG} = 'en' 
        THEN 'Customer Return'
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 8 AND $P{P_LANG} = 'ar' 
        THEN 'مرتجع مورد'
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 8 AND $P{P_LANG} = 'en' 
        THEN 'Supplier Return'
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 9 AND $P{P_LANG} = 'ar' 
        THEN 'مرتجع انتاج'
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 9 AND $P{P_LANG} = 'en' 
        THEN 'Production Return'
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 10 AND $P{P_LANG} = 'ar' 
        THEN 'صرف انتاج'
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 10 AND $P{P_LANG} = 'en' 
        THEN 'Production Issue'
        
        ELSE 'Unknown Transaction'
    END AS DEPENDENT_TYPE_NAME,
    
    -- الكولوم الجديد: وصف الحركة + رقم الفاتورة + الحالة
    CASE
        -- فواتير الشراء
        WHEN DEPENDENT_ON_ID IS NOT NULL AND DEPENDENT_ON_TYPE = 'INV_PUR' AND $P{P_LANG} = 'ar' 
        THEN 'فاتورة شراء رقم ' || DBS_STOCK_TRANS_GET_INVOICE_NUMBER(DEPENDENT_ON_ID, DEPENDENT_ON_TYPE) || ' - ' ||
             CASE WHEN STATUS = 1 THEN 'اعتماد مبدئي' WHEN STATUS = 2 THEN 'اعتماد نهائي' ELSE 'غير محدد' END
        
        WHEN DEPENDENT_ON_ID IS NOT NULL AND DEPENDENT_ON_TYPE = 'INV_PUR' AND $P{P_LANG} = 'en' 
        THEN 'Purchase Invoice No: ' || DBS_STOCK_TRANS_GET_INVOICE_NUMBER(DEPENDENT_ON_ID, DEPENDENT_ON_TYPE) || ' - ' ||
             CASE WHEN STATUS = 1 THEN 'Preliminary Approval' WHEN STATUS = 2 THEN 'Final Approval' ELSE 'Unknown' END
        
        -- فواتير البيع
        WHEN DEPENDENT_ON_ID IS NOT NULL AND DEPENDENT_ON_TYPE = 'INV_SAL' AND $P{P_LANG} = 'ar' 
        THEN 'فاتورة بيع رقم ' || DBS_STOCK_TRANS_GET_INVOICE_NUMBER(DEPENDENT_ON_ID, DEPENDENT_ON_TYPE) || ' - ' ||
             CASE WHEN STATUS = 1 THEN 'اعتماد مبدئي' WHEN STATUS = 2 THEN 'اعتماد نهائي' ELSE 'غير محدد' END
        
        WHEN DEPENDENT_ON_ID IS NOT NULL AND DEPENDENT_ON_TYPE = 'INV_SAL' AND $P{P_LANG} = 'en' 
        THEN 'Sales Invoice No: ' || DBS_STOCK_TRANS_GET_INVOICE_NUMBER(DEPENDENT_ON_ID, DEPENDENT_ON_TYPE) || ' - ' ||
             CASE WHEN STATUS = 1 THEN 'Preliminary Approval' WHEN STATUS = 2 THEN 'Final Approval' ELSE 'Unknown' END
        
        -- مرتجع بيع
        WHEN DEPENDENT_ON_ID IS NOT NULL AND DEPENDENT_ON_TYPE = 'INV_SAL_RET' AND $P{P_LANG} = 'ar' 
        THEN 'فاتورة مرتجع بيع رقم ' || DBS_STOCK_TRANS_GET_INVOICE_NUMBER(DEPENDENT_ON_ID, DEPENDENT_ON_TYPE) || ' - ' ||
             CASE WHEN STATUS = 1 THEN 'اعتماد مبدئي' WHEN STATUS = 2 THEN 'اعتماد نهائي' ELSE 'غير محدد' END
        
        WHEN DEPENDENT_ON_ID IS NOT NULL AND DEPENDENT_ON_TYPE = 'INV_SAL_RET' AND $P{P_LANG} = 'en' 
        THEN 'Sales Return Invoice No: ' || DBS_STOCK_TRANS_GET_INVOICE_NUMBER(DEPENDENT_ON_ID, DEPENDENT_ON_TYPE) || ' - ' ||
             CASE WHEN STATUS = 1 THEN 'Preliminary Approval' WHEN STATUS = 2 THEN 'Final Approval' ELSE 'Unknown' END
        
        -- مرتجع شراء
        WHEN DEPENDENT_ON_ID IS NOT NULL AND DEPENDENT_ON_TYPE = 'INV_PUR_RET' AND $P{P_LANG} = 'ar' 
        THEN 'فاتورة مرتجع شراء رقم ' || DBS_STOCK_TRANS_GET_INVOICE_NUMBER(DEPENDENT_ON_ID, DEPENDENT_ON_TYPE) || ' - ' ||
             CASE WHEN STATUS = 1 THEN 'اعتماد مبدئي' WHEN STATUS = 2 THEN 'اعتماد نهائي' ELSE 'غير محدد' END
        
        WHEN DEPENDENT_ON_ID IS NOT NULL AND DEPENDENT_ON_TYPE = 'INV_PUR_RET' AND $P{P_LANG} = 'en' 
        THEN 'Purchase Return Invoice No: ' || DBS_STOCK_TRANS_GET_INVOICE_NUMBER(DEPENDENT_ON_ID, DEPENDENT_ON_TYPE) || ' - ' ||
             CASE WHEN STATUS = 1 THEN 'Preliminary Approval' WHEN STATUS = 2 THEN 'Final Approval' ELSE 'Unknown' END
        
        -- باقي الحركات بدون فاتورة
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 1 AND $P{P_LANG} = 'ar' 
        THEN 'إذن اضافه - ' || CASE WHEN STATUS = 1 THEN 'اعتماد مبدئي' WHEN STATUS = 2 THEN 'اعتماد نهائي' ELSE 'غير محدد' END
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 1 AND $P{P_LANG} = 'en' 
        THEN 'Add Permission - ' || CASE WHEN STATUS = 1 THEN 'Preliminary Approval' WHEN STATUS = 2 THEN 'Final Approval' ELSE 'Unknown' END
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 2 AND $P{P_LANG} = 'ar' 
        THEN 'إذن صرف فاتورة عميل - ' || CASE WHEN STATUS = 1 THEN 'اعتماد مبدئي' WHEN STATUS = 2 THEN 'اعتماد نهائي' ELSE 'غير محدد' END
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 2 AND $P{P_LANG} = 'en' 
        THEN 'Issue for Customer Invoice - ' || CASE WHEN STATUS = 1 THEN 'Preliminary Approval' WHEN STATUS = 2 THEN 'Final Approval' ELSE 'Unknown' END
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 3 AND $P{P_LANG} = 'ar' 
        THEN 'وارد محول - ' || CASE WHEN STATUS = 1 THEN 'اعتماد مبدئي' WHEN STATUS = 2 THEN 'اعتماد نهائي' ELSE 'غير محدد' END
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 3 AND $P{P_LANG} = 'en' 
        THEN 'Incoming Transfer - ' || CASE WHEN STATUS = 1 THEN 'Preliminary Approval' WHEN STATUS = 2 THEN 'Final Approval' ELSE 'Unknown' END
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 4 AND $P{P_LANG} = 'ar' 
        THEN 'منصرف محول - ' || CASE WHEN STATUS = 1 THEN 'اعتماد مبدئي' WHEN STATUS = 2 THEN 'اعتماد نهائي' ELSE 'غير محدد' END
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 4 AND $P{P_LANG} = 'en' 
        THEN 'Outgoing Transfer - ' || CASE WHEN STATUS = 1 THEN 'Preliminary Approval' WHEN STATUS = 2 THEN 'Final Approval' ELSE 'Unknown' END
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 5 AND $P{P_LANG} = 'ar' 
        THEN 'إذن إضافه تسوية - ' || CASE WHEN STATUS = 1 THEN 'اعتماد مبدئي' WHEN STATUS = 2 THEN 'اعتماد نهائي' ELSE 'غير محدد' END
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 5 AND $P{P_LANG} = 'en' 
        THEN 'Adjustment Add - ' || CASE WHEN STATUS = 1 THEN 'Preliminary Approval' WHEN STATUS = 2 THEN 'Final Approval' ELSE 'Unknown' END
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 6 AND $P{P_LANG} = 'ar' 
        THEN 'إذن صرف تسوية - ' || CASE WHEN STATUS = 1 THEN 'اعتماد مبدئي' WHEN STATUS = 2 THEN 'اعتماد نهائي' ELSE 'غير محدد' END
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 6 AND $P{P_LANG} = 'en' 
        THEN 'Adjustment Issue - ' || CASE WHEN STATUS = 1 THEN 'Preliminary Approval' WHEN STATUS = 2 THEN 'Final Approval' ELSE 'Unknown' END
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 7 AND $P{P_LANG} = 'ar' 
        THEN 'مرتجع عميل - ' || CASE WHEN STATUS = 1 THEN 'اعتماد مبدئي' WHEN STATUS = 2 THEN 'اعتماد نهائي' ELSE 'غير محدد' END
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 7 AND $P{P_LANG} = 'en' 
        THEN 'Customer Return - ' || CASE WHEN STATUS = 1 THEN 'Preliminary Approval' WHEN STATUS = 2 THEN 'Final Approval' ELSE 'Unknown' END
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 8 AND $P{P_LANG} = 'ar' 
        THEN 'مرتجع مورد - ' || CASE WHEN STATUS = 1 THEN 'اعتماد مبدئي' WHEN STATUS = 2 THEN 'اعتماد نهائي' ELSE 'غير محدد' END
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 8 AND $P{P_LANG} = 'en' 
        THEN 'Supplier Return - ' || CASE WHEN STATUS = 1 THEN 'Preliminary Approval' WHEN STATUS = 2 THEN 'Final Approval' ELSE 'Unknown' END
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 9 AND $P{P_LANG} = 'ar' 
        THEN 'مرتجع انتاج - ' || CASE WHEN STATUS = 1 THEN 'اعتماد مبدئي' WHEN STATUS = 2 THEN 'اعتماد نهائي' ELSE 'غير محدد' END
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 9 AND $P{P_LANG} = 'en' 
        THEN 'Production Return - ' || CASE WHEN STATUS = 1 THEN 'Preliminary Approval' WHEN STATUS = 2 THEN 'Final Approval' ELSE 'Unknown' END
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 10 AND $P{P_LANG} = 'ar' 
        THEN 'صرف انتاج - ' || CASE WHEN STATUS = 1 THEN 'اعتماد مبدئي' WHEN STATUS = 2 THEN 'اعتماد نهائي' ELSE 'غير محدد' END
        
        WHEN DEPENDENT_ON_ID IS NULL AND TRANS_TYPE = 10 AND $P{P_LANG} = 'en' 
        THEN 'Production Issue - ' || CASE WHEN STATUS = 1 THEN 'Preliminary Approval' WHEN STATUS = 2 THEN 'Final Approval' ELSE 'Unknown' END
        
        ELSE 'Unknown Transaction'
    END AS TRANS_FULL_DESC,
    
    -- بيانات العملاء (للفواتير والمرتجعات)
    CASE
        WHEN DEPENDENT_ON_ID IS NOT NULL AND DEPENDENT_ON_TYPE IN ('INV_SAL', 'INV_SAL_RET')
        THEN DBS_SAL_CUSTOMERS_LANG_NAME(DBS_STOCK_TRANS_GET_CUSTOMER_ID(DEPENDENT_ON_ID, DEPENDENT_ON_TYPE), $P{P_LANG})
    END AS CUST_NAME,
    
    CASE
        WHEN DEPENDENT_ON_ID IS NOT NULL AND DEPENDENT_ON_TYPE IN ('INV_SAL', 'INV_SAL_RET')
        THEN DBS_SAL_CUSTOMER_PHONE(DBS_STOCK_TRANS_GET_CUSTOMER_ID(DEPENDENT_ON_ID, DEPENDENT_ON_TYPE))
    END AS CUST_PHONE,
    
    CASE
        WHEN DEPENDENT_ON_ID IS NOT NULL AND DEPENDENT_ON_TYPE IN ('INV_SAL', 'INV_SAL_RET')
        THEN DBS_SAL_CUSTOMERS_GOV_NAME(DBS_STOCK_TRANS_GET_CUSTOMER_ID(DEPENDENT_ON_ID, DEPENDENT_ON_TYPE))
    END AS CUST_GOV,
    
    -- بيانات الموردين (لفواتير ومرتجعات الشراء)
    CASE
        WHEN DEPENDENT_ON_ID IS NOT NULL AND DEPENDENT_ON_TYPE IN ('INV_PUR', 'INV_PUR_RET')
        THEN DBS_PUR_SUPPLIERS_LANG_NAME(DBS_STOCK_TRANS_GET_SUPPLIER_ID(DEPENDENT_ON_ID, DEPENDENT_ON_TYPE), $P{P_LANG})
    END AS SUPP_NAME,
    
    CASE
        WHEN DEPENDENT_ON_ID IS NOT NULL AND DEPENDENT_ON_TYPE IN ('INV_PUR', 'INV_PUR_RET')
        THEN DBS_PUR_SUPPLIERS_PHONE(DBS_STOCK_TRANS_GET_SUPPLIER_ID(DEPENDENT_ON_ID, DEPENDENT_ON_TYPE))
    END AS SUPP_PHONE,
    
    -- تاريخ التسليم
    CASE
        WHEN DEPENDENT_ON_ID IS NOT NULL AND DEPENDENT_ON_TYPE IN ('INV_SAL', 'INV_SAL_RET')
        THEN (SELECT TO_CHAR(DELIVERY_DATE, 'YYYY-MM-DD')
              FROM DBS_SAL_INVOICE x 
              WHERE x.ID = DEPENDENT_ON_ID)
    END AS DELIVERY_DATE,
    
    -- رقم الفاتورة
    CASE
        WHEN DEPENDENT_ON_ID IS NOT NULL AND DEPENDENT_ON_TYPE IN ('INV_SAL', 'INV_SAL_RET', 'INV_PUR', 'INV_PUR_RET')
        THEN DBS_STOCK_TRANS_GET_INVOICE_NUMBER(DEPENDENT_ON_ID, DEPENDENT_ON_TYPE)
    END AS INVOICE_NO,
    
    NOTES,
    CREATED,
    CREATED_BY,
    UPDATED,
    UPDATED_BY
FROM DBS_STOCK_TRANS
WHERE ID = $P{P_ID}]]>
	</queryString>
	<field name="ID" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="ID"/>
		<property name="com.jaspersoft.studio.field.label" value="ID"/>
	</field>
	<field name="COMP_ID" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="COMP_ID"/>
		<property name="com.jaspersoft.studio.field.label" value="COMP_ID"/>
	</field>
	<field name="BRANCH_ID" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="BRANCH_ID"/>
		<property name="com.jaspersoft.studio.field.label" value="BRANCH_ID"/>
	</field>
	<field name="TRANS_NUMBER" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="TRANS_NUMBER"/>
		<property name="com.jaspersoft.studio.field.label" value="TRANS_NUMBER"/>
	</field>
	<field name="ID_FROM_STORE" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="ID_FROM_STORE"/>
		<property name="com.jaspersoft.studio.field.label" value="ID_FROM_STORE"/>
	</field>
	<field name="ID_SUB_FROM_STORE" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="ID_SUB_FROM_STORE"/>
		<property name="com.jaspersoft.studio.field.label" value="ID_SUB_FROM_STORE"/>
	</field>
	<field name="ID_TO_STORE" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="ID_TO_STORE"/>
		<property name="com.jaspersoft.studio.field.label" value="ID_TO_STORE"/>
	</field>
	<field name="ID_SUB_TO_STORE" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="ID_SUB_TO_STORE"/>
		<property name="com.jaspersoft.studio.field.label" value="ID_SUB_TO_STORE"/>
	</field>
	<field name="FROM_STORE" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="FROM_STORE"/>
		<property name="com.jaspersoft.studio.field.label" value="FROM_STORE"/>
	</field>
	<field name="FROM_SUB_STORE" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="FROM_SUB_STORE"/>
		<property name="com.jaspersoft.studio.field.label" value="FROM_SUB_STORE"/>
	</field>
	<field name="TO_STORE" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="TO_STORE"/>
		<property name="com.jaspersoft.studio.field.label" value="TO_STORE"/>
	</field>
	<field name="TO_SUB_STORE" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="TO_SUB_STORE"/>
		<property name="com.jaspersoft.studio.field.label" value="TO_SUB_STORE"/>
	</field>
