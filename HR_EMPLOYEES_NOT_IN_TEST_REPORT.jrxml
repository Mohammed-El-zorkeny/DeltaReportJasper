	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    E.CODE AS EMPLOYEE_CODE,
    DECODE($P{P_LANG}, 'ar', E.FULL_NAME_AR, E.FULL_NAME_EN) AS EMPLOYEE_NAME,
    (SELECT DECODE($P{P_LANG}, 'ar', S.ARABIC_NAME, S.NAME) 
     FROM HR_EMPLOYEE_STATUS S 
     WHERE S.ID = HR_GET_EMPLOYEE_CURRENT_STATUS(E.EMPLOYEE_ID)) AS EMPLOYEE_STATUS
FROM HR_EMPLOYEES E
WHERE E.CODE NOT IN (SELECT EMPLOYEE_ID FROM TEST_EMP)
  AND HR_GET_EMPLOYEE_CURRENT_STATUS(E.EMPLOYEE_ID) = 1
  AND ($P{P_COMP_ID} IS NULL OR E.COMPANY_ID = $P{P_COMP_ID})
  AND ($P{P_BRANCH_ID} IS NULL OR E.BRANCH_ID = $P{P_BRANCH_ID})
ORDER BY E.CODE ASC]]>
	</queryString>
	<field name="EMPLOYEE_CODE" class="java.lang.String"/>
	<field name="EMPLOYEE_NAME" class="java.lang.String"/>
	<field name="EMPLOYEE_STATUS" class="java.lang.String"/>
