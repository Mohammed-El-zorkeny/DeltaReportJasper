	<parameter name="P_LANG" class="java.lang.String">
		<defaultValueExpression><![CDATA["ar"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_USERPRINT" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="P_STATUS_ID" class="java.lang.String"/>
	<parameter name="P_FROM_DATE" class="java.lang.String"/>
	<parameter name="P_TO_DATE" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    E.CODE AS EMPLOYEE_CODE,
    DECODE($P{P_LANG}, 'ar', E.FULL_NAME_AR, E.FULL_NAME_EN) AS EMPLOYEE_NAME,
    DECODE($P{P_LANG}, 'ar', D.ARABIC_NAME, D.NAME) AS DEPARTMENT_NAME,
    DECODE($P{P_LANG}, 'ar', J.ARABIC_NAME, J.NAME) AS JOB_TITLE,
    E.TERMINATION_DATE AS TERMINATION_DATE,
    DECODE($P{P_LANG}, 'ar', S.ARABIC_NAME, S.NAME) AS TERMINATION_STATUS,
    E.TERMINATION_REASON AS TERMINATION_REASON
FROM HR_EMPLOYEES E
LEFT JOIN HR_DEPARTMENT D ON E.DEPARTMENT_ID = D.ID
LEFT JOIN HR_JOB_TITLE J ON E.JOB_ID = J.ID
LEFT JOIN HR_EMPLOYEE_STATUS S ON E.EMPLOYMENT_STATUS = S.ID
WHERE ($P{P_COMP_ID} IS NULL OR E.COMPANY_ID = $P{P_COMP_ID})
  AND (S.WORK_IN_PROGRESS = 0)
  AND ($P{P_STATUS_ID} IS NULL OR E.EMPLOYMENT_STATUS = $P{P_STATUS_ID})
  AND ($P{P_FROM_DATE} IS NULL OR E.TERMINATION_DATE >= TO_DATE($P{P_FROM_DATE}, 'DD-MM-YYYY'))
  AND ($P{P_TO_DATE} IS NULL OR E.TERMINATION_DATE <= TO_DATE($P{P_TO_DATE}, 'DD-MM-YYYY'))
ORDER BY E.TERMINATION_DATE DESC, E.CODE ASC]]>
	</queryString>
	<field name="EMPLOYEE_CODE" class="java.lang.String"/>
	<field name="EMPLOYEE_NAME" class="java.lang.String"/>
	<field name="DEPARTMENT_NAME" class="java.lang.String"/>
	<field name="JOB_TITLE" class="java.lang.String"/>
	<field name="TERMINATION_DATE" class="java.sql.Timestamp"/>
	<field name="TERMINATION_STATUS" class="java.lang.String"/>
	<field name="TERMINATION_REASON" class="java.lang.String"/>
	<variable name="ROW_NUM" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{EMPLOYEE_CODE}]]></variableExpression>
	</variable>
