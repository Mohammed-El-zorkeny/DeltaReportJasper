		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    W.ID,
    W.CODE,
    W.NAME,
    W.NAME_AR,
    W.LEVEL_TYPE,
    W.STATUS,
    LEVEL AS HIER_LEVEL
FROM STOCK_WAREHOUSES W
WHERE W.COMPANY_ID = $P{P_COMP_ID}
  AND W.BRANCH_ID  = $P{P_BRANCH_ID}
  AND W.STATUS     = '1'
START WITH W.PARENT_ID IS NULL
CONNECT BY PRIOR W.ID = W.PARENT_ID
ORDER SIBLINGS BY TO_NUMBER(REGEXP_SUBSTR(W.CODE, '[0-9]+'))]]>
	</queryString>
