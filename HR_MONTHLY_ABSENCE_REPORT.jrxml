<!-- Created with Jaspersoft Studio version 6.20.5.final using JasperReports Library version 6.20.5-3efcf2e67f959db3888d79f73dde2dbd7acb4f8e  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="HR_MONTHLY_ABSENCE_REPORT" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="15" bottomMargin="15" uuid="d5e64789-9012-4bae-8765-3456789012ce">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Delta"/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageHeight" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="P_LANG" class="java.lang.String">
		<defaultValueExpression><![CDATA["ar"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_BRANCH_ID" class="java.lang.String"/>
	<parameter name="P_USERPRINT" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="P_EMPLOYEE_ID" class="java.lang.String"/>
	<parameter name="P_DEPARTMENT_ID" class="java.lang.String"/>
	<parameter name="P_FROM_DATE" class="java.lang.String"/>
	<parameter name="P_TO_DATE" class="java.lang.String"/>
	<queryString>
		<![CDATA[WITH date_range AS (
    SELECT TO_DATE($P{P_FROM_DATE}, 'DD-MM-YYYY') + LEVEL - 1 AS DAY_DATE
      FROM DUAL
     WHERE $P{P_FROM_DATE} IS NOT NULL
       AND $P{P_TO_DATE}   IS NOT NULL
    CONNECT BY LEVEL <= (
        TO_DATE($P{P_TO_DATE},   'DD-MM-YYYY')
      - TO_DATE($P{P_FROM_DATE}, 'DD-MM-YYYY') + 1
    )
),
absent_employees AS (
    SELECT E.EMPLOYEE_ID
      FROM HR_EMPLOYEES E
      CROSS JOIN date_range DR
     WHERE E.EMPLOYMENT_STATUS = 1
       AND E.WORK_SHIFT_TYPE_ID = 2
       -- Exclude actual attendance
       AND NOT EXISTS (
           SELECT 1 FROM HR_ATTENDANCE_LOG AL 
            WHERE AL.EMPLOYEE_ID = E.EMPLOYEE_ID 
              AND AL.ATTENDANCE_DATE = DR.DAY_DATE
       )
       -- Exclude leaves
       AND NOT EXISTS (
           SELECT 1 FROM HR_EMPLOYEE_LEAVE_REQUESTS LR 
            WHERE LR.EMPLOYEE_ID = E.EMPLOYEE_ID 
              AND LR.STATUS_ID = 4 
              AND DR.DAY_DATE BETWEEN LR.START_DATE AND LR.END_DATE
       )
       -- Exclude missions
       AND NOT EXISTS (
           SELECT 1 FROM HR_EMPLOYEE_MISSIONS M 
            WHERE M.EMPLOYEE_ID = E.EMPLOYEE_ID 
              AND M.STATUS_ID = 4 
              AND DR.DAY_DATE BETWEEN M.START_DATE AND M.END_DATE
       )
       -- Exclude registered absences
       AND NOT EXISTS (
           SELECT 1 FROM HR_ABSENCE_LOG AB 
            WHERE AB.EMPLOYEE_ID = E.EMPLOYEE_ID 
              AND AB.STATUS = '1' 
              AND DR.DAY_DATE BETWEEN AB.ABSENCE_DATE AND AB.END_DATE
       )
       -- Exclude public holidays
       AND NOT EXISTS (
           SELECT 1 FROM HR_OFFICIAL_HOLIDAYS PH 
            WHERE PH.HOLIDAY_DATE = DR.DAY_DATE 
              AND PH.STATUS = 1 
              AND (PH.RELIGION_ID IS NULL OR PH.RELIGION_ID = E.RELIGION) 
              AND (PH.SHIFT_ID IS NULL OR PH.SHIFT_ID = E.WORK_SHIFT_ID)
       )
       -- Exclude weekly offs
       AND NOT EXISTS (
           SELECT 1 
             FROM HR_WORK_SHIF_DAYS SD
             JOIN HR_WEEK_DAYS WD ON WD.DAY_ID = SD.DAY_ID
            WHERE SD.SHIFT_ID = E.WORK_SHIFT_ID 
              AND SD.IS_OFF = 1 
              AND WD.DAY_NAME_EN = TRIM(TO_CHAR(DR.DAY_DATE, 'DAY', 'NLS_DATE_LANGUAGE=AMERICAN'))
       )
     GROUP BY E.EMPLOYEE_ID
),
emp_days AS (
    SELECT E.EMPLOYEE_ID,
           E.CODE AS EMPLOYEE_CODE,
           E.FULL_NAME_AR AS EMPLOYEE_NAME,
           E.DEPARTMENT_ID,
           E.WORK_SHIFT_ID,
           E.RELIGION,
           DR.DAY_DATE
      FROM date_range DR
      CROSS JOIN HR_EMPLOYEES E
      JOIN absent_employees AE ON AE.EMPLOYEE_ID = E.EMPLOYEE_ID
     WHERE E.EMPLOYMENT_STATUS = 1
       AND E.WORK_SHIFT_TYPE_ID = 2
       AND ($P{P_EMPLOYEE_ID} IS NULL OR E.EMPLOYEE_ID = TO_NUMBER($P{P_EMPLOYEE_ID}))
       AND ($P{P_DEPARTMENT_ID} IS NULL OR E.DEPARTMENT_ID IN (
           SELECT ID FROM HR_DEPARTMENT
            START WITH ID = TO_NUMBER($P{P_DEPARTMENT_ID})
           CONNECT BY PRIOR ID = PARENT_ID
       ))
)
SELECT 
    ED.EMPLOYEE_ID,
    ED.EMPLOYEE_CODE,
    ED.EMPLOYEE_NAME,
    ED.DAY_DATE,
    EXTRACT(DAY FROM ED.DAY_DATE) AS DAY_NUM,
    CASE 
        -- 1. Attended
        WHEN AL.EMPLOYEE_ID IS NOT NULL THEN 1 -- Present
        -- 2. Leave
        WHEN LV.EMPLOYEE_ID IS NOT NULL THEN 2 -- Leave
        -- 3. Mission
        WHEN MS.EMPLOYEE_ID IS NOT NULL THEN 3 -- Mission
        -- 4. Registered Absence
        WHEN AB.EMPLOYEE_ID IS NOT NULL THEN 4 -- Registered Absence
        -- 5. Public Holiday
        WHEN PH.HOLIDAY_DATE IS NOT NULL THEN 5 -- Public Holiday
        -- 6. Weekly Off
        WHEN WO.SHIFT_ID IS NOT NULL THEN 6 -- Weekly Off
        -- 7. Not Present (Unexcused Absence)
        ELSE 7 -- Not Present (لم يحضر)
    END AS STATUS_ID,
    (CASE WHEN $P{P_EMPLOYEE_ID} IS NOT NULL THEN (SELECT DECODE($P{P_LANG}, 'ar', E2.FULL_NAME_AR, E2.FULL_NAME_EN) FROM HR_EMPLOYEES E2 WHERE E2.EMPLOYEE_ID = TO_NUMBER($P{P_EMPLOYEE_ID})) ELSE NULL END) AS SELECTED_EMPLOYEE_NAME,
    (CASE WHEN $P{P_DEPARTMENT_ID} IS NOT NULL THEN (SELECT DECODE($P{P_LANG}, 'ar', D2.ARABIC_NAME, D2.NAME) FROM HR_DEPARTMENT D2 WHERE D2.ID = TO_NUMBER($P{P_DEPARTMENT_ID})) ELSE NULL END) AS SELECTED_DEPARTMENT_NAME
FROM emp_days ED
LEFT JOIN HR_ATTENDANCE_LOG AL ON AL.EMPLOYEE_ID = ED.EMPLOYEE_ID AND AL.ATTENDANCE_DATE = ED.DAY_DATE
LEFT JOIN (
    SELECT LR.EMPLOYEE_ID, LR.START_DATE, LR.END_DATE
      FROM HR_EMPLOYEE_LEAVE_REQUESTS LR
     WHERE LR.STATUS_ID = 4
) LV ON LV.EMPLOYEE_ID = ED.EMPLOYEE_ID AND ED.DAY_DATE BETWEEN LV.START_DATE AND LV.END_DATE
LEFT JOIN (
    SELECT M.EMPLOYEE_ID, M.START_DATE, M.END_DATE
      FROM HR_EMPLOYEE_MISSIONS M
     WHERE M.STATUS_ID = 4
) MS ON MS.EMPLOYEE_ID = ED.EMPLOYEE_ID AND ED.DAY_DATE BETWEEN MS.START_DATE AND MS.END_DATE
LEFT JOIN (
    SELECT AB.EMPLOYEE_ID, AB.ABSENCE_DATE, NVL(AB.END_DATE, AB.ABSENCE_DATE) AS END_DATE
      FROM HR_ABSENCE_LOG AB
     WHERE AB.STATUS = '1'
) AB ON AB.EMPLOYEE_ID = ED.EMPLOYEE_ID AND ED.DAY_DATE BETWEEN AB.ABSENCE_DATE AND AB.END_DATE
LEFT JOIN HR_OFFICIAL_HOLIDAYS PH ON PH.HOLIDAY_DATE = ED.DAY_DATE AND PH.STATUS = 1 AND (PH.RELIGION_ID IS NULL OR PH.RELIGION_ID = ED.RELIGION) AND (PH.SHIFT_ID IS NULL OR PH.SHIFT_ID = ED.WORK_SHIFT_ID)
LEFT JOIN (
    SELECT SD.SHIFT_ID, WD.DAY_NAME_EN
      FROM HR_WORK_SHIF_DAYS SD
      JOIN HR_WEEK_DAYS WD ON WD.DAY_ID = SD.DAY_ID
     WHERE SD.IS_OFF = 1
) WO ON WO.SHIFT_ID = ED.WORK_SHIFT_ID AND WO.DAY_NAME_EN = TRIM(TO_CHAR(ED.DAY_DATE, 'DAY', 'NLS_DATE_LANGUAGE=AMERICAN'))
ORDER BY ED.EMPLOYEE_NAME, ED.DAY_DATE]]>
	</queryString>
	<field name="EMPLOYEE_ID" class="java.math.BigDecimal"/>
	<field name="EMPLOYEE_CODE" class="java.lang.String"/>
	<field name="EMPLOYEE_NAME" class="java.lang.String"/>
	<field name="DAY_DATE" class="java.sql.Timestamp"/>
	<field name="DAY_NUM" class="java.math.BigDecimal"/>
	<field name="STATUS_ID" class="java.math.BigDecimal"/>
	<field name="SELECTED_EMPLOYEE_NAME" class="java.lang.String"/>
	<field name="SELECTED_DEPARTMENT_NAME" class="java.lang.String"/>
