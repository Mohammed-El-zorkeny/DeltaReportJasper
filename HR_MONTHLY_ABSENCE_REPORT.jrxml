	<summary>
		<band height="50" splitType="Stretch">
			<crosstab isRepeatColumnHeaders="true">
				<reportElement x="0" y="0" width="802" height="40" uuid="cc33dd44-0006-0001-0001-000000000001"/>
				<rowGroup name="EmployeeGroup" width="180">
					<bucket class="java.lang.String">
						<bucketExpression><![CDATA[$F{EMPLOYEE_CODE} + " - " + $F{EMPLOYEE_NAME}]]></bucketExpression>
					</bucket>
					<crosstabRowHeader>
						<cellContents>
							<box>
								<pen lineWidth="0.5" lineColor="#BDC3C7"/>
							</box>
							<textField isBlankWhenNull="true">
								<reportElement mode="Opaque" x="0" y="0" width="180" height="20" backcolor="#F9FAFB" uuid="cc33dd44-0006-0002-0001-000000000001"/>
								<box rightPadding="5"/>
								<textElement textAlignment="Right" verticalAlignment="Middle">
									<font fontName="IBM Plex Sans Arabic" size="8" isBold="true"/>
								</textElement>
								<textFieldExpression><![CDATA[$V{EmployeeGroup}]]></textFieldExpression>
							</textField>
						</cellContents>
					</crosstabRowHeader>
				</rowGroup>
				<columnGroup name="DayGroup" height="25">
					<bucket class="java.sql.Timestamp">
						<bucketExpression><![CDATA[$F{DAY_DATE}]]></bucketExpression>
					</bucket>
					<crosstabColumnHeader>
						<cellContents>
							<box>
								<pen lineWidth="0.5" lineColor="#BDC3C7"/>
							</box>
							<textField>
								<reportElement mode="Opaque" x="0" y="0" width="20" height="25" backcolor="#1F4E79" forecolor="#FFFFFF" uuid="cc33dd44-0006-0003-0001-000000000001"/>
								<textElement textAlignment="Center" verticalAlignment="Middle">
									<font fontName="IBM Plex Sans Arabic" size="8" isBold="true"/>
								</textElement>
								<textFieldExpression><![CDATA[new java.text.SimpleDateFormat("dd").format($V{DayGroup})]]></textFieldExpression>
							</textField>
						</cellContents>
					</crosstabColumnHeader>
				</columnGroup>
				<measure name="StatusMeasure" class="java.lang.Integer" calculation="First">
					<measureExpression><![CDATA[new java.lang.Integer($F{STATUS_ID}.intValue())]]></measureExpression>
				</measure>
				<crosstabCell width="20" height="20">
					<cellContents>
						<box>
							<pen lineWidth="0.5" lineColor="#BDC3C7"/>
						</box>
						<!-- Present or Null -->
						<textField isBlankWhenNull="true">
							<reportElement mode="Transparent" x="0" y="0" width="20" height="20" uuid="cc33dd44-0006-0004-0001-000000000001">
								<printWhenExpression><![CDATA[new Boolean($V{StatusMeasure} == null || $V{StatusMeasure}.intValue() == 1)]]></printWhenExpression>
							</reportElement>
							<textElement textAlignment="Center" verticalAlignment="Middle">
								<font fontName="IBM Plex Sans Arabic" size="8"/>
							</textElement>
							<textFieldExpression><![CDATA[""]]></textFieldExpression>
						</textField>
						<!-- Leave (2) -->
						<textField isBlankWhenNull="true">
							<reportElement mode="Opaque" x="0" y="0" width="20" height="20" backcolor="#EBF5FB" forecolor="#2980B9" uuid="cc33dd44-0006-0004-0001-000000000003">
								<printWhenExpression><![CDATA[new Boolean($V{StatusMeasure} != null && $V{StatusMeasure}.intValue() == 2)]]></printWhenExpression>
							</reportElement>
							<textElement textAlignment="Center" verticalAlignment="Middle">
								<font fontName="IBM Plex Sans Arabic" size="8" isBold="true"/>
							</textElement>
							<textFieldExpression><![CDATA["إ"]]></textFieldExpression>
						</textField>
						<!-- Half Day Leave (8) -->
						<textField isBlankWhenNull="true">
							<reportElement mode="Opaque" x="0" y="0" width="20" height="20" backcolor="#FEF9E7" forecolor="#D35400" uuid="cc33dd44-0006-0004-0001-000000000009">
								<printWhenExpression><![CDATA[new Boolean($V{StatusMeasure} != null && $V{StatusMeasure}.intValue() == 8)]]></printWhenExpression>
							</reportElement>
							<textElement textAlignment="Center" verticalAlignment="Middle">
								<font fontName="IBM Plex Sans Arabic" size="8" isBold="true"/>
							</textElement>
							<textFieldExpression><![CDATA["ن"]]></textFieldExpression>
						</textField>
						<!-- Mission (3) -->
						<textField isBlankWhenNull="true">
							<reportElement mode="Opaque" x="0" y="0" width="20" height="20" backcolor="#E8F8F5" forecolor="#117A65" uuid="cc33dd44-0006-0004-0001-000000000004">
								<printWhenExpression><![CDATA[new Boolean($V{StatusMeasure} != null && $V{StatusMeasure}.intValue() == 3)]]></printWhenExpression>
							</reportElement>
							<textElement textAlignment="Center" verticalAlignment="Middle">
								<font fontName="IBM Plex Sans Arabic" size="8" isBold="true"/>
							</textElement>
							<textFieldExpression><![CDATA["م"]]></textFieldExpression>
						</textField>
						<!-- Registered Absence (4) -->
						<textField isBlankWhenNull="true">
							<reportElement mode="Opaque" x="0" y="0" width="20" height="20" backcolor="#FDEDEC" forecolor="#C0392B" uuid="cc33dd44-0006-0004-0001-000000000005">
								<printWhenExpression><![CDATA[new Boolean($V{StatusMeasure} != null && $V{StatusMeasure}.intValue() == 4)]]></printWhenExpression>
							</reportElement>
							<textElement textAlignment="Center" verticalAlignment="Middle">
