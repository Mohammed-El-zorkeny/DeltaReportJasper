				<textFieldExpression><![CDATA["\u202B" + ("ar".equals($P{P_LANG}) ? new java.text.SimpleDateFormat("EEEE  dd/MM/yyyy  -  hh:mm a", new java.util.Locale("ar")).format(new java.util.Date()) : new java.text.SimpleDateFormat("EEEE  dd/MM/yyyy  -  hh:mm a", java.util.Locale.ENGLISH).format(new java.util.Date())) + "\u202C"]]></textFieldExpression>
