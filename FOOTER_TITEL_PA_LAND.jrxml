	<parameter name="P_USERPRINT" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="P_LANG" class="java.lang.String">
		<defaultValueExpression><![CDATA["ar"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    NVL(MAX(E.FULL_NAME_AR), $P{P_USERPRINT}) AS EMP_NAME_AR,
    NVL(MAX(E.FULL_NAME_EN), $P{P_USERPRINT}) AS EMP_NAME_EN,
    MAX(D.ARABIC_NAME) AS DEPT_NAME_AR,
    MAX(D.NAME) AS DEPT_NAME_EN
FROM DUAL
LEFT JOIN SEC_USERS U ON U.USERNAME = $P{P_USERPRINT}
LEFT JOIN HR_EMPLOYEES E ON E.EMPLOYEE_ID = U.REFERENCE_USER_ID
LEFT JOIN HR_DEPARTMENT D ON D.ID = E.DEPARTMENT_ID]]>
	</queryString>
	<field name="EMP_NAME_AR" class="java.lang.String"/>
	<field name="EMP_NAME_EN" class="java.lang.String"/>
	<field name="DEPT_NAME_AR" class="java.lang.String"/>
	<field name="DEPT_NAME_EN" class="java.lang.String"/>
