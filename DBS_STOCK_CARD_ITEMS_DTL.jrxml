	<parameter name="P_LANG" class="java.lang.String"/>
	<parameter name="P_USERNAME" class="java.lang.String"/>
	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_ID" class="java.lang.String"/>
	<parameter name="P_START_DATE" class="java.lang.String"/>
	<parameter name="P_END_DATE" class="java.lang.String"/>
	<parameter name="P_TRANS_TYPE" class="java.lang.String"/>
	<parameter name="P_ITEM_ID" class="java.lang.String"/>
	<parameter name="P_SUB_STORE" class="java.lang.String"/>
	<parameter name="P_STORE_ID" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
    ROW_NUMBER() OVER (ORDER BY ITEM_CODE, SERIAL_NO NULLS LAST) AS SERIAL_NO,
    ID,
    AUTO_NUMBER_BRA,
    TRANS_DATE,
    TRANS_TYPE,
    ITEM_NAME,
    ITEM_CODE,
    QTY,
    VALUE_TYPE,
    QTY_IN,
    QTY_OUT,
    BALANCE
FROM (
    SELECT 
        SERIAL_NO,
        ID,
        AUTO_NUMBER_BRA,
        TO_CHAR(TRANS_DATE, 'YYYY-MM-DD') AS TRANS_DATE,
        TRANS_TYPE,
        ITEM_NAME,
        ITEM_CODE,
        QTY,
        VALUE_TYPE,
        QTY_IN,
        QTY_OUT,
        SUM(QTY_IN - QTY_OUT) OVER (
            PARTITION BY ITEM_CODE 
            ORDER BY SERIAL_NO
        ) AS BALANCE
    FROM V_DBS_STOCK_TRANS_DTL
    WHERE ($P{P_ITEM_ID} IS NULL OR ITEM_CODE = $P{P_ITEM_ID})
      AND (TO_CHAR(TRANS_DATE, 'YYYY-MM-DD') BETWEEN $P{P_START_DATE} AND $P{P_END_DATE}
           OR ($P{P_START_DATE} IS NULL AND $P{P_END_DATE} IS NULL))
      AND ($P{P_STORE_ID} IS NULL OR STORE_ID = $P{P_STORE_ID})
      AND ($P{P_SUB_STORE} IS NULL OR SUB_STORE_ID = $P{P_SUB_STORE})

    UNION ALL

    SELECT 
        NULL AS SERIAL_NO,
        NULL AS ID,
        '-' AS AUTO_NUMBER_BRA,
        '-' AS TRANS_DATE,
        'إجمالي' AS TRANS_TYPE,
        ITEM_NAME,
        ITEM_CODE,
        NULL AS QTY,
        NULL AS VALUE_TYPE,
        SUM(QTY_IN) AS QTY_IN,
        SUM(QTY_OUT) AS QTY_OUT,
        SUM(QTY_IN - QTY_OUT) AS BALANCE
    FROM V_DBS_STOCK_TRANS_DTL
    WHERE ($P{P_ITEM_ID} IS NULL OR ITEM_CODE = $P{P_ITEM_ID})
      AND (TO_CHAR(TRANS_DATE, 'YYYY-MM-DD') BETWEEN $P{P_START_DATE} AND $P{P_END_DATE}
           OR ($P{P_START_DATE} IS NULL AND $P{P_END_DATE} IS NULL))
      AND ($P{P_STORE_ID} IS NULL OR STORE_ID = $P{P_STORE_ID})
      AND ($P{P_SUB_STORE} IS NULL OR SUB_STORE_ID = $P{P_SUB_STORE})
    GROUP BY ITEM_NAME, ITEM_CODE
)
ORDER BY ITEM_CODE NULLS LAST, SERIAL_NO NULLS LAST]]>
	</queryString>
