<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="advance_request_form" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="24d755f4-238f-4a89-bc73-5fda92ef057e">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Click APP"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="P_LANG" class="java.lang.String"/>
	<parameter name="P_LOAN_ID" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
    L.ID AS LOAN_ID,
    L.REQUEST_NO,
    TO_CHAR(L.REQUEST_DATE, 'DD/MM/YYYY') AS REQUEST_DATE,
    L.AMOUNT,
    L.REASON,
    L.REPAYMENT_AMOUNT AS MONTHLY_DEDUCTION,
    TO_CHAR(L.START_DATE, 'DD-MM-YYYY') AS START_DATE,
    TO_CHAR(L.END_DATE, 'DD-MM-YYYY') AS END_DATE,
    L.EMPLOYEE_ID,
    NVL(DECODE($P{P_LANG}, 'ar', NVL(E.FULL_NAME_AR, E.FULL_NAME_EN), NVL(E.FULL_NAME_EN, E.FULL_NAME_AR)), '-') AS EMPLOYEE_NAME,
    NVL(DECODE($P{P_LANG}, 'ar', NVL(J.ARABIC_NAME, J.NAME), NVL(J.NAME, J.ARABIC_NAME)), '-') AS JOB_TITLE,
    NVL(DECODE($P{P_LANG}, 'ar', NVL(D.ARABIC_NAME, D.NAME), NVL(D.NAME, D.ARABIC_NAME)), '-') AS DEPARTMENT,
    NVL(TO_CHAR(E.HIRE_DATE, 'DD-MM-YYYY'), '-') AS HIRE_DATE,
    NVL(TO_CHAR(E.BASIC_SALARY), '-') AS BASIC_SALARY,
    NVL(DECODE($P{P_LANG}, 'ar', NVL(C.NAME_AR, C.NAME_EN), NVL(C.NAME_EN, C.NAME_AR)), '-') AS COMPANY_NAME,
    (SELECT COUNT(*) 
     FROM HR_EMPLOYEE_LOANS 
     WHERE EMPLOYEE_ID = L.EMPLOYEE_ID 
       AND STATUS_ID = 2 
      ) AS COUNT_EMPLOYEE_LOANS
FROM HR_EMPLOYEE_LOANS L
JOIN HR_EMPLOYEES E ON L.EMPLOYEE_ID = E.EMPLOYEE_ID
LEFT JOIN HR_JOB_TITLE J ON E.JOB_ID = J.ID   
LEFT JOIN HR_DEPARTMENT D ON E.DEPARTMENT_ID = D.ID
LEFT JOIN DBS_COMP C ON E.COMPANY_ID = C.ID
WHERE L.ID = $P{P_LOAN_ID}]]>
	</queryString>
