				<textElement textAlignment="Right" verticalAlignment="Top">
					<font fontName="IBM Plex Sans Arabic" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["يرجى من سيادتكم الموافقة على منحي سلفة نقديه قدرها (" + $F{AMOUNT} + " د.ك)"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
