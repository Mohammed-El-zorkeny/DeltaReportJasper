	<parameter name="P_LANG" class="java.lang.String">
		<defaultValueExpression><![CDATA["en"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_BRANCH_ID" class="java.lang.String"/>
	<parameter name="P_USERPRINT" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[WITH V_CATEGORIES AS (
    SELECT 'العمالة الإدارية' AS CAT_NAME_AR, 'Administrative Staff' AS CAT_NAME_EN, 1 AS CAT_ID FROM dual
    UNION ALL
    SELECT 'العمالة الفنية' AS CAT_NAME_AR, 'Technical Staff' AS CAT_NAME_EN, 2 AS CAT_ID FROM dual
    UNION ALL
    SELECT 'العمالة التسويقية' AS CAT_NAME_AR, 'Marketing Staff' AS CAT_NAME_EN, 3 AS CAT_ID FROM dual
    UNION ALL
    SELECT 'العمالة الإنتاجية' AS CAT_NAME_AR, 'Production Staff' AS CAT_NAME_EN, 4 AS CAT_ID FROM dual
    UNION ALL
    SELECT 'عمالة أخرى' AS CAT_NAME_AR, 'Other Staff' AS CAT_NAME_EN, 5 AS CAT_ID FROM dual
),
V_DEPT_HIERARCHY AS (
    SELECT 
        D.ID,
        D.PARENT_ID,
        D.DEPARTMENT_CATGOERY_ID,
        D.COMPANY_ID,
        D.BRANCH_ID
    FROM HR_DEPARTMENT D
    WHERE D.STATUS = '1'
),
V_CAT_DEPT_PAIRS AS (
    SELECT DISTINCT
        CONNECT_BY_ROOT(H.DEPARTMENT_CATGOERY_ID) AS CAT_ID,
        H.ID AS DEPT_ID
    FROM V_DEPT_HIERARCHY H
    START WITH H.DEPARTMENT_CATGOERY_ID IS NOT NULL
    CONNECT BY PRIOR H.ID = H.PARENT_ID
),
V_CAT_EMP AS (
    SELECT DISTINCT
        P.CAT_ID,
        E.EMPLOYEE_ID
    FROM V_CAT_DEPT_PAIRS P
    JOIN HR_EMPLOYEES E ON E.DEPARTMENT_ID = P.DEPT_ID
    WHERE ($P{P_COMP_ID} IS NULL OR E.COMPANY_ID = $P{P_COMP_ID})
      AND ($P{P_BRANCH_ID} IS NULL OR E.BRANCH_ID = $P{P_BRANCH_ID})
),
V_CAT_COUNTS AS (
    SELECT 
        CAT_ID, 
        COUNT(*) AS TOTAL_EMP_COUNT
    FROM V_CAT_EMP
    GROUP BY CAT_ID
)
SELECT 
    C.CAT_ID,
    DECODE($P{P_LANG}, 'ar', C.CAT_NAME_AR, C.CAT_NAME_EN) AS CAT_NAME,
    NVL(CC.TOTAL_EMP_COUNT, 0) AS TOTAL_EMP_COUNT
FROM V_CATEGORIES C
LEFT JOIN V_CAT_COUNTS CC ON CC.CAT_ID = C.CAT_ID
ORDER BY C.CAT_ID ASC]]>
	</queryString>
	<field name="CAT_ID" class="java.math.BigDecimal"/>
	<field name="CAT_NAME" class="java.lang.String"/>
	<field name="TOTAL_EMP_COUNT" class="java.math.BigDecimal"/>
	<variable name="VAL_GRAND_TOTAL_EMP" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTAL_EMP_COUNT}]]></variableExpression>
	</variable>
