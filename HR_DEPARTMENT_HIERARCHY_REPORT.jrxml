	<property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<style name="HierarchicalRowStyle" mode="Opaque" forecolor="#000000" backcolor="#FFFFFF">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{DEPT_LEVEL} != null && $F{DEPT_LEVEL}.intValue() == 1]]></conditionExpression>
			<style forecolor="#1F4E79" backcolor="#D9E2F3" isBold="true"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{DEPT_LEVEL} != null && $F{DEPT_LEVEL}.intValue() == 2]]></conditionExpression>
			<style forecolor="#2C3E50" backcolor="#EAF2F8" isBold="true"/>
		</conditionalStyle>
	</style>
	<parameter name="P_LANG" class="java.lang.String">
		<defaultValueExpression><![CDATA["ar"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_BRANCH_ID" class="java.lang.String"/>
	<parameter name="P_USERPRINT" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    D.ID,
    D.PARENT_ID,
    LEVEL AS DEPT_LEVEL,
    CASE 
        WHEN LEVEL = 1 THEN DECODE($P{P_LANG}, 'ar', D.ARABIC_NAME, D.NAME)
        ELSE LPAD(' ', (LEVEL - 1) * 4) || '├─ ' || DECODE($P{P_LANG}, 'ar', D.ARABIC_NAME, D.NAME)
    END AS INDENTED_DEPARTMENT_NAME,
    (
        SELECT COUNT(*) 
        FROM HR_EMPLOYEES E 
        WHERE E.DEPARTMENT_ID IN (
            SELECT ID 
            FROM HR_DEPARTMENT
            START WITH ID = D.ID
            CONNECT BY PRIOR ID = PARENT_ID
        )
    ) AS TOTAL_EMP_COUNT
FROM HR_DEPARTMENT D
WHERE D.STATUS = '1'
  AND ($P{P_COMP_ID} IS NULL OR D.COMPANY_ID = $P{P_COMP_ID})
  AND ($P{P_BRANCH_ID} IS NULL OR D.BRANCH_ID = $P{P_BRANCH_ID})
START WITH D.PARENT_ID IS NULL
CONNECT BY PRIOR D.ID = D.PARENT_ID]]>
	</queryString>
	<field name="ID" class="java.math.BigDecimal"/>
	<field name="PARENT_ID" class="java.math.BigDecimal"/>
	<field name="DEPT_LEVEL" class="java.math.BigDecimal"/>
	<field name="INDENTED_DEPARTMENT_NAME" class="java.lang.String"/>
	<field name="TOTAL_EMP_COUNT" class="java.math.BigDecimal"/>
