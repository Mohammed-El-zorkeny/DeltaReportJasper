		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[WITH V_DEPT_PAIRS AS (
    SELECT 
        CONNECT_BY_ROOT(ID) AS ANCESTOR_ID,
        ID AS DESCENDANT_ID
    FROM HR_DEPARTMENT
    WHERE STATUS = '1'
    CONNECT BY PRIOR ID = PARENT_ID
),
V_DEPT_COUNTS AS (
    SELECT DEPARTMENT_ID, COUNT(*) AS EMP_COUNT
    FROM HR_EMPLOYEES
    GROUP BY DEPARTMENT_ID
),
V_CUMULATIVE_COUNTS AS (
    SELECT 
        P.ANCESTOR_ID AS DEPARTMENT_ID,
        SUM(NVL(C.EMP_COUNT, 0)) AS TOTAL_EMP_COUNT
    FROM V_DEPT_PAIRS P
    LEFT JOIN V_DEPT_COUNTS C ON C.DEPARTMENT_ID = P.DESCENDANT_ID
    GROUP BY P.ANCESTOR_ID
),
V_DEPT_HIERARCHY AS (
    SELECT 
        D.ID,
        D.PARENT_ID,
        LEVEL AS DEPT_LEVEL,
        D.NAME AS DEPT_NAME_EN,
        D.ARABIC_NAME AS DEPT_NAME_AR,
        D.COMPANY_ID,
        D.BRANCH_ID,
        ROWNUM AS HIER_ORDER
    FROM HR_DEPARTMENT D
    WHERE D.STATUS = '1'
    START WITH D.PARENT_ID IS NULL
    CONNECT BY PRIOR D.ID = D.PARENT_ID
    ORDER SIBLINGS BY D.CODE ASC
)
SELECT 
    H.ID,
    H.PARENT_ID,
    H.DEPT_LEVEL,
    CASE 
        WHEN H.DEPT_LEVEL = 1 THEN H.DEPT_NAME_AR
        ELSE LPAD(' ', (H.DEPT_LEVEL - 1) * 4) || '├─ ' || H.DEPT_NAME_AR
    END AS INDENTED_DEPARTMENT_NAME,
    NVL(CC.TOTAL_EMP_COUNT, 0) AS TOTAL_EMP_COUNT
FROM V_DEPT_HIERARCHY H
LEFT JOIN V_CUMULATIVE_COUNTS CC ON CC.DEPARTMENT_ID = H.ID
WHERE ($P{P_COMP_ID} IS NULL OR H.COMPANY_ID = $P{P_COMP_ID})
  AND ($P{P_BRANCH_ID} IS NULL OR H.BRANCH_ID = $P{P_BRANCH_ID})
ORDER BY H.HIER_ORDER ASC]]>
	</queryString>
	<field name="ID" class="java.math.BigDecimal"/>
	<field name="PARENT_ID" class="java.math.BigDecimal"/>
	<field name="DEPT_LEVEL" class="java.math.BigDecimal"/>
	<field name="INDENTED_DEPARTMENT_NAME" class="java.lang.String"/>
	<field name="TOTAL_EMP_COUNT" class="java.math.BigDecimal"/>
