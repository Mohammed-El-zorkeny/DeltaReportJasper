	<parameter name="P_LANG" class="java.lang.String"/>
	<parameter name="P_ID" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT ROW_NUMBER() OVER (ORDER BY ID) AS SERIAL_NO,
       DBS_STOCK_ITEMS_LANG_NAME(DBS_STOCK_ITEMS_ID, $P{P_LANG}
       ) AS ITEM_NAME,
       QTY,
       PRICE,
       TOTAL_VALUE,
       DISCOUNT_VALUE,
       TAX_VALUE,
       FINAL_VALUE
FROM "DBS_SAL_INVOICE_DTL" a
where DBS_SAL_INVOICE_ID = $P{P_ID}]]>
	</queryString>
