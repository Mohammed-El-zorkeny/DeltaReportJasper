					<font fontName="IBM Plex Sans Arabic Medium" size="10" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{COMPANY_BANK_NAME_AR}]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
