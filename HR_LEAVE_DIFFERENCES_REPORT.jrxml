	<queryString>
		<![CDATA[SELECT x."رقم_الموظف", x."اسم_الموظف", x."الإدارة",
       x."عدد_الأيام", x."من_تاريخ", x."إلى_تاريخ" ,
x.نوع_الأجازة
FROM   LEAVE_EX_06 x
WHERE  NOT EXISTS (
         SELECT 1
         FROM   HR_EMPLOYEE_LEAVE_REQUESTS r
         JOIN   HR_EMPLOYEES e ON e.EMPLOYEE_ID = r.EMPLOYEE_ID
         WHERE  TO_NUMBER(e.CODE) = x."رقم_الموظف"
           AND  r.START_DATE >= DATE '2026-06-01'
           AND  r.START_DATE <  DATE '2026-07-01'
       )
ORDER BY x."الإدارة", x."رقم_الموظف"]]>
	</queryString>
