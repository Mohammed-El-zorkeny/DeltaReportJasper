	<field name="اسم_الموظف" class="java.lang.String"/>
	<field name="الإدارة" class="java.lang.String"/>
	<field name="عدد_الأيام" class="java.math.BigDecimal"/>
	<field name="من_تاريخ" class="java.sql.Timestamp"/>
