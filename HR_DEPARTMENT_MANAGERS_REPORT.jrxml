	<parameter name="P_LANG" class="java.lang.String">
		<defaultValueExpression><![CDATA["ar"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_BRANCH_ID" class="java.lang.String"/>
	<parameter name="P_USERPRINT" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    LEVEL AS DEPT_LEVEL,
    CASE 
        WHEN LEVEL > 1 THEN LPAD(' ', (LEVEL - 1) * 4, ' ') || '└── ' || DECODE($P{P_LANG}, 'ar', D.ARABIC_NAME, D.NAME)
        ELSE DECODE($P{P_LANG}, 'ar', D.ARABIC_NAME, D.NAME)
    END AS DEPT_NAME,
    M.CODE AS MGR_CODE,
    DECODE($P{P_LANG}, 'ar', M.FULL_NAME_AR, M.FULL_NAME_EN) AS MGR_NAME
FROM HR_DEPARTMENT D
LEFT JOIN HR_EMPLOYEES M ON D.MANAGER_ID = M.EMPLOYEE_ID
WHERE D.STATUS = '1'
  AND ($P{P_COMP_ID} IS NULL OR D.COMPANY_ID = $P{P_COMP_ID})
  AND ($P{P_BRANCH_ID} IS NULL OR D.BRANCH_ID = $P{P_BRANCH_ID})
START WITH D.PARENT_ID IS NULL
CONNECT BY PRIOR D.ID = D.PARENT_ID
ORDER SIBLINGS BY D.CODE]]>
	</queryString>
	<field name="DEPT_LEVEL" class="java.math.BigDecimal"/>
	<field name="DEPT_NAME" class="java.lang.String"/>
	<field name="MGR_CODE" class="java.lang.String"/>
	<field name="MGR_NAME" class="java.lang.String"/>
	<variable name="ROW_NUM" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{DEPT_NAME}]]></variableExpression>
	</variable>
