	<parameter name="P_LANG" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
    DBS_STOCK_ITEMS_LANG_NAME(DBS_STOCK_ITEMS_ID, $P{P_LANG}) AS ITEM_NAME,
    QTY,
    PRICE,
    TOTAL_VALUE,
    TAX_VALUE,
    TAX_PERCENTAGE,
    FINAL_VALUE,
    NOTES
FROM DBS_SAL_INVOICE_DTL
WHERE DBS_SAL_INVOICE_ID = $P{P_ID}]]>
	</queryString>
