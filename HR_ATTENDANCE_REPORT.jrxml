	<style name="AttendanceStatusStyle" mode="Opaque" forecolor="#000000" backcolor="#FFFFFF">
		<conditionalStyle>
			<conditionExpression><![CDATA[($F{HAS_OUT} == null ? 0 : $F{HAS_OUT}.intValue()) == 0]]></conditionExpression>
			<style forecolor="#C0392B" backcolor="#FDEDEC" isBold="true"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[($F{HAS_OUT} != null ? $F{HAS_OUT}.intValue() : 0) == 1]]></conditionExpression>
			<style forecolor="#27AE60" backcolor="#E8F8F5" isBold="true"/>
		</conditionalStyle>
	</style>
	<parameter name="P_LANG" class="java.lang.String">
		<defaultValueExpression><![CDATA["ar"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_USERPRINT" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="P_EMPLOYEE_ID" class="java.lang.String"/>
	<parameter name="P_DEPARTMENT_ID" class="java.lang.String"/>
	<parameter name="P_SHIFT_ID" class="java.lang.String"/>
	<parameter name="P_SITE_ID" class="java.lang.String"/>
	<parameter name="P_EMPLOYEE_CATEGORY_ID" class="java.lang.String"/>
	<parameter name="P_FROM_DATE" class="java.lang.String"/>
	<parameter name="P_TO_DATE" class="java.lang.String"/>
	<parameter name="P_STATUS_ID" class="java.lang.String"/>
	<parameter name="P_CHECK_TIME" class="java.lang.String"/>
	<parameter name="P_CHECK_TYPE" class="java.lang.String"/>
	<parameter name="P_TIME_DIRECTION" class="java.lang.String"/>
	<parameter name="P_CHECK_TIME_TO" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    A.EMPLOYEE_ID,
    A.EMPLOYEE_CODE,
    A.DEPARTMENT_ID,
    A.SHIFT_ID,
    A.SITES_ID,
    A.ATTENDANCE_DATE,
    TO_CHAR(A.CHECK_IN_TIME, 'HH12:MI PM')  AS CHECK_IN_TIME,
    CASE WHEN A.HAS_OUT = 1
         THEN TO_CHAR(A.CHECK_OUT_TIME, 'HH12:MI PM')
    END                                      AS CHECK_OUT_TIME,
    CASE WHEN A.HAS_OUT = 1
         THEN ROUND((A.CHECK_OUT_TIME - A.CHECK_IN_TIME) * 24, 2)
    END                                      AS WORKING_HOURS,
    A.HAS_IN,
    A.HAS_OUT,
    TO_CHAR(A.SHIFT_START, 'HH12:MI PM')    AS SHIFT_START,
    TO_CHAR(A.SHIFT_END,   'HH12:MI PM')    AS SHIFT_END,
    CASE
        WHEN A.HAS_OUT = 1 THEN DECODE($P{P_LANG}, 'ar', 'حاضر - مكتمل',    'Present - Complete')
        ELSE                    DECODE($P{P_LANG}, 'ar', 'حاضر - لم ينصرف', 'Present - No Check Out')
    END                                      AS ATTENDANCE_STATUS,
    CASE
        WHEN A.HAS_OUT = 1 THEN 'greenBadge'
        ELSE                    'orangeBadge'
    END                                      AS STATUS_CLASS,
    CASE
        WHEN A.CHECK_IN_TIME > A.SHIFT_START + (1/24)
        THEN
            CASE
                WHEN HR_GET_LEAVE_REMAINING(A.EMPLOYEE_ID, 3) > 0
                THEN DECODE($P{P_LANG}, 'ar', 'خصم يوم إجازة سنوية', 'Annual Leave Deduction')
                ELSE DECODE($P{P_LANG}, 'ar', 'غياب مسجل',           'Registered Absence')
            END
        ELSE NULL
    END                                      AS LATE_PENALTY_STATUS,
    CASE
        WHEN A.CHECK_IN_TIME > A.SHIFT_START + (1/24)
        THEN HR_GET_LEAVE_REMAINING(A.EMPLOYEE_ID, 3)
        ELSE NULL
    END                                      AS ANNUAL_LEAVE_BALANCE,
    
    DECODE($P{P_LANG}, 'ar', E.FULL_NAME_AR, E.FULL_NAME_EN) AS EMPLOYEE_NAME,
    DECODE($P{P_LANG}, 'ar', D.ARABIC_NAME, D.NAME) AS DEPARTMENT_NAME,
    DECODE($P{P_LANG}, 'ar', S.ARABIC_NAME, S.NAME) AS SHIFT_NAME,
    (SELECT DECODE($P{P_LANG}, 'ar', E2.FULL_NAME_AR, E2.FULL_NAME_EN) FROM HR_EMPLOYEES E2 WHERE E2.EMPLOYEE_ID = $P{P_EMPLOYEE_ID}) AS SELECTED_EMPLOYEE_NAME,
    (SELECT DECODE($P{P_LANG}, 'ar', D2.ARABIC_NAME, D2.NAME) FROM HR_DEPARTMENT D2 WHERE D2.ID = $P{P_DEPARTMENT_ID}) AS SELECTED_DEPARTMENT_NAME

FROM VW_ATTENDANCE_LOG A
LEFT JOIN HR_EMPLOYEES E ON E.EMPLOYEE_ID = A.EMPLOYEE_ID
LEFT JOIN HR_DEPARTMENT D ON D.ID = A.DEPARTMENT_ID
LEFT JOIN HR_WORK_SHIFTS S ON S.ID = A.SHIFT_ID
WHERE NVL(A.HAS_IN, 0) = 1
  AND ($P{P_EMPLOYEE_ID}          IS NULL OR A.EMPLOYEE_ID          = $P{P_EMPLOYEE_ID})
  AND (
      $P{P_DEPARTMENT_ID} IS NULL
      OR A.DEPARTMENT_ID IN (
          SELECT ID FROM HR_DEPARTMENT
           START WITH ID      = $P{P_DEPARTMENT_ID}
          CONNECT BY PRIOR ID = PARENT_ID
      )
  )
  AND ($P{P_SHIFT_ID}             IS NULL OR A.SHIFT_ID             = $P{P_SHIFT_ID})
  AND ($P{P_SITE_ID}              IS NULL OR A.SITES_ID             = $P{P_SITE_ID})
  AND ($P{P_EMPLOYEE_CATEGORY_ID} IS NULL OR A.EMPLOYEE_CATEGORY_ID = $P{P_EMPLOYEE_CATEGORY_ID})
  AND ($P{P_FROM_DATE}            IS NULL OR A.ATTENDANCE_DATE >= TO_DATE($P{P_FROM_DATE}, 'DD-MM-YYYY'))
  AND ($P{P_TO_DATE}              IS NULL OR A.ATTENDANCE_DATE <= TO_DATE($P{P_TO_DATE},   'DD-MM-YYYY'))
  AND (
      $P{P_STATUS_ID} IS NULL
      OR (
          $P{P_STATUS_ID} = '1'
          AND A.HAS_OUT = 1
      )
      OR (
          $P{P_STATUS_ID} = '2'
          AND A.HAS_OUT = 0
      )
  )
  AND (
      $P{P_CHECK_TIME} IS NULL
      OR (UPPER($P{P_CHECK_TYPE}) = 'IN'  AND UPPER($P{P_TIME_DIRECTION}) = 'B'  AND A.CHECK_IN_TIME  < TO_DATE($P{P_CHECK_TIME}, 'HH24:MI'))
      OR (UPPER($P{P_CHECK_TYPE}) = 'IN'  AND UPPER($P{P_TIME_DIRECTION}) = 'A'  AND A.CHECK_IN_TIME  > TO_DATE($P{P_CHECK_TIME}, 'HH24:MI'))
      OR (UPPER($P{P_CHECK_TYPE}) = 'IN'  AND UPPER($P{P_TIME_DIRECTION}) = 'BT' AND A.CHECK_IN_TIME  BETWEEN TO_DATE($P{P_CHECK_TIME}, 'HH24:MI') AND TO_DATE($P{P_CHECK_TIME_TO}, 'HH24:MI'))
      OR (UPPER($P{P_CHECK_TYPE}) = 'OUT' AND UPPER($P{P_TIME_DIRECTION}) = 'B'  AND A.HAS_OUT = 1 AND A.CHECK_OUT_TIME < TO_DATE($P{P_CHECK_TIME}, 'HH24:MI'))
      OR (UPPER($P{P_CHECK_TYPE}) = 'OUT' AND UPPER($P{P_TIME_DIRECTION}) = 'A'  AND A.HAS_OUT = 1 AND A.CHECK_OUT_TIME > TO_DATE($P{P_CHECK_TIME}, 'HH24:MI'))
      OR (UPPER($P{P_CHECK_TYPE}) = 'OUT' AND UPPER($P{P_TIME_DIRECTION}) = 'BT' AND A.HAS_OUT = 1 AND A.CHECK_OUT_TIME BETWEEN TO_DATE($P{P_CHECK_TIME}, 'HH24:MI') AND TO_DATE($P{P_CHECK_TIME_TO}, 'HH24:MI'))
      OR ($P{P_CHECK_TYPE} IS NULL AND UPPER($P{P_TIME_DIRECTION}) = 'BT' AND A.HAS_OUT = 1 AND A.CHECK_IN_TIME >= TO_DATE($P{P_CHECK_TIME}, 'HH24:MI') AND A.CHECK_OUT_TIME <= TO_DATE($P{P_CHECK_TIME_TO}, 'HH24:MI'))
  )
ORDER BY A.ATTENDANCE_DATE DESC, E.FULL_NAME_AR ASC]]>
	</queryString>
