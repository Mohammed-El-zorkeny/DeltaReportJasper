	<queryString language="SQL">
		<![CDATA[SELECT 
    ID,
    DBS_TRE_PAYMENT_ID AS PAYMENT_ID,
    DBS_TRE_COST_CENTRE_DTL_ID AS COST_CENTRE_ID,
    ACC_COST_CENTER_NAME_LANG(DBS_TRE_COST_CENTRE_DTL_ID, $P{P_LANG}) AS COST_CENTRE_NAME,
    DBS_ACC_CURRENCY_ID AS CURRENCY_ID,
    DBS_ACC_CURRENCY_LANG_NAME(DBS_ACC_CURRENCY_ID, $P{P_LANG}) AS CURRENCY_NAME,
    DBS_ACC_CHART_OF_ACCOUNTS_ID AS ACCOUNTS_ID,
    DBS_ACC_CHART_OF_ACCOUNTS_LANG_NAME(DBS_ACC_CHART_OF_ACCOUNTS_ID, $P{P_LANG}) AS ACCOUNTS_NAME,
    VALUE,
    NOTES
FROM DBS_TRE_PAYMENT_DTL a
WHERE DBS_TRE_PAYMENT_ID = $P{P_ID}]]>
	</queryString>
