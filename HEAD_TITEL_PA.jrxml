	<queryString>
		<![CDATA[SELECT 
    COMP.NAME_AR AS NAME_AR,
    COMP.NAME_EN AS NAME_EN,
    COMP.COMMERCIAL_REGISTER_NUMBER AS CR_NUMBER,
    COMP.TAX_ID AS VAT_NUMBER,
    COMP.PHONE_NUMBER_1 AS PHONE,
    COMP.EMAIL AS EMAIL,
    COMP.LOCATION AS WEB_SITE,
    COMP.ADDREES AS ADDREES,
    COMP.FAX_NUMBER AS FAX_NUMBER,
    COMP.POSTAL_CODE AS POSTAL_CODE,
    application_settings_pkg.get_company_logo_url(COMP.ID) AS COMPANY_LOGO_FILE_PATH
FROM DBS_COMP COMP
WHERE COMP.ID = $P{P_COMP_ID}]]>
	</queryString>
