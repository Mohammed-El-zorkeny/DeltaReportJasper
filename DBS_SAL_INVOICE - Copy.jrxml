<!-- Created with Jaspersoft Studio version 6.20.6.final using JasperReports Library version 6.20.6-5c96b6aa8a39ac1dc6b6bea4b81168e16dd39231  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DBS_SAL_INVOICE" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="2c1c10a0-edea-451a-a4d3-b6b9274a9b6c">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="erp"/>
	<property name="com.jaspersoft.studio.report.description" value=""/>
	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_ID" class="java.lang.String"/>
	<parameter name="P_LANG" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT a.ID,
       a.COMP_ID,
       a.BRANCH_ID,
       a.AUTO_NUMBER,
       a.AUTO_NUMBER_BRA,
       DBS_SAL_CUSTOMERS_LANG_NAME(a.DBS_SAL_CUSTOMERS_ID, $P{P_LANG}) AS CUST_NAME,
       DBS_SAL_CUSTOMER_PHONE(a.DBS_SAL_CUSTOMERS_ID) AS CUST_PHONE,
       DBS_SAL_SALES_MAN_LANG_NAME(a.DBS_SAL_SALES_ID, $P{P_LANG}) AS SALES_NAME,
       DBS_SAL_SALES_MAN_PHONE(a.DBS_SAL_SALES_ID) AS SALES_PHONE,
       DBS_STOCK_STORE_LANG_NAME(a.DBS_STOCK_STORE_ID, $P{P_LANG}) AS STORE_NAME,
       DBS_STOCK_STORE_DTL_LANG_NAME(a.DBS_STOCK_SUB_STORE_ID, $P{P_LANG}) AS SUB_STORE_NAME,
       DBS_PAYMENT_TYPE_LANG_NAME(a.PAYMENT_TYPE, $P{P_LANG}) AS PAYMENT_TYPE,
       TO_CHAR(a.INV_DATE, 'YYYY-MM-DD') AS INV_DATE,
       a.CHECK_TAX,
       a.INV_NUMBER_TAX,
       a.BANK_ID,
       NVL(a.AMOUNT_PAID, 0) AS AMOUNT_PAID,
       NVL(a.AMOUNT_DUE, 0) AS AMOUNT_DUE,
       NVL(a.TOTAL_VALUE, 0) AS TOTAL_VALUE,
       NVL(a.DISCOUNT_VALUE, 0) AS DISCOUNT_VALUE,
       NVL(a.TOTAL_NET_AF_DISCOUNT, 0) AS TOTAL_NET_AF_DISCOUNT,
       NVL(a.TAX_VALUE, 0) AS TAX_VALUE,
       NVL(a.TOTAL_NET_AF_TAX, 0) AS TOTAL_NET_AF_TAX,
       NVL(a.DELIVERY_VALUE, 0) AS DELIVERY_VALUE,
       NVL(a.FINAL_VALUE, 0) AS FINAL_VALUE,
       a.NOTES,
       a.STATUS,
       CUST.NAME AS ENTITY_NAME,
       CUST.NAME_AR,
       CUST.COMMERCIAL_REGISTER,
       CUST.TAX_NUMBER,
       CUST.PHONE AS ENTITY_PHONE,
       CUST.EMAIL,
       CUST.WEBSITE,
       NVL(CUST.CITY, '') AS CITY,
       NVL(CUST.DISTRICT, '') AS DISTRICT,
       NVL(CUST.NEIGHBORHOOD, '') AS NEIGHBORHOOD,
       NVL(CUST.STREET, '') AS STREET,
       COMP.NAME_AR AS COMPANY_NAME,
       COMP.PHONE_NUMBER_1 AS COMPANY_PHONE,
       COMP.EMAIL AS COMPANY_EMAIL,
       COMP.LOCATION AS COMPANY_LOCATION,
       COMP.TAX_ID AS COMPANY_TAX_ID,
       COMP.REGISTRATION_NUMBER AS COMPANY_REGISTRATION_NUMBER,
       application_settings_pkg.get_company_logo_url(COMP.ID) AS COMPANY_LOGO_FILE_PATH,
       -- 👇 QR Code للفاتورة (حسب معايير الزاتكا السعودية)
       QR_CODE_INVOICE(
           COMP.NAME_AR,                              -- اسم البائع
           COMP.TAX_ID,                               -- الرقم الضريبي
           a.INV_DATE,  -- التاريخ والوقت
           TO_CHAR(NVL(a.FINAL_VALUE, 0)),            -- إجمالي الفاتورة (مع الضريبة)
           TO_CHAR(NVL(a.TAX_VALUE, 0))               -- قيمة الضريبة
       ) AS QR_CODE_BASE64
FROM "DBS_SAL_INVOICE" a,
     GNL_ENTITY CUST,
     DBS_COMP COMP
WHERE a.ID = $P{P_ID}
  AND a.DBS_SAL_CUSTOMERS_ID = CUST.ID
  AND a.COMP_ID = COMP.ID]]>
	</queryString>
