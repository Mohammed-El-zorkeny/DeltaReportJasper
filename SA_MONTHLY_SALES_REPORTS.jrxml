	<property name="com.jaspersoft.studio.report.description" value=""/>
	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_ENTITY_ID" class="java.lang.String"/>
	<parameter name="P_FROM_DATE" class="java.lang.String"/>
	<parameter name="P_TO_DATE" class="java.lang.String"/>
	<parameter name="P_LANG" class="java.lang.String"/>
	<parameter name="P_USERNAME" class="java.lang.String"/>
	<parameter name="P_INVOICE_TYPE" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT I.ID,
       I.AUTO_NUMBER_BRA,
       GNL_ENTITY_NAME_LANG(I.ENTITY_ID, $P{P_LANG}) AS ENTITY_NAME,
       GNL_ENTITY_TAX_NUMBER(I.ENTITY_ID) AS TAX_NUMBER,
       I.INV_DATE,
       I.TOTAL_VALUE,
       I.DISCOUNT_VALUE,
       I.TOTAL_NET_AF_DISCOUNT,
       I.TAX_VALUE,
       I.TOTAL_NET_AF_TAX,
       I.DELIVERY_VALUE,
       I.FINAL_VALUE,
       T.ENTRY_SETTING AS TYPE
FROM DBS_SAL_INVOICE I
INNER JOIN SAL_INVOICE_TYPE T ON T.ID = I.INVOICE_TYPE_ID
WHERE I.COMP_ID = $P{P_COMP_ID}
  AND (I.ENTITY_ID = $P{P_ENTITY_ID} OR $P{P_ENTITY_ID} IS NULL)
  AND (TO_CHAR(I.INV_DATE, 'DD-MM-YYYY') >= $P{P_FROM_DATE})
  AND (TO_CHAR(I.INV_DATE, 'DD-MM-YYYY') <= $P{P_TO_DATE})
  AND (T.ENTRY_SETTING = $P{P_INVOICE_TYPE} OR $P{P_INVOICE_TYPE} IS NULL)
ORDER BY I.INV_DATE, I.AUTO_NUMBER_BRA]]>
	</queryString>
