	<parameter name="P_LANG" class="java.lang.String"/>
	<parameter name="P_ID" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
    DTL.ID,
    DTL.PRICE_LIST_ID,
    ITEM_ID,   
    ITEM_CODE,
   nvl( ITEM_SIDE,' - ') as ITEM_SIDE, 
    ITEM_NAME,
    GROUP_NAME,
    UOM,
    PRICELIST,
    nvl(QTY_OFFER,0) as QTY_OFFER,
    MS.TYPE_ID
    
FROM VW_PLAN_PRICE_LIST_DTL DTL ,VW_PLAN_PRICE_LIST MS
where  DTL.PRICE_LIST_ID = $P{P_ID}
AND MS.ID =  DTL.PRICE_LIST_ID
order by SEQ]]>
	</queryString>
