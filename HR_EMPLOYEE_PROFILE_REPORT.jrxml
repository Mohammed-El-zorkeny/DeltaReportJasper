	<parameter name="P_LANG" class="java.lang.String">
		<defaultValueExpression><![CDATA["ar"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_USERPRINT" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="P_EMPLOYEE_ID" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    E.EMPLOYEE_ID,
    E.CODE AS EMPLOYEE_CODE,
    DECODE(LOWER($P{P_LANG}), 'ar', E.FULL_NAME_AR, E.FULL_NAME_EN) AS EMPLOYEE_NAME,
    DECODE(LOWER($P{P_LANG}), 'ar', D.ARABIC_NAME, D.NAME) AS DEPARTMENT_NAME,
    DECODE(LOWER($P{P_LANG}), 'ar', J.ARABIC_NAME, J.NAME) AS JOB_TITLE,
    DECODE(LOWER($P{P_LANG}), 'ar', G.ARABIC_NAME, G.NAME) AS FINANCIAL_GRADE,
    E.HIRE_DATE,
    E.ID_NUMBER AS NATIONAL_ID,
    E.PHONE_PRIMARY AS PHONE,
    E.EMAIL_WORK AS EMAIL,
    E.DATE_OF_BIRTH,
    E.BASIC_SALARY,
    -- Annual Leave Balances (ID 3)
    HR_GET_LEAVE_ENTITLEMENT(E.EMPLOYEE_ID, 3, EXTRACT(YEAR FROM SYSDATE)) AS ANNUAL_ENTITLEMENT,
    HR_GET_CARRIED_FORWARD(E.EMPLOYEE_ID, EXTRACT(YEAR FROM SYSDATE)) AS ANNUAL_CARRIED,
    HR_GET_LEAVE_BALANCE_USED(E.EMPLOYEE_ID, 3, EXTRACT(YEAR FROM SYSDATE)) AS ANNUAL_USED,
    HR_GET_LEAVE_REMAINING(E.EMPLOYEE_ID, 3, EXTRACT(YEAR FROM SYSDATE)) AS ANNUAL_REMAINING,
    -- Casual Leave Balances (ID 24)
    HR_GET_LEAVE_ENTITLEMENT(E.EMPLOYEE_ID, 24, EXTRACT(YEAR FROM SYSDATE)) AS CASUAL_ENTITLEMENT,
    HR_GET_LEAVE_BALANCE_USED(E.EMPLOYEE_ID, 24, EXTRACT(YEAR FROM SYSDATE)) AS CASUAL_USED,
    HR_GET_LEAVE_REMAINING(E.EMPLOYEE_ID, 24, EXTRACT(YEAR FROM SYSDATE)) AS CASUAL_REMAINING
FROM HR_EMPLOYEES E
LEFT JOIN HR_DEPARTMENT D ON E.DEPARTMENT_ID = D.ID
LEFT JOIN HR_JOB_TITLE J ON E.JOB_ID = J.ID
LEFT JOIN HR_JOB_GRADES G ON E.JOB_GRADE_ID = G.ID
WHERE E.EMPLOYEE_ID = TO_NUMBER($P{P_EMPLOYEE_ID})]]>
	</queryString>
