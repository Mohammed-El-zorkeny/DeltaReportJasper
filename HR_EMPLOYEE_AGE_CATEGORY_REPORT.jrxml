	<parameter name="P_LANG" class="java.lang.String">
		<defaultValueExpression><![CDATA["ar"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_BRANCH_ID" class="java.lang.String"/>
	<parameter name="P_USERPRINT" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[WITH V_DEPT_HIERARCHY AS (
    SELECT 
        D.ID,
        D.PARENT_ID,
        D.DEPARTMENT_CATGOERY_ID
    FROM HR_DEPARTMENT D
    WHERE D.STATUS = '1'
),
V_CAT_DEPT_PAIRS AS (
    SELECT DISTINCT
        CONNECT_BY_ROOT(H.DEPARTMENT_CATGOERY_ID) AS CAT_ID,
        H.ID AS DEPT_ID
    FROM V_DEPT_HIERARCHY H
    START WITH H.DEPARTMENT_CATGOERY_ID IS NOT NULL
    CONNECT BY PRIOR H.ID = H.PARENT_ID
),
V_EMP_AGE_GROUP AS (
    SELECT DISTINCT
        E.EMPLOYEE_ID,
        P.CAT_ID,
        TRUNC(MONTHS_BETWEEN(SYSDATE, E.DATE_OF_BIRTH) / 12) AS AGE,
        CASE
            WHEN TRUNC(MONTHS_BETWEEN(SYSDATE, E.DATE_OF_BIRTH) / 12) >= 30 AND TRUNC(MONTHS_BETWEEN(SYSDATE, E.DATE_OF_BIRTH) / 12) < 40 THEN 1
            WHEN TRUNC(MONTHS_BETWEEN(SYSDATE, E.DATE_OF_BIRTH) / 12) >= 40 AND TRUNC(MONTHS_BETWEEN(SYSDATE, E.DATE_OF_BIRTH) / 12) < 45 THEN 2
            WHEN TRUNC(MONTHS_BETWEEN(SYSDATE, E.DATE_OF_BIRTH) / 12) >= 45 AND TRUNC(MONTHS_BETWEEN(SYSDATE, E.DATE_OF_BIRTH) / 12) < 50 THEN 3
            WHEN TRUNC(MONTHS_BETWEEN(SYSDATE, E.DATE_OF_BIRTH) / 12) >= 50 AND TRUNC(MONTHS_BETWEEN(SYSDATE, E.DATE_OF_BIRTH) / 12) < 55 THEN 4
            WHEN TRUNC(MONTHS_BETWEEN(SYSDATE, E.DATE_OF_BIRTH) / 12) >= 55 AND TRUNC(MONTHS_BETWEEN(SYSDATE, E.DATE_OF_BIRTH) / 12) <= 58 THEN 5
            ELSE 6
        END AS AGE_GROUP_ID,
        E.COMPANY_ID,
        E.BRANCH_ID
    FROM HR_EMPLOYEES E
    JOIN V_CAT_DEPT_PAIRS P ON E.DEPARTMENT_ID = P.DEPT_ID
    WHERE E.DATE_OF_BIRTH IS NOT NULL
      AND ($P{P_COMP_ID} IS NULL OR E.COMPANY_ID = $P{P_COMP_ID})
      AND ($P{P_BRANCH_ID} IS NULL OR E.BRANCH_ID = $P{P_BRANCH_ID})
),
V_AGE_GROUPS AS (
    SELECT 1 AS AGE_GROUP_ID, 'من 30 : 40' AS AGE_GROUP_AR, '30 - 40' AS AGE_GROUP_EN FROM dual
    UNION ALL
    SELECT 2 AS AGE_GROUP_ID, 'من 40 : 45' AS AGE_GROUP_AR, '40 - 45' AS AGE_GROUP_EN FROM dual
    UNION ALL
    SELECT 3 AS AGE_GROUP_ID, 'من 45 : 50' AS AGE_GROUP_AR, '45 - 50' AS AGE_GROUP_EN FROM dual
    UNION ALL
    SELECT 4 AS AGE_GROUP_ID, 'من 50 : 55' AS AGE_GROUP_AR, '50 - 55' AS AGE_GROUP_EN FROM dual
    UNION ALL
    SELECT 5 AS AGE_GROUP_ID, 'من 55 : 58' AS AGE_GROUP_AR, '55 - 58' AS AGE_GROUP_EN FROM dual
    UNION ALL
    SELECT 6 AS AGE_GROUP_ID, 'أخرى' AS AGE_GROUP_AR, 'Other' AS AGE_GROUP_EN FROM dual
)
SELECT 
    G.AGE_GROUP_ID,
    DECODE($P{P_LANG}, 'ar', G.AGE_GROUP_AR, G.AGE_GROUP_EN) AS AGE_GROUP_NAME,
    SUM(CASE WHEN E.CAT_ID = 1 THEN 1 ELSE 0 END) AS CAT_1_COUNT,
    SUM(CASE WHEN E.CAT_ID = 4 THEN 1 ELSE 0 END) AS CAT_2_COUNT,
    SUM(CASE WHEN E.CAT_ID = 2 THEN 1 ELSE 0 END) AS CAT_3_COUNT,
    SUM(CASE WHEN E.CAT_ID = 3 THEN 1 ELSE 0 END) AS CAT_4_COUNT,
    SUM(CASE WHEN E.CAT_ID = 5 THEN 1 ELSE 0 END) AS CAT_5_COUNT,
    COUNT(E.EMPLOYEE_ID) AS TOTAL_COUNT
FROM V_AGE_GROUPS G
LEFT JOIN V_EMP_AGE_GROUP E ON E.AGE_GROUP_ID = G.AGE_GROUP_ID
GROUP BY G.AGE_GROUP_ID, G.AGE_GROUP_AR, G.AGE_GROUP_EN
ORDER BY G.AGE_GROUP_ID ASC]]>
	</queryString>
	<field name="AGE_GROUP_ID" class="java.math.BigDecimal"/>
	<field name="AGE_GROUP_NAME" class="java.lang.String"/>
	<field name="CAT_1_COUNT" class="java.math.BigDecimal"/>
	<field name="CAT_2_COUNT" class="java.math.BigDecimal"/>
	<field name="CAT_3_COUNT" class="java.math.BigDecimal"/>
	<field name="CAT_4_COUNT" class="java.math.BigDecimal"/>
	<field name="CAT_5_COUNT" class="java.math.BigDecimal"/>
	<field name="TOTAL_COUNT" class="java.math.BigDecimal"/>

	<variable name="SUM_CAT_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{CAT_1_COUNT}]]></variableExpression>
	</variable>
	<variable name="SUM_CAT_2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{CAT_2_COUNT}]]></variableExpression>
	</variable>
	<variable name="SUM_CAT_3" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{CAT_3_COUNT}]]></variableExpression>
	</variable>
	<variable name="SUM_CAT_4" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{CAT_4_COUNT}]]></variableExpression>
	</variable>
	<variable name="SUM_CAT_5" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{CAT_5_COUNT}]]></variableExpression>
	</variable>
	<variable name="SUM_TOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTAL_COUNT}]]></variableExpression>
	</variable>
