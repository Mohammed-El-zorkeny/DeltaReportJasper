	<queryString language="SQL">
		<![CDATA[select ID,
       COMP_ID,
       BRANCH_ID,
       AUTO_NUMBER,
       AUTO_NUMBER_BRA,
       DBS_SAL_CUSTOMERS_LANG_NAME(DBS_SAL_CUSTOMERS_ID,$P{P_LANG}) as CUST_NAME,
       DBS_SAL_CUSTOMER_PHONE(DBS_SAL_CUSTOMERS_ID) as CUST_PHONE,
       DBS_SAL_SALES_MAN_LANG_NAME(DBS_SAL_SALES_ID,$P{P_LANG}) as SALES_NAME,
       DBS_SAL_SALES_MAN_PHONE(DBS_SAL_SALES_ID) as SALES_PHONE,
       DBS_STOCK_STORE_LANG_NAME(DBS_STOCK_STORE_ID,$P{P_LANG}) as STORE_NAME,
       DBS_STOCK_STORE_DTL_LANG_NAME(DBS_STOCK_SUB_STORE_ID,$P{P_LANG}) as SUB_STORE_NAME,
       DBS_PAYMENT_TYPE_LANG_NAME(PAYMENT_TYPE, $P{P_LANG}) as PAYMENT_TYPE,
       to_char(INV_DATE,'YYYY-MM-DD') as INV_DATE, 
       CHECK_TAX,
       INV_NUMBER_TAX,
       BANK_ID,
       AMOUNT_PAID,
       AMOUNT_DUE,
       TOTAL_VALUE,
       DISCOUNT_VALUE,
       TOTAL_NET_AF_DISCOUNT,
       TAX_VALUE,
       TOTAL_NET_AF_TAX,
       DELIVERY_VALUE,
       FINAL_VALUE,
       NOTES,
       STATUS,
       CREATED,
       CREATED_BY,
       UPDATED,
       UPDATED_BY
from "DBS_SAL_INVOICE" a
where ID= $P{P_ID}]]>
	</queryString>
