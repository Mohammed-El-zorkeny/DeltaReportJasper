	<queryString>
		<![CDATA[SELECT
    R.ID,
    R.CODE                                              AS REQ_CODE,
    R.NAME                                              AS REQ_NAME,
    TO_CHAR(R.REQUEST_DATE,           'DD/MM/YYYY')     AS REQUEST_DATE,
    TO_CHAR(R.EXPECTED_DELIVERY_DATE, 'DD/MM/YYYY')     AS EXPECTED_DATE,
    HR_DEPARTMENT_NAME_LANG(R.DEPARTMENT_ID, 'AR')      AS DEPT_NAME,
    HR_EMPLOYEES_NAME_LANG(R.EMPLOYEE_ID,    'AR')      AS EMP_NAME,
    GNL_STATUS_NAME_LANG  (R.STATUS_ID,      'AR')      AS STATUS_NAME,
    R.NOTES                                             AS REQ_NOTES
FROM PUR_REQUISITION R
WHERE R.ID = $P{P_REQUEST_ID}]]>
	</queryString>
	<field name="ID" class="java.math.BigDecimal"/>
	<field name="REQ_CODE" class="java.lang.String"/>
