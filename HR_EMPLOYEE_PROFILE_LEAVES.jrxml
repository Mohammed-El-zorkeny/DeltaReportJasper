<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="HR_EMPLOYEE_PROFILE_LEAVES" pageWidth="555" pageHeight="842" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="b8f64789-9012-4bae-8765-3456789012cc">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Delta"/>
	<style name="HeaderStyle" mode="Opaque" forecolor="#FFFFFF" backcolor="#1F4E79" fontName="IBM Plex Sans Arabic" fontSize="9" isBold="true">
		<box>
			<pen lineWidth="0.5" lineColor="#BDC3C7"/>
		</box>
	</style>
	<style name="RowStyle" mode="Opaque" forecolor="#2C3E50" backcolor="#FFFFFF" fontName="IBM Plex Sans Arabic" fontSize="8">
		<box>
			<pen lineWidth="0.5" lineColor="#BDC3C7"/>
		</box>
		<conditionalStyle>
			<conditionExpression><![CDATA[new Boolean($V{REPORT_COUNT}.intValue() % 2 == 0)]]></conditionExpression>
			<style backcolor="#F9FAFB"/>
		</conditionalStyle>
	</style>
	<parameter name="P_EMPLOYEE_ID" class="java.lang.String"/>
	<parameter name="P_LANG" class="java.lang.String">
		<defaultValueExpression><![CDATA["ar"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    R.START_DATE, 
    R.END_DATE, 
    DECODE(LOWER($P{P_LANG}), 'ar', LT.ARABIC_NAME, LT.NAME) AS LEAVE_TYPE_NAME, 
    R.TOTAL_LEAVE_DAYS, 
    DECODE(LOWER($P{P_LANG}), 'ar', RS.ARABIC_NAME, RS.NAME) AS STATUS_NAME
FROM HR_EMPLOYEE_LEAVE_REQUESTS R
JOIN HR_LEAVE_TYPES LT ON R.LEAVE_TYPE_ID = LT.ID
JOIN HR_LEAVE_STATUS RS ON R.STATUS_ID = RS.ID
WHERE R.EMPLOYEE_ID = TO_NUMBER($P{P_EMPLOYEE_ID})
ORDER BY R.START_DATE DESC]]>
	</queryString>
	<field name="START_DATE" class="java.sql.Timestamp"/>
	<field name="END_DATE" class="java.sql.Timestamp"/>
	<field name="LEAVE_TYPE_NAME" class="java.lang.String"/>
	<field name="TOTAL_LEAVE_DAYS" class="java.math.BigDecimal"/>
	<field name="STATUS_NAME" class="java.lang.String"/>
	<variable name="ROW_NUM" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{LEAVE_TYPE_NAME}]]></variableExpression>
	</variable>
	<columnHeader>
		<band height="40" splitType="Stretch">
			<!-- Section Title -->
			<textField>
