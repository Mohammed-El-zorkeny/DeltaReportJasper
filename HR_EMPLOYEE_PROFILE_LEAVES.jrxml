					<font fontName="IBM Plex Sans Arabic" size="9" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["ar".equals($P{P_LANG}) ? "سجل الإجازات التفصيلي" : "Detailed Leaves History"]]></textFieldExpression>
			</textField>
			<!-- Table Headers -->
			<textField>
				<reportElement style="HeaderStyle" x="525" y="20" width="30" height="20" uuid="cc33dd44-0002-0001-0001-000000000001"/>
