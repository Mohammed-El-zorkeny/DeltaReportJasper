<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="TAX_RETURN_REPORT" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isIgnorePagination="true" uuid="a1b2c3d4-e5f6-7890-1234-567890abcdef">
	<property name="net.sf.jasperreports.print.keep.full.text" value="true"/>
	<property name="net.sf.jasperreports.export.pdf.force.linebreak.policy" value="true"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="erp"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_BRANCH_ID" class="java.lang.String"/>
	<parameter name="P_FROM_DATE" class="java.lang.String"/>
	<parameter name="P_TO_DATE" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    NVL(SUM(CASE WHEN T.ENTRY_SETTING IN ('INV_SAL', 'INV_SAL_RET') 
                 THEN I.TOTAL_NET_AF_DISCOUNT 
                 ELSE 0 END), 0) AS SALES_AMOUNT,
    NVL(SUM(CASE WHEN T.ENTRY_SETTING IN ('INV_SAL', 'INV_SAL_RET') 
                 THEN I.TAX_VALUE 
                 ELSE 0 END), 0) AS SALES_TAX,
    NVL(SUM(CASE WHEN T.ENTRY_SETTING IN ('INV_PUR', 'INV_PUR_RET') 
                 THEN I.TOTAL_NET_AF_DISCOUNT 
                 ELSE 0 END), 0) AS PURCHASE_AMOUNT,
    NVL(SUM(CASE WHEN T.ENTRY_SETTING IN ('INV_PUR', 'INV_PUR_RET') 
                 THEN I.TAX_VALUE 
                 ELSE 0 END), 0) AS PURCHASE_TAX
FROM DBS_SAL_INVOICE I
INNER JOIN SAL_INVOICE_TYPE T ON T.ID = I.INVOICE_TYPE_ID
WHERE I.COMP_ID = $P{P_COMP_ID}
  AND I.BRANCH_ID = $P{P_BRANCH_ID}
  AND TRUNC(I.INV_DATE) BETWEEN TRUNC(TO_DATE($P{P_FROM_DATE}, 'DD-MM-YYYY')) 
                            AND TRUNC(TO_DATE($P{P_TO_DATE}, 'DD-MM-YYYY'))]]>
	</queryString>
	<field name="SALES_AMOUNT" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="SALES_AMOUNT"/>
		<property name="com.jaspersoft.studio.field.label" value="SALES_AMOUNT"/>
	</field>
	<field name="SALES_TAX" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="SALES_TAX"/>
		<property name="com.jaspersoft.studio.field.label" value="SALES_TAX"/>
	</field>
	<field name="PURCHASE_AMOUNT" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="PURCHASE_AMOUNT"/>
		<property name="com.jaspersoft.studio.field.label" value="PURCHASE_AMOUNT"/>
	</field>
	<field name="PURCHASE_TAX" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="PURCHASE_TAX"/>
		<property name="com.jaspersoft.studio.field.label" value="PURCHASE_TAX"/>
	</field>
	<variable name="NET_TAX" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$F{SALES_TAX}.subtract($F{PURCHASE_TAX})]]></variableExpression>
	</variable>
