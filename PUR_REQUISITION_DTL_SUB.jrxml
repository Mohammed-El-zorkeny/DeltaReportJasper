	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Delta"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="P_REQUEST_ID" class="java.lang.Long"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    D.ID,
    D.ITEM_ID,
    CASE
        WHEN D.ITEM_ID IS NOT NULL THEN
            (SELECT ITEM_CODE FROM DBS_STOCK_ITEMS WHERE ID = D.ITEM_ID)
        ELSE NULL
    END AS ITEM_CODE,
    CASE
        WHEN D.ITEM_ID IS NOT NULL THEN DBS_STOCK_ITEMS_LANG_NAME(D.ITEM_ID, 'AR')
        ELSE D.NAME
    END AS ITEM_NAME,
    D.QTY,
    SAL_CATEGORY_NAME_LANG(D.CAT_ID, 'AR') AS CAT_NAME,
    D.NOTES AS DTL_NOTES,
    (SELECT COUNT(*) FROM STOCK_ITEM_SPECS S
     WHERE S.TABLE_NAME = 'PUR_REQUISITION_DTL'
       AND S.ID_FK = D.ID
       AND S.STATUS = '1') AS SPECS_COUNT
FROM PUR_REQUISITION_DTL D
WHERE D.REQUEST_ID = $P{P_REQUEST_ID}
ORDER BY D.ID]]>
	</queryString>
