	<parameter name="P_LANG" class="java.lang.String">
		<defaultValueExpression><![CDATA["ar"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_USERPRINT" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="P_EMPLOYEE_ID" class="java.lang.String"/>
	<parameter name="P_DEPARTMENT_ID" class="java.lang.String"/>
	<parameter name="P_SHIFT_ID" class="java.lang.String"/>
	<parameter name="P_SITE_ID" class="java.lang.String"/>
	<parameter name="P_FROM_DATE" class="java.lang.String"/>
	<parameter name="P_TO_DATE" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    A.EMPLOYEE_CODE,
    A.EMPLOYEE_ID,
    A.DEPARTMENT_ID,
    A.ATTENDANCE_DATE,
    TO_CHAR(A.CHECK_IN_TIME,  'HH12:MI PM')    AS CHECK_IN_TIME,
    TO_CHAR(A.CHECK_OUT_TIME, 'HH12:MI PM')    AS CHECK_OUT_TIME,
    A.OT_DAYS_250_CALCULATED,
    A.OT_DAYS_400_CALCULATED,
    A.OVERTIME_DAYS_CALCULATED,
    DECODE($P{P_LANG}, 'ar', E.FULL_NAME_AR, E.FULL_NAME_EN) AS EMPLOYEE_NAME,
    DECODE($P{P_LANG}, 'ar', D.ARABIC_NAME, D.NAME) AS DEPARTMENT_NAME
FROM VW_OVERTIME_LOG A
LEFT JOIN HR_EMPLOYEES E ON E.EMPLOYEE_ID = A.EMPLOYEE_ID
LEFT JOIN HR_DEPARTMENT D ON D.ID = A.DEPARTMENT_ID
WHERE A.WORK_SHIFT_TYPE_ID = 2
  AND NVL(A.OVERTIME_HOURS_ACTUAL, 0)     > 0
  AND ($P{P_EMPLOYEE_ID}          IS NULL OR A.EMPLOYEE_ID          = $P{P_EMPLOYEE_ID})
  AND (
      $P{P_DEPARTMENT_ID} IS NULL
      OR A.DEPARTMENT_ID IN (
          SELECT ID FROM HR_DEPARTMENT
           START WITH ID      = $P{P_DEPARTMENT_ID}
          CONNECT BY PRIOR ID = PARENT_ID
      )
  )
  AND ($P{P_SHIFT_ID}             IS NULL OR A.SHIFT_ID             = $P{P_SHIFT_ID})
  AND ($P{P_SITE_ID}              IS NULL OR A.SITES_ID             = $P{P_SITE_ID})
  AND ($P{P_FROM_DATE}            IS NULL OR A.ATTENDANCE_DATE >= TO_DATE($P{P_FROM_DATE}, 'DD-MM-YYYY'))
  AND ($P{P_TO_DATE}              IS NULL OR A.ATTENDANCE_DATE <= TO_DATE($P{P_TO_DATE},   'DD-MM-YYYY'))
ORDER BY D.ARABIC_NAME ASC, E.FULL_NAME_AR ASC, A.ATTENDANCE_DATE ASC]]>
	</queryString>
