	<style name="AbsenceStatusStyle" mode="Opaque" forecolor="#000000" backcolor="#FFFFFF">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{STATUS_ID} != null && $F{STATUS_ID}.intValue() == 4]]></conditionExpression>
			<style forecolor="#2980B9" backcolor="#EBF5FB" isBold="true"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{STATUS_ID} != null && ($F{STATUS_ID}.intValue() == 3 || $F{STATUS_ID}.intValue() == 7)]]></conditionExpression>
			<style forecolor="#C0392B" backcolor="#FDEDEC" isBold="true"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{STATUS_ID} != null && ($F{STATUS_ID}.intValue() == 5 || $F{STATUS_ID}.intValue() == 6 || $F{STATUS_ID}.intValue() == 10)]]></conditionExpression>
			<style forecolor="#7F8C8D" backcolor="#F2F3F4" isBold="true"/>
		</conditionalStyle>
	</style>
	<parameter name="P_LANG" class="java.lang.String">
		<defaultValueExpression><![CDATA["ar"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_USERPRINT" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="P_EMPLOYEE_ID" class="java.lang.String"/>
	<parameter name="P_DEPARTMENT_ID" class="java.lang.String"/>
	<parameter name="P_EMPLOYEE_CATEGORY_ID" class="java.lang.String"/>
	<parameter name="P_FROM_DATE" class="java.lang.String"/>
	<parameter name="P_TO_DATE" class="java.lang.String"/>
	<parameter name="P_STATUS_ID" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    E.EMPLOYEE_ID,
    E.CODE                                                          AS EMPLOYEE_CODE,
    E.DEPARTMENT_ID,
    E.DAY_DATE                                                      AS ATTENDANCE_DATE,
    DECODE($P{P_LANG},
        'ar', TO_CHAR(E.DAY_DATE, 'DAY', 'NLS_DATE_LANGUAGE=ARABIC'),
              TO_CHAR(E.DAY_DATE, 'DAY', 'NLS_DATE_LANGUAGE=AMERICAN')
    )                                                               AS DAY_NAME,
    CASE
        WHEN LV.EMPLOYEE_ID  IS NOT NULL
            THEN DECODE($P{P_LANG}, 'ar', 'إجازة - ' || LV.LEAVE_TYPE_AR, 'Leave - ' || LV.LEAVE_TYPE_EN)
        WHEN AB.EMPLOYEE_ID  IS NOT NULL
            THEN DECODE($P{P_LANG}, 'ar', 'غياب مسجل',    'Registered Absence')
        WHEN PH.HOLIDAY_DATE IS NOT NULL
            THEN DECODE($P{P_LANG}, 'ar', 'عطلة رسمية',   'Public Holiday')
        WHEN CD.COMP_DATE    IS NOT NULL
            THEN DECODE($P{P_LANG}, 'ar', 'راحة مستحقة',  'Compensatory Day')
        WHEN WO.EMPLOYEE_ID  IS NOT NULL
            THEN DECODE($P{P_LANG}, 'ar', 'راحة أسبوعية', 'Weekly Off')
        ELSE DECODE($P{P_LANG}, 'ar', 'لم يحضر',          'Not Present')
    END                                                             AS ATTENDANCE_STATUS,
    CASE
        WHEN LV.EMPLOYEE_ID  IS NOT NULL THEN 'lightBlueBadge'
        WHEN AB.EMPLOYEE_ID  IS NOT NULL THEN 'redBadge'
        WHEN PH.HOLIDAY_DATE IS NOT NULL THEN 'grayBadge'
        WHEN CD.COMP_DATE    IS NOT NULL THEN 'grayBadge'
        WHEN WO.EMPLOYEE_ID  IS NOT NULL THEN 'grayBadge'
        ELSE                                  'redBadge'
    END                                                             AS STATUS_CLASS,
    CASE
        WHEN LV.EMPLOYEE_ID  IS NOT NULL THEN 4
        WHEN AB.EMPLOYEE_ID  IS NOT NULL THEN 3
        WHEN PH.HOLIDAY_DATE IS NOT NULL THEN 6
        WHEN CD.COMP_DATE    IS NOT NULL THEN 10
        WHEN WO.EMPLOYEE_ID  IS NOT NULL THEN 5
        ELSE                                  7
    END                                                             AS STATUS_ID,
    DECODE($P{P_LANG}, 'ar', E.FULL_NAME_AR, E.FULL_NAME_EN) AS EMPLOYEE_NAME,
    DECODE($P{P_LANG}, 'ar', E.DEPARTMENT_NAME_AR, E.DEPARTMENT_NAME_EN) AS DEPARTMENT_NAME,
    (SELECT DECODE($P{P_LANG}, 'ar', E2.FULL_NAME_AR, E2.FULL_NAME_EN) FROM HR_EMPLOYEES E2 WHERE E2.EMPLOYEE_ID = $P{P_EMPLOYEE_ID}) AS SELECTED_EMPLOYEE_NAME,
    (SELECT DECODE($P{P_LANG}, 'ar', D2.ARABIC_NAME, D2.NAME) FROM HR_DEPARTMENT D2 WHERE D2.ID = $P{P_DEPARTMENT_ID}) AS SELECTED_DEPARTMENT_NAME

FROM (
    SELECT E2.EMPLOYEE_ID,
           E2.CODE,
           E2.DEPARTMENT_ID,
           E2.WORK_SHIFT_ID,
           E2.RELIGION,
           E2.EMPLOYEE_CATEGORY_ID,
           E2.FULL_NAME_AR,
           E2.FULL_NAME_EN,
           D.ARABIC_NAME AS DEPARTMENT_NAME_AR,
           D.NAME AS DEPARTMENT_NAME_EN,
           CAL.DAY_DATE
      FROM HR_EMPLOYEES E2
      LEFT JOIN HR_DEPARTMENT D ON D.ID = E2.DEPARTMENT_ID,
           (
               SELECT TO_DATE($P{P_FROM_DATE}, 'DD-MM-YYYY') + LEVEL - 1 AS DAY_DATE
                 FROM DUAL
                WHERE $P{P_FROM_DATE} IS NOT NULL
                  AND $P{P_TO_DATE}   IS NOT NULL
               CONNECT BY LEVEL <= (
                   TO_DATE($P{P_TO_DATE},   'DD-MM-YYYY')
                 - TO_DATE($P{P_FROM_DATE}, 'DD-MM-YYYY') + 1
               )
           ) CAL
     WHERE E2.EMPLOYMENT_STATUS  = 1
       AND E2.WORK_SHIFT_TYPE_ID = 2
       AND ($P{P_EMPLOYEE_ID}          IS NULL OR E2.EMPLOYEE_ID          = $P{P_EMPLOYEE_ID})
       AND ($P{P_EMPLOYEE_CATEGORY_ID} IS NULL OR E2.EMPLOYEE_CATEGORY_ID = $P{P_EMPLOYEE_CATEGORY_ID})
       AND (
               $P{P_DEPARTMENT_ID} IS NULL
               OR E2.DEPARTMENT_ID IN (
                   SELECT ID FROM HR_DEPARTMENT
                    START WITH ID      = $P{P_DEPARTMENT_ID}
                   CONNECT BY PRIOR ID = PARENT_ID
               )
           )
       AND NOT EXISTS (
               SELECT 1 FROM HR_ATTENDANCE_LOG AL
                WHERE AL.EMPLOYEE_ID    = E2.EMPLOYEE_ID
                  AND AL.ATTENDANCE_DATE = CAL.DAY_DATE
           )
) E

LEFT JOIN (
    SELECT LR.EMPLOYEE_ID,
           LT.ARABIC_NAME AS LEAVE_TYPE_AR,
           LT.NAME        AS LEAVE_TYPE_EN,
           LR.START_DATE,
           LR.END_DATE
      FROM HR_EMPLOYEE_LEAVE_REQUESTS LR
      JOIN HR_LEAVE_TYPES LT ON LT.ID = LR.LEAVE_TYPE_ID
     WHERE LR.STATUS_ID      = 4
       AND LR.LEAVE_TYPE_ID NOT IN (29, 26, 28, 4)
) LV ON LV.EMPLOYEE_ID = E.EMPLOYEE_ID
     AND E.DAY_DATE BETWEEN LV.START_DATE AND LV.END_DATE

LEFT JOIN (
    SELECT AB.EMPLOYEE_ID,
           AB.ABSENCE_DATE,
           NVL(AB.END_DATE, AB.ABSENCE_DATE) AS END_DATE
      FROM HR_ABSENCE_LOG AB
     WHERE AB.STATUS = '1'
) AB ON AB.EMPLOYEE_ID = E.EMPLOYEE_ID
     AND E.DAY_DATE BETWEEN AB.ABSENCE_DATE AND AB.END_DATE

LEFT JOIN HR_OFFICIAL_HOLIDAYS PH
       ON PH.HOLIDAY_DATE = E.DAY_DATE
      AND PH.STATUS       = 1
      AND (PH.RELIGION_ID IS NULL OR PH.RELIGION_ID = E.RELIGION)
      AND (PH.SHIFT_ID    IS NULL OR PH.SHIFT_ID    = E.WORK_SHIFT_ID)

LEFT JOIN VW_SHIFT_COMPENSATORY_DAYS CD
       ON CD.WORK_SHIFT_ID = E.WORK_SHIFT_ID
      AND CD.COMP_DATE     = E.DAY_DATE

LEFT JOIN (
    SELECT DISTINCT E3.EMPLOYEE_ID,
                    WD.DAY_NAME_EN
      FROM HR_EMPLOYEES E3
      JOIN HR_WORK_SHIF_DAYS SD ON SD.SHIFT_ID = E3.WORK_SHIFT_ID
                                AND SD.IS_OFF   = 1
      JOIN HR_WEEK_DAYS WD      ON WD.DAY_ID   = SD.DAY_ID
) WO ON WO.EMPLOYEE_ID  = E.EMPLOYEE_ID
     AND WO.DAY_NAME_EN = TRIM(TO_CHAR(E.DAY_DATE, 'DAY'))

WHERE (
    $P{P_STATUS_ID} IS NULL
    OR CASE
           WHEN LV.EMPLOYEE_ID  IS NOT NULL THEN 4
           WHEN AB.EMPLOYEE_ID  IS NOT NULL THEN 3
           WHEN PH.HOLIDAY_DATE IS NOT NULL THEN 6
           WHEN CD.COMP_DATE    IS NOT NULL THEN 10
           WHEN WO.EMPLOYEE_ID  IS NOT NULL THEN 5
           ELSE                                  7
       END = $P{P_STATUS_ID}
)
ORDER BY E.DAY_DATE DESC, E.FULL_NAME_AR ASC]]>
	</queryString>
	<field name="EMPLOYEE_ID" class="java.math.BigDecimal"/>
	<field name="EMPLOYEE_CODE" class="java.lang.String"/>
	<field name="DEPARTMENT_ID" class="java.math.BigDecimal"/>
	<field name="ATTENDANCE_DATE" class="java.sql.Timestamp"/>
	<field name="DAY_NAME" class="java.lang.String"/>
	<field name="ATTENDANCE_STATUS" class="java.lang.String"/>
	<field name="STATUS_CLASS" class="java.lang.String"/>
	<field name="STATUS_ID" class="java.math.BigDecimal"/>
	<field name="EMPLOYEE_NAME" class="java.lang.String"/>
	<field name="DEPARTMENT_NAME" class="java.lang.String"/>
	<field name="SELECTED_EMPLOYEE_NAME" class="java.lang.String"/>
	<field name="SELECTED_DEPARTMENT_NAME" class="java.lang.String"/>
	<variable name="ROW_NUM" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{EMPLOYEE_ID}]]></variableExpression>
	</variable>
