	<field name="NOTES" class="java.lang.String"/>
	<field name="CREATED_BY" class="java.lang.String"/>
	<field name="CREATED_BY_USER_ID" class="java.math.BigDecimal"/>
	<field name="CREATED" class="java.sql.Timestamp"/>
	<field name="MODIFIED_BY" class="java.lang.String"/>
	<field name="MODIFIED_DATE" class="java.sql.Timestamp"/>
	<field name="CREATED_DATE" class="java.sql.Timestamp"/>
	<field name="SELECTED_EMPLOYEE_NAME" class="java.lang.String"/>
	<field name="SELECTED_DEPARTMENT_NAME" class="java.lang.String"/>
	<field name="SELECTED_LEAVE_TYPE_NAME" class="java.lang.String"/>
	<field name="SELECTED_STATUS_NAME" class="java.lang.String"/>
	<variable name="ROW_NUM" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{EMPLOYEE_CODE}]]></variableExpression>
	</variable>
