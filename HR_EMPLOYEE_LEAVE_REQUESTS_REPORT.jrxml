	<parameter name="P_LANG" class="java.lang.String">
		<defaultValueExpression><![CDATA["ar"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_USERPRINT" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="P_EMPLOYEE_ID" class="java.lang.String"/>
	<parameter name="P_DEPARTMENT_ID" class="java.lang.String"/>
	<parameter name="P_FROM_DATE" class="java.lang.String"/>
	<parameter name="P_TO_DATE" class="java.lang.String"/>
	<parameter name="P_LEAVE_TYPE_ID" class="java.lang.String"/>
	<parameter name="P_STATUS_ID" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    R.ID,
    R.LEAVE_REQUEST_NO,
    R.LEAVE_TYPE_ID,
    R.EMPLOYEE_ID,
    E.CODE AS EMPLOYEE_CODE,
    DECODE(LOWER($P{P_LANG}), 'ar', E.FULL_NAME_AR, E.FULL_NAME_EN) AS EMPLOYEE_NAME,
    DECODE(LOWER($P{P_LANG}), 'ar', D.ARABIC_NAME, D.NAME) AS DEPARTMENT_NAME,
    DECODE(LOWER($P{P_LANG}), 'ar', LT.ARABIC_NAME, LT.NAME) AS LEAVE_TYPE_NAME,
    R.REQUEST_DATE,
    R.START_DATE,
    R.END_DATE,
    R.RETURN_DATE,
    R.ACTUAL_RETURN_DATE,
    R.TOTAL_LEAVE_DAYS,
    R.WEEKEND_DAYS,
    R.OFFICIAL_HOLIDAYS,
    R.WORKING_DAYS,
    R.EMPLOYEE_BALANCE,
    R.BALANCE_BEFORE,
    R.BALANCE_AFTER,
    R.LAST_LEAVE_DATE,
    R.LAST_LEAVE_DURATION,
    R.SUBSTITUTE_EMP_ID,
    DECODE(LOWER($P{P_LANG}), 'ar', SUB.FULL_NAME_AR, SUB.FULL_NAME_EN) AS SUBSTITUTE_EMPLOYEE_NAME,
    R.RELATION_TYPE_ID,
    R.LEAVE_REASON,
    R.EMERGENCY_PHONE,
    RS.STATUS_NAME,
    RS.STATUS_BADGE,
    R.STATUS_ID,
    R.STAGE_ID,
    SG.STAGE_NAME,
    SG.STAGE_BADGE,
    R.NOTES,
    R.CREATED_BY,
    R.CREATED_BY_USER_ID,
    R.CREATED,
    R.MODIFIED_BY,
    R.MODIFIED_DATE,
    R.CREATED_DATE,
    (CASE WHEN $P{P_EMPLOYEE_ID} IS NOT NULL THEN (SELECT DECODE($P{P_LANG}, 'ar', E2.FULL_NAME_AR, E2.FULL_NAME_EN) FROM HR_EMPLOYEES E2 WHERE E2.EMPLOYEE_ID = TO_NUMBER($P{P_EMPLOYEE_ID})) ELSE NULL END) AS SELECTED_EMPLOYEE_NAME,
    (CASE WHEN ($P{P_DEPARTMENT_ID} IS NOT NULL AND $P{P_DEPARTMENT_ID} != '') THEN (SELECT DECODE($P{P_LANG}, 'ar', D2.ARABIC_NAME, D2.NAME) FROM HR_DEPARTMENT D2 WHERE D2.ID = TO_NUMBER($P{P_DEPARTMENT_ID})) ELSE NULL END) AS SELECTED_DEPARTMENT_NAME,
    (CASE WHEN ($P{P_LEAVE_TYPE_ID} IS NOT NULL AND $P{P_LEAVE_TYPE_ID} != '') THEN (SELECT LISTAGG(DECODE($P{P_LANG}, 'ar', LT2.ARABIC_NAME, LT2.NAME), ', ') WITHIN GROUP (ORDER BY LT2.ID) FROM HR_LEAVE_TYPES LT2 WHERE LT2.ID IN (SELECT TO_NUMBER(COLUMN_VALUE) FROM APEX_STRING.SPLIT($P{P_LEAVE_TYPE_ID}, ','))) ELSE NULL END) AS SELECTED_LEAVE_TYPE_NAME,
    (CASE WHEN $P{P_STATUS_ID} IS NOT NULL THEN (SELECT DECODE($P{P_LANG}, 'ar', NVL(RS2.ARABIC_NAME, RS2.NAME), RS2.NAME) FROM HR_LEAVE_STATUS RS2 WHERE RS2.ID = TO_NUMBER($P{P_STATUS_ID})) ELSE NULL END) AS SELECTED_STATUS_NAME
FROM HR_EMPLOYEE_LEAVE_REQUESTS R
LEFT JOIN HR_EMPLOYEES E ON R.EMPLOYEE_ID = E.EMPLOYEE_ID
LEFT JOIN HR_DEPARTMENT D ON E.DEPARTMENT_ID = D.ID
LEFT JOIN HR_EMPLOYEES SUB ON R.SUBSTITUTE_EMP_ID = SUB.EMPLOYEE_ID
LEFT JOIN HR_LEAVE_TYPES LT ON R.LEAVE_TYPE_ID = LT.ID
JOIN (
    SELECT RS.ID STATUS_ID,
           DECODE(LOWER($P{P_LANG}), 'ar', NVL(RS.ARABIC_NAME, RS.NAME), RS.NAME) AS STATUS_NAME,
           C.BADGE_CSS_CLASS AS STATUS_BADGE
      FROM HR_LEAVE_STATUS RS
      LEFT JOIN COLORS C ON RS.COLOR_ID = C.ID
) RS ON R.STATUS_ID = RS.STATUS_ID
LEFT JOIN (
    SELECT SG.ID STAGE_ID,
           DECODE(LOWER($P{P_LANG}), 'ar', NVL(SG.ARABIC_NAME, SG.NAME), SG.NAME) AS STAGE_NAME,
           'grayBadge' AS STAGE_BADGE
      FROM HR_LEAVE_TYPE_STAGES SG
) SG ON R.STAGE_ID = SG.STAGE_ID
WHERE ($P{P_COMP_ID} IS NULL OR E.COMPANY_ID = $P{P_COMP_ID})
  AND (R.EMPLOYEE_ID = TO_NUMBER($P{P_EMPLOYEE_ID}) OR $P{P_EMPLOYEE_ID} IS NULL OR $P{P_EMPLOYEE_ID} = '')
  AND ($P{P_DEPARTMENT_ID} IS NULL OR $P{P_DEPARTMENT_ID} = '' OR E.DEPARTMENT_ID IN (
      SELECT ID FROM HR_DEPARTMENT
       START WITH ID = TO_NUMBER($P{P_DEPARTMENT_ID})
      CONNECT BY PRIOR ID = PARENT_ID
  ))
  AND (
    $P{P_LEAVE_TYPE_ID} IS NULL OR $P{P_LEAVE_TYPE_ID} = ''
    OR R.LEAVE_TYPE_ID IN (
        SELECT TO_NUMBER(COLUMN_VALUE)
          FROM APEX_STRING.SPLIT($P{P_LEAVE_TYPE_ID}, ',')
    )
  )
  AND (R.STATUS_ID = TO_NUMBER($P{P_STATUS_ID}) OR $P{P_STATUS_ID} IS NULL OR $P{P_STATUS_ID} = '')
  AND ($P{P_FROM_DATE} IS NULL OR NVL(R.ACTUAL_RETURN_DATE - 1, R.END_DATE) >= TO_DATE($P{P_FROM_DATE}, 'DD-MM-YYYY'))
  AND ($P{P_TO_DATE} IS NULL OR NVL(R.ACTUAL_RETURN_DATE - 1, R.END_DATE) <= TO_DATE($P{P_TO_DATE}, 'DD-MM-YYYY'))
ORDER BY R.START_DATE DESC, E.CODE ASC]]>
	</queryString>
