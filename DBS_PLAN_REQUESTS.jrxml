	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_ID" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT ID,
       COMP_ID,
       BRANCH_ID,
       AUTO_NUMBER,
       AUTO_NUMBER_BRA,
       DBS_SAL_CUSTOMERS_LANG_NAME(DBS_SAL_CUSTOMERS_ID, $P{P_LANG}) AS CUST_NAME,
       DBS_SAL_CUSTOMER_PHONE(DBS_SAL_CUSTOMERS_ID) AS CUST_PHONE,
       DBS_SAL_SALES_MAN_LANG_NAME(DBS_SAL_SALES_ID, $P{P_LANG}) AS SALES_NAME,
       DBS_SAL_SALES_MAN_PHONE(DBS_SAL_SALES_ID) AS SALES_PHONE,
       DBS_STOCK_STORE_LANG_NAME(DBS_STOCK_STORE_ID, $P{P_LANG}) AS STORE_NAME,
       DBS_STOCK_STORE_DTL_LANG_NAME(DBS_STOCK_SUB_STORE_ID, $P{P_LANG}) AS SUB_STORE_NAME,
       DBS_PAYMENT_TYPE_LANG_NAME(PAYMENT_TYPE, $P{P_LANG}) AS PAYMENT_TYPE,
       TO_CHAR(INV_DATE, 'YYYY-MM-DD') AS INV_DATE, 
       CHECK_TAX,
       INV_NUMBER_TAX,
       BANK_ID,
       NVL(AMOUNT_PAID, 0) AS AMOUNT_PAID,
       NVL(AMOUNT_DUE, 0) AS AMOUNT_DUE,
       NVL(TOTAL_VALUE, 0) AS TOTAL_VALUE,
       NVL(DISCOUNT_VALUE, 0) AS DISCOUNT_VALUE,
       NVL(TOTAL_NET_AF_DISCOUNT, 0) AS TOTAL_NET_AF_DISCOUNT,
       NVL(TAX_VALUE, 0) AS TAX_VALUE,
       NVL(TOTAL_NET_AF_TAX, 0) AS TOTAL_NET_AF_TAX,
       NVL(DELIVERY_VALUE, 0) AS DELIVERY_VALUE,
       DBS_PLAN_REQUESTS_DTL_FINAL_VALUE(ID) AS FINAL_VALUE,
       NOTES,
       STATUS,
       CREATED,
       CREATED_BY,
       UPDATED,
       UPDATED_BY,
       GET_DBS_COMP_NAME_BY_ID($P{P_COMP_ID}) AS FOOT
FROM "DBS_PLAN_REQUESTS" a
WHERE ID = $P{P_ID}]]>
	</queryString>
