					<font fontName="IBM Plex Sans Arabic" size="10"/>
				</textElement>
				<text><![CDATA[عميلنا العزيز طريقة سداد الفاتورة كاش]]></text>
			</staticText>
			<staticText>
				<reportElement x="279" y="80" width="275" height="18" uuid="cb761070-e089-4c07-8ef5-5fbd2bbc4f49"/>
				<box rightPadding="10"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="IBM Plex Sans Arabic" size="10"/>
				</textElement>
				<text><![CDATA[*برجاء مراجعة الفاتورة و التأكيد لتحديد موعد الاستلام *]]></text>
			</staticText>
			<staticText>
				<reportElement x="290" y="100" width="264" height="18" uuid="e25be788-194a-4aac-8e85-d8898b5985d3"/>
