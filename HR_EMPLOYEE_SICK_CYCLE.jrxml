	<parameter name="P_LANG" class="java.lang.String">
		<defaultValueExpression><![CDATA["ar"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_USERPRINT" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="P_EMPLOYEE_ID" class="java.lang.String"/>
	<parameter name="P_DEPARTMENT_ID" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    SC.ID,
    SC.COMPANY_ID,
    SC.BRANCH_ID,
    SC.EMPLOYEE_ID,
    E.CODE AS EMPLOYEE_CODE,
    DECODE($P{P_LANG}, 'ar', E.FULL_NAME_AR, E.FULL_NAME_EN) AS EMPLOYEE_NAME,
    SC.CYCLE_START_DATE,
    SC.CYCLE_END_DATE,
    SC.PREVIOUS_SICK_DAYS,
    SC.NOTES,
    SC.STATUS,
    SC.CREATED_BY_USER_ID,
    SC.CREATED_BY,
    SC.CREATED_DATE,
    SC.UPDATED_BY_USER_ID,
    SC.UPDATED_BY,
    SC.UPDATED_DATE,

    MAX(CASE WHEN C.SALARY_PERCENT = 100 THEN D.USED_DAYS END) AS FULL_PAY_USED,
    MAX(CASE WHEN C.SALARY_PERCENT = 100 THEN D.REMAINING_DAYS END) AS FULL_PAY_REMAINING,

    MAX(CASE WHEN C.SALARY_PERCENT = 75 THEN D.USED_DAYS END) AS PAY_75_USED,
    MAX(CASE WHEN C.SALARY_PERCENT = 75 THEN D.REMAINING_DAYS END) AS PAY_75_REMAINING,

    MAX(CASE WHEN C.SALARY_PERCENT = 50 THEN D.USED_DAYS END) AS PAY_50_USED,
    MAX(CASE WHEN C.SALARY_PERCENT = 50 THEN D.REMAINING_DAYS END) AS PAY_50_REMAINING,

    MAX(CASE WHEN C.SALARY_PERCENT = 0 THEN D.USED_DAYS END) AS NO_PAY_USED,
    MAX(CASE WHEN C.SALARY_PERCENT = 0 THEN D.REMAINING_DAYS END) AS NO_PAY_REMAINING,

    SUM(NVL(D.USED_DAYS, 0)) AS TOTAL_USED,
    SUM(NVL(D.REMAINING_DAYS, 0)) AS TOTAL_REMAINING

FROM HR_EMPLOYEE_SICK_CYCLES SC
JOIN HR_EMPLOYEES E ON SC.EMPLOYEE_ID = E.EMPLOYEE_ID
LEFT JOIN HR_EMPLOYEE_SICK_CYCLE_DETAILS D 
    ON D.CYCLE_ID = SC.ID
LEFT JOIN HR_SICK_CYCLE_CONFIG C 
    ON D.CONFIG_ID = C.ID
WHERE ($P{P_COMP_ID} IS NULL OR SC.COMPANY_ID = $P{P_COMP_ID})
  AND ($P{P_EMPLOYEE_ID} IS NULL OR SC.EMPLOYEE_ID = $P{P_EMPLOYEE_ID})
  AND (
      $P{P_DEPARTMENT_ID} IS NULL
      OR E.DEPARTMENT_ID IN (
          SELECT ID FROM HR_DEPARTMENT
           START WITH ID      = $P{P_DEPARTMENT_ID}
          CONNECT BY PRIOR ID = PARENT_ID
      )
  )
GROUP BY
    SC.ID,
    SC.COMPANY_ID,
    SC.BRANCH_ID,
    SC.EMPLOYEE_ID,
    E.CODE,
    E.FULL_NAME_AR,
    E.FULL_NAME_EN,
    SC.CYCLE_START_DATE,
    SC.CYCLE_END_DATE,
    SC.PREVIOUS_SICK_DAYS,
    SC.NOTES,
    SC.STATUS,
    SC.CREATED_BY_USER_ID,
    SC.CREATED_BY,
    SC.CREATED_DATE,
    SC.UPDATED_BY_USER_ID,
    SC.UPDATED_BY,
    SC.UPDATED_DATE
ORDER BY E.CODE ASC]]>
	</queryString>
