	<style name="Col  Header Value" mode="Opaque" forecolor="#030303" backcolor="#D4D0CF"/>
	<parameter name="P_LANG" class="java.lang.String"/>
	<parameter name="P_ID" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT ROW_NUMBER() OVER (ORDER BY ID) AS SERIAL_NO,
(select ITEM_CODE from DBS_STOCK_ITEMS X where X.ID = DBS_STOCK_ITEMS_ID ) as CODE,
       nvl(DBS_STOCK_ITEMS_TYPE(DBS_STOCK_ITEMS_ID),' - ')as ITEM_TYPE,
       DBS_STOCK_ITEMS_LANG_NAME(DBS_STOCK_ITEMS_ID, $P{P_LANG}
       ) AS ITEM_NAME,
       QTY_PLAN,
    NVL(PRICE, 0) AS PRICE,
    NVL(QTY_PLAN*PRICE, 0) AS TOTAL_VALUE
FROM "DBS_PLAN_REQUESTS_DTL" a
where DBS_PLAN_REQUESTS_ID = $P{P_ID}
AND QTY_PLAN  > 0]]>
	</queryString>
