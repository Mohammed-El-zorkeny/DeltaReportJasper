	<field name="DEPARTMENT_NAME" class="java.lang.String"/>
	<field name="SELECTED_EMPLOYEE_NAME" class="java.lang.String"/>
	<field name="SELECTED_DEPARTMENT_NAME" class="java.lang.String"/>
	<variable name="ROW_NUM" class="java.lang.Integer" resetType="Group" resetGroup="DepartmentGroup" calculation="Count">
		<variableExpression><![CDATA[$F{EMPLOYEE_ID}]]></variableExpression>
	</variable>
