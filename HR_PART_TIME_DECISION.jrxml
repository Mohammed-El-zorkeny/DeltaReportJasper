	<detail>
		<band height="550" splitType="Stretch">
			<!-- Title Banner -->
			<staticText>
				<reportElement style="TitleStyle" x="127" y="15" width="300" height="40" uuid="d1111111-0001-0001-0001-000000000001"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="IBM Plex Sans Arabic" size="16" isBold="true"/>
				</textElement>
				<text><![CDATA[السيد / مدير إدارة المواظبة]]></text>
			</staticText>

			<!-- Decision Main Text Box (Dynamic entitlement fraction: ربع / نصف) -->
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement style="DecisionTextStyle" positionType="Float" x="0" y="75" width="555" height="160" uuid="d1111111-0001-0001-0001-000000000005">
					<property name="net.sf.jasperreports.style.markup" value="html"/>
				</reportElement>
				<textElement textAlignment="Right" verticalAlignment="Top" markup="html">
					<font fontName="IBM Plex Sans Arabic" size="15"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["اعتباراً من <b>" + ($F{START_DATE_STR} != null ? $F{START_DATE_STR} : "--------") + "</b> يعمل السيد / السيدة <b>" + ($F{EMPLOYEE_NAME} != null ? $F{EMPLOYEE_NAME} : "------------") + "</b> رقم <b>" + ($F{EMPLOYEE_CODE} != null ? $F{EMPLOYEE_CODE} : "-----") + "</b> بإدارة <b>" + ($F{DEPARTMENT_NAME} != null ? $F{DEPARTMENT_NAME} : "-------") + "</b> بنظام <b>" + ($F{REQUEST_TYPE_NAME} != null ? $F{REQUEST_TYPE_NAME} : "-------") + "</b> ينتهي في <b>" + ($F{END_DATE_STR} != null ? $F{END_DATE_STR} : "---------") + "</b>.<br/><br/>على أن يُخصم منه / منها <b>" + (($F{REQUEST_TYPE_NAME} != null && ($F{REQUEST_TYPE_NAME}.contains("ربع") || $F{REQUEST_TYPE_NAME}.toLowerCase().contains("quarter"))) ? "ربع" : "نصف") + "</b> المستحقات المالية وكذلك الإجازات السنوية."]]></textFieldExpression>
			</textField>

			<!-- Details Table: Work / Off Days Schedule (Hidden when Quarter Time / ربع الوقت) -->
			<frame>
				<reportElement positionType="Float" x="0" y="250" width="555" height="90" isRemoveLineWhenBlank="true" uuid="d1111111-0001-0001-0001-000000000006">
					<printWhenExpression><![CDATA[Boolean.valueOf($F{REQUEST_TYPE_NAME} == null || (!$F{REQUEST_TYPE_NAME}.contains("ربع") && !$F{REQUEST_TYPE_NAME}.toLowerCase().contains("quarter")))]]></printWhenExpression>
				</reportElement>
				<staticText>
					<reportElement positionType="Float" x="380" y="5" width="175" height="22" forecolor="#1F4E79" uuid="d1111111-0001-0001-0001-000000000007"/>
					<textElement textAlignment="Right" verticalAlignment="Middle">
						<font fontName="IBM Plex Sans Arabic" size="12" isBold="true"/>
					</textElement>
					<text><![CDATA[تفاصيل أيام العمل والإجازات:]]></text>
				</staticText>

				<staticText>
					<reportElement style="HeaderStyle" positionType="Float" x="277" y="32" width="278" height="28" uuid="d1111111-0001-0001-0001-000000000008"/>
					<text><![CDATA[الأسبوع الأول]]></text>
				</staticText>
				<staticText>
					<reportElement style="HeaderStyle" positionType="Float" x="0" y="32" width="277" height="28" uuid="d1111111-0001-0001-0001-000000000009"/>
