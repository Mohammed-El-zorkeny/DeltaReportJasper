					<textFieldExpression><![CDATA["أيام العمل: " + ($F{WEEK1_WORK_DAYS} != null ? $F{WEEK1_WORK_DAYS} : 0)]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement style="RowStyle" positionType="Float" x="277" y="60" width="139" height="28" uuid="d1111111-0001-0001-0001-000000000011"/>
