	<parameter name="P_REQUEST_ID" class="java.lang.String"/>
	<parameter name="P_LANG" class="java.lang.String">
		<defaultValueExpression><![CDATA["ar"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_USERPRINT" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>

	<queryString>
		<![CDATA[SELECT 
    A.ID AS REQUEST_ID,
    A.COMPANY_ID,
    A.BRANCH_ID,
    A.EMPLOYEE_ID,
    E.CODE AS EMPLOYEE_CODE,
    DECODE(LOWER($P{P_LANG}), 'ar', NVL(E.FULL_NAME_AR, E.FULL_NAME_EN), NVL(E.FULL_NAME_EN, E.FULL_NAME_AR)) AS EMPLOYEE_NAME,
    DECODE(LOWER($P{P_LANG}), 'ar', NVL(D.ARABIC_NAME, D.NAME), NVL(D.NAME, D.ARABIC_NAME)) AS DEPARTMENT_NAME,
    A.REQUEST_TYPE_ID,
    DECODE(LOWER($P{P_LANG}), 'ar', NVL(WTT.ARABIC_NAME, WTT.NAME), NVL(WTT.NAME, WTT.ARABIC_NAME)) AS REQUEST_TYPE_NAME,
    TO_CHAR(A.START_DATE, 'YYYY/MM/DD') AS START_DATE_STR,
    TO_CHAR(A.END_DATE, 'YYYY/MM/DD') AS END_DATE_STR,
    A.START_DATE,
    A.END_DATE,
    A.STATUS_ID,
    NVL(A.WEEK1_WORK_DAYS, 0) AS WEEK1_WORK_DAYS,
    NVL(A.WEEK1_OFF_DAYS, 0) AS WEEK1_OFF_DAYS,
    NVL(A.WEEK2_WORK_DAYS, 0) AS WEEK2_WORK_DAYS,
    NVL(A.WEEK2_OFF_DAYS, 0) AS WEEK2_OFF_DAYS,
    A.NOTES,
    A.CREATED_BY,
    A.CREATED_DATE,
    A.DURATION_DAYS,
    A.IS_RENEWAL,
    TO_CHAR(A.ACTUAL_END_DATE, 'YYYY/MM/DD') AS ACTUAL_END_DATE_STR,
    A.INTERRUPT_REASON
FROM HR_PART_TIME_REQUESTS A
LEFT JOIN HR_EMPLOYEES E ON A.EMPLOYEE_ID = E.EMPLOYEE_ID
LEFT JOIN HR_DEPARTMENT D ON E.DEPARTMENT_ID = D.ID
LEFT JOIN HR_WORK_TIME_TYPES WTT ON A.REQUEST_TYPE_ID = WTT.ID
WHERE A.ID = TO_NUMBER($P{P_REQUEST_ID})]]>
	</queryString>

	<field name="REQUEST_ID" class="java.math.BigDecimal"/>
	<field name="COMPANY_ID" class="java.math.BigDecimal"/>
	<field name="BRANCH_ID" class="java.math.BigDecimal"/>
