	<field name="DURATION_DAYS" class="java.math.BigDecimal"/>
	<field name="IS_RENEWAL" class="java.math.BigDecimal"/>
	<field name="ACTUAL_END_DATE_STR" class="java.lang.String"/>
	<field name="INTERRUPT_REASON" class="java.lang.String"/>

