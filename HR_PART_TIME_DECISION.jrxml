				</textField>

				<textField isBlankWhenNull="true">
					<reportElement style="RowStyle" positionType="Float" x="138" y="60" width="139" height="28" uuid="d1111111-0001-0001-0001-000000000012"/>
					<textFieldExpression><![CDATA["أيام العمل: " + ($F{WEEK2_WORK_DAYS} != null ? $F{WEEK2_WORK_DAYS} : 0)]]></textFieldExpression>
