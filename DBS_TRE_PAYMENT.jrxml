	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_USERNAME" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
    a.ID,
    a.COMP_ID,
    a.BRANCH_ID,
    a.AUTO_NUMBER,
    a.AUTO_NUMBER_BRA,
    a.TRANS_TYPE,
    DBS_TRE_DOCUMENT_TYPES_LANG_NAME(a.TRANS_TYPE, $P{P_LANG}) AS TRANS_TYPE_NAME,
        DBS_TRE_DOCUMENT_TYPES_LANG_NAME(a.TRANS_TYPE, 'ar') AS TRANS_TYPE_NAME_AR,
            DBS_TRE_DOCUMENT_TYPES_LANG_NAME(a.TRANS_TYPE, 'en') AS TRANS_TYPE_NAME_EN,
    TO_CHAR(a.TRANS_DATE, 'YYYY-MM-DD') AS TRANS_DATE,
    DBS_ACC_PERIOD_NAME_LANG(a.DBS_ACC_PERIODS_ID, $P{P_LANG}) AS PERIOD_NAME,
    DBS_TRE_BANKS_LANG_NAME(a.DBS_TRE_BANKS_ID, $P{P_LANG}) AS BANKS_NAME,
    a.STATUS,
    a.NOTES,
    (SELECT NVL(SUM(VALUE), 0) 
     FROM DBS_TRE_PAYMENT_DTL 
     WHERE DBS_TRE_PAYMENT_ID = a.ID) AS TOTAL
FROM DBS_TRE_PAYMENT a
WHERE a.ID = $P{P_ID}]]>
	</queryString>
