	<parameter name="P_LANG" class="java.lang.String">
		<defaultValueExpression><![CDATA["ar"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_BRANCH_ID" class="java.lang.String"/>
	<parameter name="P_USERPRINT" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[WITH V_DEPT_HIERARCHY AS (
    SELECT 
        D.ID,
        D.PARENT_ID,
        D.DEPARTMENT_CATGOERY_ID,
        D.NAME AS DEPT_NAME_EN,
        D.ARABIC_NAME AS DEPT_NAME_AR,
        D.COMPANY_ID,
        D.BRANCH_ID
    FROM HR_DEPARTMENT D
    WHERE D.STATUS = '1'
),
V_DEPT_PAIRS AS (
    SELECT 
        CONNECT_BY_ROOT(ID) AS ANCESTOR_ID,
        ID AS DESCENDANT_ID
    FROM HR_DEPARTMENT
    WHERE STATUS = '1'
    CONNECT BY PRIOR ID = PARENT_ID
),
V_DEPT_COUNTS AS (
    SELECT DEPARTMENT_ID, COUNT(*) AS EMP_COUNT
    FROM HR_EMPLOYEES
    GROUP BY DEPARTMENT_ID
),
V_CUMULATIVE_COUNTS AS (
    SELECT 
        P.ANCESTOR_ID AS DEPARTMENT_ID,
        SUM(NVL(C.EMP_COUNT, 0)) AS TOTAL_EMP_COUNT
    FROM V_DEPT_PAIRS P
    LEFT JOIN V_DEPT_COUNTS C ON C.DEPARTMENT_ID = P.DESCENDANT_ID
    GROUP BY P.ANCESTOR_ID
),
V_CAT_DEPT_PAIRS AS (
    SELECT DISTINCT
        CONNECT_BY_ROOT(H.DEPARTMENT_CATGOERY_ID) AS CAT_ID,
        H.ID AS DEPT_ID
    FROM V_DEPT_HIERARCHY H
    START WITH H.DEPARTMENT_CATGOERY_ID IS NOT NULL
    CONNECT BY PRIOR H.ID = H.PARENT_ID
),
V_CAT_EMP AS (
    SELECT DISTINCT
        P.CAT_ID,
        E.EMPLOYEE_ID
    FROM V_CAT_DEPT_PAIRS P
    JOIN HR_EMPLOYEES E ON E.DEPARTMENT_ID = P.DEPT_ID
    WHERE ($P{P_COMP_ID} IS NULL OR E.COMPANY_ID = $P{P_COMP_ID})
      AND ($P{P_BRANCH_ID} IS NULL OR E.BRANCH_ID = $P{P_BRANCH_ID})
),
V_CAT_COUNTS AS (
    SELECT 
        CAT_ID, 
        COUNT(*) AS TOTAL_EMP_COUNT
    FROM V_CAT_EMP
    GROUP BY CAT_ID
),
V_CATEGORIES AS (
    SELECT 'العمالة الإدارية' AS CAT_NAME_AR, 'Administrative Staff' AS CAT_NAME_EN, 1 AS CAT_ID FROM dual
    UNION ALL
    SELECT 'العمالة الفنية' AS CAT_NAME_AR, 'Technical Staff' AS CAT_NAME_EN, 2 AS CAT_ID FROM dual
    UNION ALL
    SELECT 'العمالة التسويقية' AS CAT_NAME_AR, 'Marketing Staff' AS CAT_NAME_EN, 3 AS CAT_ID FROM dual
    UNION ALL
    SELECT 'العمالة الإنتاجية' AS CAT_NAME_AR, 'Production Staff' AS CAT_NAME_EN, 4 AS CAT_ID FROM dual
    UNION ALL
    SELECT 'عمالة أخرى' AS CAT_NAME_AR, 'Other Staff' AS CAT_NAME_EN, 5 AS CAT_ID FROM dual
)
SELECT 
    C.CAT_ID,
    DECODE($P{P_LANG}, 'ar', C.CAT_NAME_AR, C.CAT_NAME_EN) AS CAT_NAME,
    P.DEPT_ID,
    DECODE($P{P_LANG}, 'ar', D.DEPT_NAME_AR, D.DEPT_NAME_EN) AS DEPT_NAME,
    NVL(CC.TOTAL_EMP_COUNT, 0) AS DEPT_EMP_COUNT,
    NVL(CCC.TOTAL_EMP_COUNT, 0) AS CAT_TOTAL_EMP_COUNT
FROM V_CATEGORIES C
JOIN V_CAT_DEPT_PAIRS P ON P.CAT_ID = C.CAT_ID
JOIN V_DEPT_HIERARCHY D ON D.ID = P.DEPT_ID
LEFT JOIN V_CUMULATIVE_COUNTS CC ON CC.DEPARTMENT_ID = P.DEPT_ID
LEFT JOIN V_CAT_COUNTS CCC ON CCC.CAT_ID = C.CAT_ID
WHERE ($P{P_COMP_ID} IS NULL OR D.COMPANY_ID = $P{P_COMP_ID})
  AND ($P{P_BRANCH_ID} IS NULL OR D.BRANCH_ID = $P{P_BRANCH_ID})
ORDER BY C.CAT_ID ASC, DEPT_EMP_COUNT DESC, D.ID ASC]]>
	</queryString>
	<field name="CAT_ID" class="java.math.BigDecimal"/>
	<field name="CAT_NAME" class="java.lang.String"/>
	<field name="DEPT_ID" class="java.math.BigDecimal"/>
	<field name="DEPT_NAME" class="java.lang.String"/>
	<field name="DEPT_EMP_COUNT" class="java.math.BigDecimal"/>
	<field name="CAT_TOTAL_EMP_COUNT" class="java.math.BigDecimal"/>
	<variable name="VAL_GRAND_TOTAL_EMP" class="java.math.BigDecimal" resetType="Report" incrementType="Group" incrementGroup="CategoryGroup" calculation="Sum">
		<variableExpression><![CDATA[$F{CAT_TOTAL_EMP_COUNT}]]></variableExpression>
	</variable>
