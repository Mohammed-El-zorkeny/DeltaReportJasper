	<field name="EMPLOYEE_ID" class="java.math.BigDecimal"/>
	<field name="EMPLOYEE_NAME" class="java.lang.String"/>
	<field name="DEPARTMENT_NAME" class="java.lang.String"/>
	<field name="ATTENDANCE_DATE" class="java.sql.Timestamp"/>
	<field name="OVERTIME_DAYS_CALCULATED" class="java.math.BigDecimal"/>
	<field name="MEAL_ALLOWANCE_DAYS" class="java.math.BigDecimal"/>
	<field name="SELECTED_EMPLOYEE_NAME" class="java.lang.String"/>
	<field name="SELECTED_DEPARTMENT_NAME" class="java.lang.String"/>
