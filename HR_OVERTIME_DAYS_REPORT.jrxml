								<textElement textAlignment="Center" verticalAlignment="Middle">
									<font fontName="IBM Plex Sans Arabic" size="7" isBold="true"/>
								</textElement>
								<textFieldExpression><![CDATA["ar".equals($P{P_LANG}) ? "ب.ج" : "Meal Allow."]]></textFieldExpression>
							</textField>
							<textField>
								<reportElement x="40" y="0" width="45" height="25" forecolor="#FFFFFF" uuid="cc33dd44-0005-0003-0001-000000000007"/>
								<textElement textAlignment="Center" verticalAlignment="Middle">
									<font fontName="IBM Plex Sans Arabic" size="7" isBold="true"/>
								</textElement>
								<textFieldExpression><![CDATA["ar".equals($P{P_LANG}) ? "ج.م" : "Gross"]]></textFieldExpression>
