	<field name="OVERTIME_DAYS_NET" class="java.math.BigDecimal"/>
	<field name="OT_DAYS_250_NET" class="java.math.BigDecimal"/>
	<field name="OT_DAYS_400_NET" class="java.math.BigDecimal"/>
	<field name="MEAL_ALLOWANCE_DAYS" class="java.math.BigDecimal"/>
	<field name="IS_CTO_START" class="java.math.BigDecimal"/>
	<field name="IS_CTO_COMPLETED" class="java.math.BigDecimal"/>
	<field name="SELECTED_EMPLOYEE_NAME" class="java.lang.String"/>
