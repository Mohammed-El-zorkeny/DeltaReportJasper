<!-- Created with Jaspersoft Studio version 6.20.5.final using JasperReports Library version 6.20.5-3efcf2e67f959db3888d79f73dde2dbd7acb4f8e  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="HR_OVERTIME_DAYS_REPORT" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="15" bottomMargin="15" uuid="d1e2f3a4-b5c6-4d7e-8f90-1234567890ab">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Delta"/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageHeight" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="P_LANG" class="java.lang.String">
		<defaultValueExpression><![CDATA["ar"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_USERPRINT" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="P_EMPLOYEE_ID" class="java.lang.String"/>
	<parameter name="P_DEPARTMENT_ID" class="java.lang.String"/>
	<parameter name="P_SHIFT_ID" class="java.lang.String"/>
	<parameter name="P_SITE_ID" class="java.lang.String"/>
	<parameter name="P_FROM_DATE" class="java.lang.String"/>
	<parameter name="P_TO_DATE" class="java.lang.String"/>
	<queryString>
		<![CDATA[WITH V_PARAMS AS (
    SELECT 
        NVL(TO_DATE($P{P_FROM_DATE}, 'DD-MM-YYYY'), TRUNC(SYSDATE, 'MM')) AS START_DT,
        NVL(
            TO_DATE($P{P_TO_DATE}, 'DD-MM-YYYY'), 
            CASE WHEN $P{P_FROM_DATE} IS NOT NULL 
                 THEN LAST_DAY(TO_DATE($P{P_FROM_DATE}, 'DD-MM-YYYY'))
                 ELSE LAST_DAY(SYSDATE)
            END
        ) AS END_DT
    FROM DUAL
),
V_DATES AS (
    SELECT START_DT + LEVEL - 1 AS DT
    FROM V_PARAMS
    CONNECT BY LEVEL <= (END_DT - START_DT + 1)
),
V_EMPS AS (
    SELECT DISTINCT 
           A.EMPLOYEE_ID, 
           A.EMPLOYEE_CODE, 
           DECODE($P{P_LANG}, 'ar', E.FULL_NAME_AR, E.FULL_NAME_EN) AS EMPLOYEE_NAME,
           NVL(
               DECODE($P{P_LANG}, 'ar', D.ARABIC_NAME, D.NAME),
               CASE 
                   WHEN A.DEPARTMENT_ID IS NULL THEN DECODE($P{P_LANG}, 'ar', 'بدون قسم', 'No Department')
                   ELSE DECODE($P{P_LANG}, 'ar', 'قسم غير معروف (' || A.DEPARTMENT_ID || ')', 'Unknown Department (' || A.DEPARTMENT_ID || ')')
               END
           ) AS DEPARTMENT_NAME
    FROM VW_OVERTIME_LOG A
    LEFT JOIN HR_EMPLOYEES E ON E.EMPLOYEE_ID = A.EMPLOYEE_ID
    LEFT JOIN HR_DEPARTMENT D ON D.ID = A.DEPARTMENT_ID
    WHERE A.WORK_SHIFT_TYPE_ID = 2
      AND NVL(A.OVERTIME_HOURS_ACTUAL, 0) > 0
      AND ($P{P_EMPLOYEE_ID}          IS NULL OR A.EMPLOYEE_ID          = $P{P_EMPLOYEE_ID})
      AND (
          $P{P_DEPARTMENT_ID} IS NULL
          OR A.DEPARTMENT_ID IN (
              SELECT ID FROM HR_DEPARTMENT
               START WITH ID      = $P{P_DEPARTMENT_ID}
              CONNECT BY PRIOR ID = PARENT_ID
          )
      )
      AND ($P{P_SHIFT_ID}             IS NULL OR A.SHIFT_ID             = $P{P_SHIFT_ID})
      AND ($P{P_SITE_ID}              IS NULL OR A.SITES_ID             = $P{P_SITE_ID})
      AND ($P{P_FROM_DATE}            IS NULL OR A.ATTENDANCE_DATE >= TO_DATE($P{P_FROM_DATE}, 'DD-MM-YYYY'))
      AND ($P{P_TO_DATE}              IS NULL OR A.ATTENDANCE_DATE <= TO_DATE($P{P_TO_DATE},   'DD-MM-YYYY'))
),
CTO_RANKED AS (
    SELECT
        CTO.EMPLOYEE_ID,
        CTO.CTO_DATE,
        CTO.CTO_HOURS,
        ROW_NUMBER() OVER (
            PARTITION BY CTO.EMPLOYEE_ID,
                         CASE WHEN CTO.CTO_HOURS = 4 THEN '400' ELSE '250' END
            ORDER BY CTO.CTO_DATE
        ) AS RN
    FROM HR_CTO_TRANSACTIONS CTO
    WHERE CTO.STATUS = '1'
)
SELECT
    VE.EMPLOYEE_CODE,
    VE.EMPLOYEE_ID,
    VE.EMPLOYEE_NAME,
    VE.DEPARTMENT_NAME,
    VD.DT AS ATTENDANCE_DATE,
    NVL(A.OVERTIME_DAYS_CALCULATED, 0)                                 AS OVERTIME_DAYS_CALCULATED,
    
    -- ✅ أيام الإضافي الصافية
    CASE
        WHEN EXISTS (
            SELECT 1 FROM CTO_RANKED CR
             WHERE CR.EMPLOYEE_ID = VE.EMPLOYEE_ID
               AND CR.CTO_DATE    = VD.DT
               AND CR.CTO_HOURS   = 8
        )
        THEN 0
        WHEN EXISTS (
            SELECT 1 FROM CTO_RANKED CR
             WHERE CR.EMPLOYEE_ID = VE.EMPLOYEE_ID
               AND CR.CTO_DATE    = VD.DT
               AND CR.CTO_HOURS   = 4
               AND MOD(CR.RN, 2) IN (0, 1)
        )
        THEN 0
        ELSE NVL(A.OVERTIME_DAYS_CALCULATED, 0)
    END                                                                AS OVERTIME_DAYS_NET,

    -- ✅ أيام 250 الصافية
    CASE
        WHEN EXISTS (
            SELECT 1 FROM CTO_RANKED CR
             WHERE CR.EMPLOYEE_ID = VE.EMPLOYEE_ID
               AND CR.CTO_DATE    = VD.DT
               AND CR.CTO_HOURS   = 8
        )
        THEN 0
        ELSE NVL(A.OT_DAYS_250_CALCULATED, 0)
    END                                                                AS OT_DAYS_250_NET,

    -- ✅ أيام 400 الصافية
    CASE
        WHEN EXISTS (
            SELECT 1 FROM CTO_RANKED CR
             WHERE CR.EMPLOYEE_ID = VE.EMPLOYEE_ID
               AND CR.CTO_DATE    = VD.DT
               AND CR.CTO_HOURS   = 4
               AND MOD(CR.RN, 2) IN (0, 1)
        )
        THEN 0
        ELSE NVL(A.OT_DAYS_400_CALCULATED, 0)
    END                                                                AS OT_DAYS_400_NET,

    -- ✅ بدل الوجبة
    CASE
        WHEN EXISTS (
            SELECT 1 FROM CTO_RANKED CR
             WHERE CR.EMPLOYEE_ID = VE.EMPLOYEE_ID
               AND CR.CTO_DATE    = VD.DT
               AND CR.CTO_HOURS   = 4
               AND MOD(CR.RN, 2) IN (0, 1)
        )
        THEN 0
        WHEN CASE
                 WHEN EXISTS (
                     SELECT 1 FROM CTO_RANKED CR
                      WHERE CR.EMPLOYEE_ID = VE.EMPLOYEE_ID
                        AND CR.CTO_DATE    = VD.DT
                        AND CR.CTO_HOURS   = 8
                 )
                 THEN NVL(A.OT_DAYS_400_CALCULATED, 0)
                 ELSE NVL(A.OT_DAYS_400_CALCULATED, 0)
             END >= 1.6
        THEN 1
        ELSE 0
    END                                                                AS MEAL_ALLOWANCE_DAYS,

    -- ✅ CTO بداية
    CASE
        WHEN EXISTS (
            SELECT 1 FROM CTO_RANKED CR
             WHERE CR.EMPLOYEE_ID = VE.EMPLOYEE_ID
               AND CR.CTO_DATE    = VD.DT
               AND CR.CTO_HOURS   = 4
               AND MOD(CR.RN, 2)  = 1
        ) THEN 1
        ELSE 0
    END                                                                AS IS_CTO_START,

    -- ✅ CTO مكتمل
    CASE
        WHEN EXISTS (
            SELECT 1 FROM CTO_RANKED CR
             WHERE CR.EMPLOYEE_ID = VE.EMPLOYEE_ID
               AND CR.CTO_DATE    = VD.DT
               AND CR.CTO_HOURS   = 8
        ) THEN 1
        WHEN EXISTS (
            SELECT 1 FROM CTO_RANKED CR
             WHERE CR.EMPLOYEE_ID = VE.EMPLOYEE_ID
               AND CR.CTO_DATE    = VD.DT
               AND CR.CTO_HOURS   = 4
               AND MOD(CR.RN, 2)  = 0
        ) THEN 1
        ELSE 0
    END                                                                AS IS_CTO_COMPLETED,

    (SELECT DECODE($P{P_LANG}, 'ar', E2.FULL_NAME_AR, E2.FULL_NAME_EN) FROM HR_EMPLOYEES E2 WHERE E2.EMPLOYEE_ID = $P{P_EMPLOYEE_ID}) AS SELECTED_EMPLOYEE_NAME,
    (SELECT DECODE($P{P_LANG}, 'ar', D2.ARABIC_NAME, D2.NAME) FROM HR_DEPARTMENT D2 WHERE D2.ID = $P{P_DEPARTMENT_ID}) AS SELECTED_DEPARTMENT_NAME
FROM V_EMPS VE
CROSS JOIN V_DATES VD
LEFT JOIN VW_OVERTIME_LOG A ON A.EMPLOYEE_ID = VE.EMPLOYEE_ID 
                           AND A.ATTENDANCE_DATE = VD.DT
                           AND A.WORK_SHIFT_TYPE_ID = 2
                           AND NVL(A.OVERTIME_HOURS_ACTUAL, 0) > 0
ORDER BY VE.DEPARTMENT_NAME ASC, VE.EMPLOYEE_NAME ASC, VD.DT ASC]]>
	</queryString>
