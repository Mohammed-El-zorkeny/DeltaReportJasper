				<textFieldExpression><![CDATA["\u202B" + new java.text.SimpleDateFormat("EEEE  dd/MM/yyyy  -  hh:mm a", new java.util.Locale("ar")).format(new java.util.Date()) + "\u202C"]]></textFieldExpression>
			</textField>
