				</textElement>
				<textFieldExpression><![CDATA["\u202B" + ("ar".equals($P{P_LANG}) ? "مستخدم الطباعة : " + ($F{EMP_NAME_AR} == null ? "" : $F{EMP_NAME_AR}) + ($F{DEPT_NAME_AR} == null ? "" : "\n" + $F{DEPT_NAME_AR}) : "Printed By: " + ($F{EMP_NAME_EN} == null ? "" : $F{EMP_NAME_EN}) + ($F{DEPT_NAME_EN} == null ? "" : "\n" + $F{DEPT_NAME_EN})) + "\u202C"]]></textFieldExpression>
