					<font fontName="IBM Plex Sans Arabic" size="10" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["ar".equals($P{P_LANG}) ? "السجل الوظيفي والترقيات" : "Career & Grade History"]]></textFieldExpression>
			</textField>
			<!-- Table Headers -->
			<textField>
				<reportElement style="HeaderStyle" x="525" y="20" width="30" height="20" uuid="cc33dd44-0002-0001-0001-000000000001"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["ar".equals($P{P_LANG}) ? "م" : "Seq"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement style="HeaderStyle" x="375" y="20" width="150" height="20" uuid="cc33dd44-0002-0001-0001-000000000002"/>
				<box rightPadding="5" leftPadding="5"/>
