			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="RowStyle" x="95" y="0" width="100" height="18" uuid="cc33dd44-0003-0001-0001-000000000005"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{DECISION_NUMBER} != null ? $F{DECISION_NUMBER} : "-"]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="RowStyle" x="0" y="0" width="95" height="18" uuid="cc33dd44-0003-0001-0001-000000000006"/>
