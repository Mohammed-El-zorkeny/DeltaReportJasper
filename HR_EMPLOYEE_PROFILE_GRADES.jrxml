<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="HR_EMPLOYEE_PROFILE_GRADES" pageWidth="555" pageHeight="842" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="a7f64789-9012-4bae-8765-3456789012bb">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Delta"/>
	<style name="HeaderStyle" mode="Opaque" forecolor="#1F4E79" backcolor="#F2F4F7" fontName="IBM Plex Sans Arabic" fontSize="9" isBold="true">
		<box>
			<topPen lineWidth="0.5" lineColor="#BDC3C7"/>
			<bottomPen lineWidth="1.0" lineColor="#1F4E79"/>
		</box>
	</style>
	<style name="RowStyle" mode="Opaque" forecolor="#2C3E50" backcolor="#FFFFFF" fontName="IBM Plex Sans Arabic" fontSize="8">
		<box>
			<bottomPen lineWidth="0.5" lineColor="#BDC3C7"/>
		</box>
		<conditionalStyle>
			<conditionExpression><![CDATA[new Boolean($V{REPORT_COUNT}.intValue() % 2 == 0)]]></conditionExpression>
			<style backcolor="#F9FAFB"/>
		</conditionalStyle>
	</style>
	<parameter name="P_EMPLOYEE_ID" class="java.lang.String"/>
	<parameter name="P_LANG" class="java.lang.String">
		<defaultValueExpression><![CDATA["ar"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    GH.START_DATE, 
    GH.END_DATE, 
    DECODE(LOWER($P{P_LANG}), 'ar', G.ARABIC_NAME, G.NAME) AS GRADE_NAME, 
    GH.DECISION_NUMBER,
    GH.NOTES
FROM HR_EMPLOYEE_GRADE_HISTORY GH
JOIN HR_JOB_GRADES G ON GH.GRADE_ID = G.ID
WHERE GH.EMPLOYEE_ID = TO_NUMBER($P{P_EMPLOYEE_ID})
ORDER BY GH.START_DATE DESC]]>
	</queryString>
	<field name="START_DATE" class="java.sql.Timestamp"/>
	<field name="END_DATE" class="java.sql.Timestamp"/>
	<field name="GRADE_NAME" class="java.lang.String"/>
	<field name="DECISION_NUMBER" class="java.lang.String"/>
	<field name="NOTES" class="java.lang.String"/>
	<variable name="ROW_NUM" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{GRADE_NAME}]]></variableExpression>
	</variable>
	<columnHeader>
		<band height="40" splitType="Stretch">
			<!-- Section Title -->
			<textField>
				<reportElement x="0" y="0" width="555" height="20" forecolor="#1F4E79" uuid="cc33dd44-0001-0001-0001-000000000001"/>
