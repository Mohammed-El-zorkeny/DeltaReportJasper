				<reportElement style="HeaderStyle" x="195" y="20" width="90" height="20" uuid="cc33dd44-0002-0001-0001-000000000004"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["ar".equals($P{P_LANG}) ? "تاريخ الانتهاء" : "End Date"]]></textFieldExpression>
