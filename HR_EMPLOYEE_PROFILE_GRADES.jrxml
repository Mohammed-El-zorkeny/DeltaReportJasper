				<reportElement style="RowStyle" x="285" y="0" width="90" height="18" uuid="cc33dd44-0003-0001-0001-000000000003"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{START_DATE} != null ? new java.text.SimpleDateFormat("dd-MM-yyyy").format($F{START_DATE}) : "-"]]></textFieldExpression>
			</textField>
