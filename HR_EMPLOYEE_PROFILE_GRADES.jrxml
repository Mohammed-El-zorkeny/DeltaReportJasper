			</textField>
		</band>
	</columnHeader>
	<detail>
		<band height="18" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement style="RowStyle" x="525" y="0" width="30" height="18" uuid="cc33dd44-0003-0001-0001-000000000001"/>
