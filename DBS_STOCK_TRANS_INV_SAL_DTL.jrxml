	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ERP_STOCK"/>
	<style name="Col  Header" mode="Opaque" forecolor="#030303" backcolor="#DB9593"/>
	<style name="Text" mode="Transparent" forecolor="#E60F0B"/>
	<style name="Col  Header Value" mode="Opaque" forecolor="#030303" backcolor="#D4D0CF"/>
	<parameter name="P_LANG" class="java.lang.String"/>
	<parameter name="P_ID" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select         ROW_NUMBER() OVER (ORDER BY ID) AS SERIAL_NO,
ID,
       DBS_STOCK_TRANS_ID,
      (select ITEM_CODE from   DBS_STOCK_ITEMS where DBS_STOCK_ITEMS_ID =   ID  ) as CODE,
          DBS_STOCK_ITEMS_LANG_NAME(DBS_STOCK_ITEMS_ID, $P{P_LANG} ) AS ITEM_NAME,
       QTY,
    UPPER( DBS_STOCK_STORE_DTL_LOC_NAME(DBS_STOCK_STORE_DTL_LOC_ID)) as LOC_NAME,
       DBS_STOCK_ITEMS_ID as ITEM_CODE,
       nvl(DBS_STOCK_ITEMS_TYPE(DBS_STOCK_ITEMS_ID) ,' -  ') as ITEM_TYPE

  from DBS_STOCK_TRANS_DTL
   where $P{P_ID} = DBS_STOCK_TRANS_ID
   order by UPPER(DBS_STOCK_STORE_DTL_LOC_NAME(DBS_STOCK_STORE_DTL_LOC_ID) )]]>
	</queryString>
