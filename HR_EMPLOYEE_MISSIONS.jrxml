	<field name="DATA_ENTRY_USER" class="java.lang.String"/>
	<field name="REQUEST_DATE" class="java.sql.Timestamp"/>
	<field name="DESTINATION" class="java.lang.String"/>
	<field name="TOTAL_ALLOWANCE" class="java.math.BigDecimal"/>
	<field name="SELECTED_EMPLOYEE_NAME" class="java.lang.String"/>
	<field name="SELECTED_DEPARTMENT_NAME" class="java.lang.String"/>
	<variable name="ROW_NUM" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{ID}]]></variableExpression>
	</variable>
	<variable name="VAL_TOTAL_DAYS" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTAL_MISSION_DAY}]]></variableExpression>
	</variable>
