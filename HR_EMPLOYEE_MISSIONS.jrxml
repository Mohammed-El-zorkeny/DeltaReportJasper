	<parameter name="P_LANG" class="java.lang.String">
		<defaultValueExpression><![CDATA["ar"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_BRANCH_ID" class="java.lang.String"/>
	<parameter name="P_USERPRINT" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="P_EMPLOYEE_ID" class="java.lang.String"/>
	<parameter name="P_DEPARTMENT_ID" class="java.lang.String"/>
	<parameter name="P_FROM_DATE" class="java.lang.String"/>
	<parameter name="P_TO_DATE" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    M.ID,
    M.CODE AS MISSION_CODE,
    M.EMPLOYEE_ID,
    E.CODE AS EMPLOYEE_CODE,
    DECODE($P{P_LANG}, 'ar', E.FULL_NAME_AR, E.FULL_NAME_EN) AS EMPLOYEE_NAME,
    M.START_DATE,
    M.END_DATE,
    M.TOTAL_MISSION_DAY,
    DECODE($P{P_LANG}, 'ar', T.ARABIC_NAME, T.NAME) AS MISSION_TYPE,
    M.MISSION_PURPOSE,
    DECODE($P{P_LANG}, 'ar', E_CREATOR.FULL_NAME_AR, E_CREATOR.FULL_NAME_EN) AS DATA_ENTRY_USER,
    M.REQUEST_DATE,
    M.DESTINATION,
    M.TOTAL_ALLOWANCE,
    (CASE WHEN $P{P_EMPLOYEE_ID} IS NOT NULL THEN (SELECT DECODE($P{P_LANG}, 'ar', E2.FULL_NAME_AR, E2.FULL_NAME_EN) FROM HR_EMPLOYEES E2 WHERE E2.EMPLOYEE_ID = TO_NUMBER($P{P_EMPLOYEE_ID})) ELSE NULL END) AS SELECTED_EMPLOYEE_NAME,
    (CASE WHEN $P{P_DEPARTMENT_ID} IS NOT NULL THEN (SELECT DECODE($P{P_LANG}, 'ar', D2.ARABIC_NAME, D2.NAME) FROM HR_DEPARTMENT D2 WHERE D2.ID = TO_NUMBER($P{P_DEPARTMENT_ID})) ELSE NULL END) AS SELECTED_DEPARTMENT_NAME
FROM HR_EMPLOYEE_MISSIONS M
LEFT JOIN HR_EMPLOYEES E ON E.EMPLOYEE_ID = M.EMPLOYEE_ID
LEFT JOIN HR_MISSION_TYPES T ON T.ID = M.MISSION_TYPE_ID
LEFT JOIN SEC_USERS U_CREATOR ON U_CREATOR.ID = M.CREATED_BY_USER_ID
LEFT JOIN HR_EMPLOYEES E_CREATOR ON E_CREATOR.EMPLOYEE_ID = U_CREATOR.REFERENCE_USER_ID
WHERE M.COMPANY_ID = TO_NUMBER($P{P_COMP_ID})
  AND M.BRANCH_ID = TO_NUMBER($P{P_BRANCH_ID})
  AND ($P{P_EMPLOYEE_ID} IS NULL OR M.EMPLOYEE_ID = TO_NUMBER($P{P_EMPLOYEE_ID}))
  AND (
      $P{P_DEPARTMENT_ID} IS NULL
      OR E.DEPARTMENT_ID IN (
          SELECT ID FROM HR_DEPARTMENT
           START WITH ID      = TO_NUMBER($P{P_DEPARTMENT_ID})
          CONNECT BY PRIOR ID = PARENT_ID
      )
  )
  AND ($P{P_FROM_DATE} IS NULL OR M.START_DATE >= TO_DATE($P{P_FROM_DATE}, 'DD-MM-YYYY'))
  AND ($P{P_TO_DATE}   IS NULL OR M.END_DATE <= TO_DATE($P{P_TO_DATE}, 'DD-MM-YYYY'))
ORDER BY M.START_DATE DESC, E.FULL_NAME_AR ASC]]>
	</queryString>
	<field name="ID" class="java.math.BigDecimal"/>
	<field name="MISSION_CODE" class="java.lang.String"/>
	<field name="EMPLOYEE_ID" class="java.math.BigDecimal"/>
	<field name="EMPLOYEE_CODE" class="java.lang.String"/>
	<field name="EMPLOYEE_NAME" class="java.lang.String"/>
	<field name="START_DATE" class="java.sql.Timestamp"/>
	<field name="END_DATE" class="java.sql.Timestamp"/>
	<field name="TOTAL_MISSION_DAY" class="java.math.BigDecimal"/>
	<field name="MISSION_TYPE" class="java.lang.String"/>
