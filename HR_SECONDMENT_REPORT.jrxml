	<!-- ============ DETAIL BAND (DOCUMENT BODY) ============ -->
	<detail>
		<band height="550" splitType="Stretch">
			<staticText>
				<reportElement style="TitleStyle" x="127" y="15" width="300" height="40" uuid="d1111111-0001-0001-0001-000000000001"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="IBM Plex Sans Arabic" size="16" isBold="true"/>
				</textElement>
				<text><![CDATA[السيد / مدير إدارة المواظبة]]></text>
			</staticText>

			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement style="DecisionTextStyle" positionType="Float" x="0" y="75" width="555" height="260" uuid="d1111111-0001-0001-0001-000000000005">
					<property name="net.sf.jasperreports.style.markup" value="html"/>
				</reportElement>
				<textElement textAlignment="Right" verticalAlignment="Top" markup="html">
					<font fontName="IBM Plex Sans Arabic" size="14"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["بالإشارة إلى ( المذكرة / الطلب ) الوارد إلينا واعتماد السيد / <b>" + ($F{APPROVER_EMPLOYEE_NAME} != null ? $F{APPROVER_EMPLOYEE_NAME} : ($F{CREATED_BY} != null ? $F{CREATED_BY} : "")) + "</b><br/><br/>" +
"فقد تقرر انتداب السيد / <b>" + ($F{EMPLOYEE_NAME} != null ? $F{EMPLOYEE_NAME} : "") + "</b> رقم :- <b>" + ($F{EMPLOYEE_CODE} != null ? $F{EMPLOYEE_CODE} : "") + "</b><br/>" +
"وظيفة : <b>" + ($F{FROM_JOB_NAME} != null ? $F{FROM_JOB_NAME} : "") + "</b>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;مستوى الوظائف : <b>" + ($F{FROM_GRADE_NAME} != null ? $F{FROM_GRADE_NAME} : "") + "</b><br/>" +
"بإدارة : <b>" + ($F{FROM_DEPARTMENT_NAME} != null ? $F{FROM_DEPARTMENT_NAME} : "") + "</b>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;الإدارة العامة : <b>" + ($F{FROM_GENERAL_DEPT_NAME} != null ? $F{FROM_GENERAL_DEPT_NAME} : "") + "</b><br/><br/>" +
"للعمل بإدارة : <b>" + ("1".equals($F{IS_EXTERNAL}) ? ($F{EXTERNAL_ENTITY_NAME} != null ? $F{EXTERNAL_ENTITY_NAME} : "جهة خارجية") : ($F{TO_DEPARTMENT_NAME} != null ? $F{TO_DEPARTMENT_NAME} : "")) + "</b>" + ("1".equals($F{IS_EXTERNAL}) && ($F{TO_GENERAL_DEPT_NAME} == null || $F{TO_GENERAL_DEPT_NAME}.isEmpty()) ? "" : ("&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;الإدارة العامة : <b>" + ($F{TO_GENERAL_DEPT_NAME} != null ? $F{TO_GENERAL_DEPT_NAME} : "") + "</b>")) + "<br/>" +
"بوظيفة : <b>" + ($F{TO_JOB_NAME} != null ? $F{TO_JOB_NAME} : "") + "</b>" + ($F{TO_GRADE_NAME} != null ? ("&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;مستوى الوظائف : <b>" + $F{TO_GRADE_NAME} + "</b>") : "") + "<br/><br/>" +
"وذلك اعتباراً من : <b>" + ($F{START_DATE_STR} != null ? $F{START_DATE_STR} : "") + "</b>" + ($F{END_DATE_STR} != null ? (" إلى <b>" + $F{END_DATE_STR} + "</b>") : "") + ($F{DURATION_DAYS} != null ? (" ( لمدة <b>" + $F{DURATION_DAYS} + "</b> يوم )") : "") + "<br/><br/>" +
"للعلم والتنبيه بعمل اللازم لحين موافاتكم بالقرار الإداري الصادر بذلك الشأن.<br/>" +
"وتفضلوا بقبول وافر التحية ،،،،،"]]></textFieldExpression>
			</textField>

			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement positionType="Float" x="0" y="350" width="555" height="32" isRemoveLineWhenBlank="true" uuid="d1111111-0001-0001-0001-000000000014"/>
				<box topPadding="5" leftPadding="5" bottomPadding="5" rightPadding="5">
					<pen lineWidth="0.5" lineColor="#BDC3C7"/>
				</box>
