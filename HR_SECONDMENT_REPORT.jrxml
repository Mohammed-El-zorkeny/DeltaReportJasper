					<subreportParameterExpression><![CDATA[$P{P_COMP_ID}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="P_TITLE_REPORT">
					<subreportParameterExpression><![CDATA["ar".equals($P{P_LANG}) ? "قرار إداري - الانتداب" : "Administrative Decision - Secondment"]]></subreportParameterExpression>
				</subreportParameter>
