	<parameter name="P_ID" class="java.lang.String"/>
	<parameter name="P_LANG" class="java.lang.String">
		<defaultValueExpression><![CDATA["ar"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_USERPRINT" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>

	<queryString>
		<![CDATA[SELECT 
    S.ID,
    S.CODE AS SECONDMENT_CODE,
    S.EMPLOYEE_ID,
    E.CODE AS EMPLOYEE_CODE,
    DECODE(LOWER(NVL($P{P_LANG}, 'ar')), 'ar', NVL(E.FULL_NAME_AR, E.FULL_NAME_EN), NVL(E.FULL_NAME_EN, E.FULL_NAME_AR)) AS EMPLOYEE_NAME,
    
    -- Approver Employee Name
    S.APPROVER_EMPLOYEE_ID,
    DECODE(LOWER(NVL($P{P_LANG}, 'ar')), 'ar', NVL(APPR.FULL_NAME_AR, APPR.FULL_NAME_EN), NVL(APPR.FULL_NAME_EN, APPR.FULL_NAME_AR)) AS APPROVER_EMPLOYEE_NAME,
    
    -- Current Dept
    S.FROM_DEPARTMENT_ID,
    DECODE(LOWER(NVL($P{P_LANG}, 'ar')), 'ar', NVL(FD.ARABIC_NAME, FD.NAME), NVL(FD.NAME, FD.ARABIC_NAME)) AS FROM_DEPARTMENT_NAME,
    NVL(
        DECODE(LOWER(NVL($P{P_LANG}, 'ar')), 'ar', NVL(FPD.ARABIC_NAME, FPD.NAME), NVL(FPD.NAME, FPD.ARABIC_NAME)),
        DECODE(LOWER(NVL($P{P_LANG}, 'ar')), 'ar', NVL(FD.ARABIC_NAME, FD.NAME), NVL(FD.NAME, FD.ARABIC_NAME))
    ) AS FROM_GENERAL_DEPT_NAME,
    
    -- Current Job Title & Grade
    S.FROM_JOB_ID,
    DECODE(LOWER(NVL($P{P_LANG}, 'ar')), 'ar', NVL(FJ.ARABIC_NAME, FJ.NAME), NVL(FJ.NAME, FJ.ARABIC_NAME)) AS FROM_JOB_NAME,
    S.FROM_JOB_GRADE_ID,
    DECODE(LOWER(NVL($P{P_LANG}, 'ar')), 'ar', NVL(FG.ARABIC_NAME, FG.NAME), NVL(FG.NAME, FG.ARABIC_NAME)) AS FROM_GRADE_NAME,
    
    -- Seconded To Dept
    S.TO_DEPARTMENT_ID,
    DECODE(LOWER(NVL($P{P_LANG}, 'ar')), 'ar', NVL(TD.ARABIC_NAME, TD.NAME), NVL(TD.NAME, TD.ARABIC_NAME)) AS TO_DEPARTMENT_NAME,
    NVL(
        DECODE(LOWER(NVL($P{P_LANG}, 'ar')), 'ar', NVL(TPD.ARABIC_NAME, TPD.NAME), NVL(TPD.NAME, TPD.ARABIC_NAME)),
        DECODE(LOWER(NVL($P{P_LANG}, 'ar')), 'ar', NVL(TD.ARABIC_NAME, TD.NAME), NVL(TD.NAME, TD.ARABIC_NAME))
    ) AS TO_GENERAL_DEPT_NAME,
    
    -- Seconded To Job & Grade
    S.TO_JOB_ID,
    DECODE(LOWER(NVL($P{P_LANG}, 'ar')), 'ar', NVL(TJ.ARABIC_NAME, TJ.NAME), NVL(TJ.NAME, TJ.ARABIC_NAME)) AS TO_JOB_NAME,
    S.TO_JOB_GRADE_ID,
    DECODE(LOWER(NVL($P{P_LANG}, 'ar')), 'ar', NVL(TG.ARABIC_NAME, TG.NAME), NVL(TG.NAME, TG.ARABIC_NAME)) AS TO_GRADE_NAME,
    
    -- Manager during secondment
    S.TO_MANAGER_ID,
    DECODE(LOWER(NVL($P{P_LANG}, 'ar')), 'ar', NVL(TM.FULL_NAME_AR, TM.FULL_NAME_EN), NVL(TM.FULL_NAME_EN, TM.FULL_NAME_AR)) AS TO_MANAGER_NAME,
    
    -- External Secondment
    NVL(S.IS_EXTERNAL, '0') AS IS_EXTERNAL,
    S.EXTERNAL_ENTITY_NAME,
    
    -- Dates & Duration
    S.REQUEST_DATE,
    TO_CHAR(S.REQUEST_DATE, 'YYYY/MM/DD') AS REQUEST_DATE_STR,
    TO_CHAR(NVL(S.REQUEST_DATE, SYSDATE), 'YYYY/MM/DD') AS PRINT_DATE_STR,
    S.START_DATE,
    TO_CHAR(S.START_DATE, 'YYYY/MM/DD') AS START_DATE_STR,
    S.END_DATE,
    TO_CHAR(S.END_DATE, 'YYYY/MM/DD') AS END_DATE_STR,
    S.DURATION_DAYS,
    
    -- Extension & Return
    NVL(S.IS_EXTENDED, '0') AS IS_EXTENDED,
    S.ORIGINAL_END_DATE,
    TO_CHAR(S.ORIGINAL_END_DATE, 'YYYY/MM/DD') AS ORIGINAL_END_DATE_STR,
    S.ACTUAL_RETURN_DATE,
    TO_CHAR(S.ACTUAL_RETURN_DATE, 'YYYY/MM/DD') AS ACTUAL_RETURN_DATE_STR,
    NVL(S.IS_RETURNED, '0') AS IS_RETURNED,
    
    -- Reason & Decision & Notes
    S.REASON,
    S.JOB_DESCRIPTION,
    S.DECISION_NO,
    S.DECISION_DATE,
    TO_CHAR(S.DECISION_DATE, 'YYYY/MM/DD') AS DECISION_DATE_STR,
    S.STATUS,
    S.NOTES,
    
    -- Creation audit
    S.CREATED_BY
FROM HR_SECONDMENTS S
LEFT JOIN HR_EMPLOYEES E ON E.EMPLOYEE_ID = S.EMPLOYEE_ID
LEFT JOIN HR_EMPLOYEES APPR ON APPR.EMPLOYEE_ID = S.APPROVER_EMPLOYEE_ID
LEFT JOIN HR_DEPARTMENT FD ON FD.ID = S.FROM_DEPARTMENT_ID
LEFT JOIN HR_DEPARTMENT FPD ON FPD.ID = FD.PARENT_ID
LEFT JOIN HR_JOB_TITLE FJ ON FJ.ID = S.FROM_JOB_ID
LEFT JOIN HR_JOB_GRADES FG ON FG.ID = S.FROM_JOB_GRADE_ID

LEFT JOIN HR_DEPARTMENT TD ON TD.ID = S.TO_DEPARTMENT_ID
LEFT JOIN HR_DEPARTMENT TPD ON TPD.ID = TD.PARENT_ID
LEFT JOIN HR_JOB_TITLE TJ ON TJ.ID = S.TO_JOB_ID
LEFT JOIN HR_JOB_GRADES TG ON TG.ID = S.TO_JOB_GRADE_ID
LEFT JOIN HR_EMPLOYEES TM ON TM.EMPLOYEE_ID = S.TO_MANAGER_ID
WHERE ($P{P_ID} IS NULL OR $P{P_ID} = '' OR S.ID = TO_NUMBER($P{P_ID}))
  AND ($P{P_COMP_ID} IS NULL OR $P{P_COMP_ID} = '' OR S.COMPANY_ID = TO_NUMBER($P{P_COMP_ID}))
  AND ROWNUM = 1]]>
	</queryString>

