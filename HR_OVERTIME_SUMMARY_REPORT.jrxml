				<textField isBlankWhenNull="true">
					<reportElement mode="Opaque" x="80" y="0" width="80" height="20" backcolor="#EAFAF1" uuid="cc33dd44-0006-0002-0001-000000000003"/>
					<box>
						<pen lineWidth="0.5" lineColor="#BDC3C7"/>
					</box>
