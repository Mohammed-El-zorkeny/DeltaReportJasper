<!-- Created with Jaspersoft Studio version 6.20.5.final using JasperReports Library version 6.20.5-3efcf2e67f959db3888d79f73dde2dbd7acb4f8e  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="HR_OVERTIME_SUMMARY_REPORT" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="15" bottomMargin="15" uuid="e2f3a4b5-c6d7-4e8f-90ab-1234567890cf">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Delta"/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageHeight" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="P_LANG" class="java.lang.String">
		<defaultValueExpression><![CDATA["ar"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_USERPRINT" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="P_EMPLOYEE_ID" class="java.lang.String"/>
	<parameter name="P_DEPARTMENT_ID" class="java.lang.String"/>
	<parameter name="P_SHIFT_ID" class="java.lang.String"/>
	<parameter name="P_SITE_ID" class="java.lang.String"/>
	<parameter name="P_EMPLOYEE_CATEGORY_ID" class="java.lang.String"/>
	<parameter name="P_FROM_DATE" class="java.lang.String"/>
	<parameter name="P_TO_DATE" class="java.lang.String"/>
	<queryString>
		<![CDATA[WITH EMP_OT_DAYS AS (
    -- الفئة الأولى: الأيام التي حضروا فيها من الـ View (شاملة التسويات لأيام الحضور ولكن باستبعاد الـ 250 في العطلات)
    SELECT
        A.EMPLOYEE_ID,
        A.ATTENDANCE_DATE,
        CASE 
            WHEN A.DAY_TYPE = 'HOLIDAY' 
            THEN A.OVERTIME_DAYS_CALCULATED - NVL(A.OT_DAYS_250_CALCULATED, 0)
            ELSE A.OVERTIME_DAYS_CALCULATED 
        END AS OT_DAYS,
        CASE WHEN NVL(A.OT_DAYS_400_CALCULATED, 0) >= 1.6 THEN 1 ELSE 0 END AS MEAL_ALLOWANCE,
        CASE 
            WHEN A.DAY_TYPE = 'HOLIDAY' 
             AND A.RATE_MULTIPLIER >= 2 
             AND NVL(A.OT_DAYS_250_CALCULATED, 0) > 0 
            THEN 1 
            ELSE 0 
        END AS IS_HOLIDAY_OT
    FROM VW_OVERTIME_LOG A
    WHERE A.WORK_SHIFT_TYPE_ID = 2
      AND ($P{P_FROM_DATE} IS NULL OR A.ATTENDANCE_DATE >= TO_DATE($P{P_FROM_DATE}, 'DD-MM-YYYY'))
      AND ($P{P_TO_DATE}   IS NULL OR A.ATTENDANCE_DATE <= TO_DATE($P{P_TO_DATE},   'DD-MM-YYYY'))
      AND ($P{P_SHIFT_ID}  IS NULL OR A.SHIFT_ID = $P{P_SHIFT_ID})
      AND ($P{P_SITE_ID}   IS NULL OR A.SITES_ID = $P{P_SITE_ID})
      AND ($P{P_EMPLOYEE_CATEGORY_ID} IS NULL OR A.EMPLOYEE_CATEGORY_ID = $P{P_EMPLOYEE_CATEGORY_ID})
    
    UNION ALL
    
    -- الفئة الثانية: تسويات الأيام التي لم يحضروا فيها أصلاً (سواء كانت أيام راحة أو غياب)
    SELECT
        OA.EMPLOYEE_ID,
        OA.ATTENDANCE_DATE,
        -- إجمالي أيام التسوية المضافة أو المخصومة (باستبعاد الـ 250 في العطلات الرسمية)
        SUM(
            CASE WHEN EXISTS (
                SELECT 1 FROM HR_OFFICIAL_HOLIDAYS OH
                WHERE OH.HOLIDAY_DATE = OA.ATTENDANCE_DATE
                  AND OH.STATUS = '1'
            ) THEN
                -- عطلة رسمية: نأخذ فقط تسويات الـ 400 (OT_TYPE = 2) ونستبعد الـ 250 (OT_TYPE = 1)
                CASE WHEN OA.OT_TYPE = 2 THEN
                    CASE OA.ADJUSTMENT_TYPE 
                        WHEN 1 THEN NVL(OA.DAYS, 0) 
                        WHEN 2 THEN -NVL(OA.DAYS, 0) 
                    END
                ELSE 0 END
            ELSE
                -- ليس عطلة: نأخذ كل التسويات كالمعتاد
                CASE OA.ADJUSTMENT_TYPE 
                    WHEN 1 THEN NVL(OA.DAYS, 0) 
                    WHEN 2 THEN -NVL(OA.DAYS, 0) 
                END
            END
        ) AS OT_DAYS,
        0 AS MEAL_ALLOWANCE,
        0 AS IS_HOLIDAY_OT
    FROM HR_OVERTIME_ADJUSTMENTS OA
    WHERE OA.STATUS = 1
      AND ($P{P_FROM_DATE} IS NULL OR OA.ATTENDANCE_DATE >= TO_DATE($P{P_FROM_DATE}, 'DD-MM-YYYY'))
      AND ($P{P_TO_DATE}   IS NULL OR OA.ATTENDANCE_DATE <= TO_DATE($P{P_TO_DATE},   'DD-MM-YYYY'))
      -- استبعاد الأيام التي حضروا فيها لأنها مسجلة ومحسوبة بالفعل في الفئة الأولى أعلاه
      AND NOT EXISTS (
          SELECT 1 
          FROM VW_OVERTIME_LOG A 
          WHERE A.EMPLOYEE_ID = OA.EMPLOYEE_ID 
            AND A.ATTENDANCE_DATE = OA.ATTENDANCE_DATE
            AND A.WORK_SHIFT_TYPE_ID = 2
      )
    GROUP BY 
        OA.EMPLOYEE_ID, 
        OA.ATTENDANCE_DATE
)
SELECT
    E.EMPLOYEE_ID,
    E.CODE AS EMPLOYEE_CODE,
    DECODE($P{P_LANG}, 'ar', E.FULL_NAME_AR, E.FULL_NAME_EN) AS EMPLOYEE_NAME,
    SUM(OD.MEAL_ALLOWANCE) AS MEAL_ALLOWANCE_COUNT,
    
    -- إجمالي أيام الإضافي بحد أقصى 45
    LEAST(GREATEST(SUM(OD.OT_DAYS), 0), 45) AS TOTAL_OVERTIME_DAYS,
    
    SUM(OD.IS_HOLIDAY_OT) AS HOLIDAY_COUNT,
    (SELECT DECODE($P{P_LANG}, 'ar', E2.FULL_NAME_AR, E2.FULL_NAME_EN) FROM HR_EMPLOYEES E2 WHERE E2.EMPLOYEE_ID = $P{P_EMPLOYEE_ID}) AS SELECTED_EMPLOYEE_NAME,
    (SELECT DECODE($P{P_LANG}, 'ar', D2.ARABIC_NAME, D2.NAME) FROM HR_DEPARTMENT D2 WHERE D2.ID = $P{P_DEPARTMENT_ID}) AS SELECTED_DEPARTMENT_NAME
FROM HR_EMPLOYEES E
INNER JOIN EMP_OT_DAYS OD ON OD.EMPLOYEE_ID = E.EMPLOYEE_ID
WHERE ($P{P_EMPLOYEE_ID} IS NULL OR E.EMPLOYEE_ID = $P{P_EMPLOYEE_ID})
  AND (
      $P{P_DEPARTMENT_ID} IS NULL
      OR E.DEPARTMENT_ID IN (
          SELECT ID FROM HR_DEPARTMENT
           START WITH ID      = $P{P_DEPARTMENT_ID}
          CONNECT BY PRIOR ID = PARENT_ID
      )
  )
GROUP BY 
    E.EMPLOYEE_ID,
    E.CODE,
    E.FULL_NAME_AR,
    E.FULL_NAME_EN
-- لا يظهر الموظفون الذين ليس لديهم إضافي نهائياً بعد استبعاد العطلات
HAVING SUM(OD.OT_DAYS) > 0
ORDER BY 
    EMPLOYEE_NAME]]>
	</queryString>
	<field name="EMPLOYEE_ID" class="java.math.BigDecimal"/>
	<field name="EMPLOYEE_CODE" class="java.lang.String"/>
	<field name="EMPLOYEE_NAME" class="java.lang.String"/>
	<field name="MEAL_ALLOWANCE_COUNT" class="java.math.BigDecimal"/>
	<field name="TOTAL_OVERTIME_DAYS" class="java.math.BigDecimal"/>
	<field name="HOLIDAY_COUNT" class="java.math.BigDecimal"/>
	<field name="SELECTED_EMPLOYEE_NAME" class="java.lang.String"/>
	<field name="SELECTED_DEPARTMENT_NAME" class="java.lang.String"/>
	<variable name="ROW_NUM" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{EMPLOYEE_ID}]]></variableExpression>
	</variable>
	<variable name="VAL_OT_TOTAL_SUM" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTAL_OVERTIME_DAYS}]]></variableExpression>
	</variable>
	<variable name="VAL_MEAL_SUM" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{MEAL_ALLOWANCE_COUNT}]]></variableExpression>
	</variable>
	<variable name="VAL_HOLIDAY_SUM" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{HOLIDAY_COUNT}]]></variableExpression>
	</variable>
