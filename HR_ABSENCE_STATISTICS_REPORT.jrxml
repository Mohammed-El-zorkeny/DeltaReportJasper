	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="P_LANG" class="java.lang.String">
		<defaultValueExpression><![CDATA["ar"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_COMP_ID" class="java.lang.String"/>
	<parameter name="P_USERPRINT" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="P_FROM_DATE" class="java.lang.String"/>
	<parameter name="P_TO_DATE" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    NVL(D.ARABIC_NAME, 'قسم غير محدد') AS DEPARTMENT_NAME,
    COUNT(*) AS ABSENCE_DAYS_COUNT,
    COUNT(DISTINCT AL_CHECK.EMPLOYEE_ID) AS ABSENT_EMPLOYEES_COUNT
FROM (
    WITH date_range AS (
        SELECT TO_DATE($P{P_FROM_DATE}, 'DD-MM-YYYY') + LEVEL - 1 AS DAY_DATE
          FROM DUAL
          CONNECT BY LEVEL <= (TO_DATE($P{P_TO_DATE}, 'DD-MM-YYYY') - TO_DATE($P{P_FROM_DATE}, 'DD-MM-YYYY') + 1)
    )
    SELECT E.EMPLOYEE_ID,
           E.DEPARTMENT_ID,
           DR.DAY_DATE
      FROM date_range DR
      CROSS JOIN HR_EMPLOYEES E
      WHERE E.EMPLOYMENT_STATUS = 1
        AND NOT EXISTS (
            SELECT 1
              FROM HR_ATTENDANCE_LOG AL
             WHERE AL.EMPLOYEE_ID    = E.EMPLOYEE_ID
               AND AL.ATTENDANCE_DATE = DR.DAY_DATE
        )
) AL_CHECK
LEFT JOIN HR_EMPLOYEES E2 ON E2.EMPLOYEE_ID = AL_CHECK.EMPLOYEE_ID
LEFT JOIN HR_DEPARTMENT D ON D.ID = AL_CHECK.DEPARTMENT_ID
LEFT JOIN HR_EMPLOYEE_LEAVE_REQUESTS LV 
       ON LV.EMPLOYEE_ID = AL_CHECK.EMPLOYEE_ID
      AND LV.STATUS_ID = 4
      AND AL_CHECK.DAY_DATE BETWEEN LV.START_DATE AND LV.END_DATE
LEFT JOIN HR_OFFICIAL_HOLIDAYS PH
       ON PH.HOLIDAY_DATE = AL_CHECK.DAY_DATE
      AND PH.STATUS = 1
      AND (PH.RELIGION_ID IS NULL OR PH.RELIGION_ID = E2.RELIGION)
LEFT JOIN (
    SELECT SD.SHIFT_ID, WD.DAY_NAME_EN
      FROM HR_WORK_SHIF_DAYS SD
      JOIN HR_WEEK_DAYS WD ON WD.DAY_ID = SD.DAY_ID
     WHERE SD.IS_OFF = 1
) WO ON WO.SHIFT_ID  = E2.WORK_SHIFT_ID
     AND WO.DAY_NAME_EN = TRIM(TO_CHAR(AL_CHECK.DAY_DATE, 'DAY', 'NLS_DATE_LANGUAGE=AMERICAN'))
WHERE LV.EMPLOYEE_ID IS NULL
  AND PH.HOLIDAY_DATE IS NULL
  AND WO.SHIFT_ID IS NULL
GROUP BY D.ARABIC_NAME
ORDER BY ABSENCE_DAYS_COUNT DESC]]>
	</queryString>
	<field name="DEPARTMENT_NAME" class="java.lang.String"/>
	<field name="ABSENCE_DAYS_COUNT" class="java.math.BigDecimal"/>
	<field name="ABSENT_EMPLOYEES_COUNT" class="java.math.BigDecimal"/>
	<variable name="ROW_NUM" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{DEPARTMENT_NAME}]]></variableExpression>
	</variable>
